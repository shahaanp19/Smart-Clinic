@{
    ViewData["Title"] = "Virtual Health Assistant";
}

<section class="page-section">

    <div class="container">

        <div class="mb-4">

            <span class="smart-badge">
                Virtual Assistant
            </span>

            <h1 class="dashboard-title mt-3">
                Healthcare Support Chatbot
            </h1>

            <p class="text-muted">
                Ask questions about appointments, clinic services,
                account access, and general healthcare guidance.
            </p>

        </div>

        <div class="smart-card chatbot-window">

            <div class="chat-message bot-message">

                <strong>Virtual Assistant</strong>

                <p class="mb-0 mt-2">
                    Hello and welcome to Doringkloof Medical Centre.
                    I can help with appointments, clinic services,
                    patient accounts and general healthcare information.
                    How may I assist you today?
                </p>

            </div>

            <div class="row g-3 mt-3">

                <div class="col-md-4">
                    <button type="button"
                            class="quick-question w-100"
                            data-question="How do I book an appointment?">
                        How do I book an appointment?
                    </button>
                </div>

                <div class="col-md-4">
                    <button type="button"
                            class="quick-question w-100"
                            data-question="What services do you offer?">
                        What services do you offer?
                    </button>
                </div>

                <div class="col-md-4">
                    <button type="button"
                            class="quick-question w-100"
                            data-question="Where is the clinic located?">
                        Where is the clinic?
                    </button>
                </div>

                <div class="col-md-4">
                    <button type="button"
                            class="quick-question w-100"
                            data-question="How do I create an account?">
                        How do I create an account?
                    </button>
                </div>

                <div class="col-md-4">
                    <button type="button"
                            class="quick-question w-100"
                            data-question="How can I access my medical records?">
                        Medical records
                    </button>
                </div>

                <div class="col-md-4">
                    <button type="button"
                            class="quick-question w-100"
                            data-question="I have chest pain">
                        I have chest pain
                    </button>
                </div>

            </div>

            <div class="mt-4">

                <label for="userQuestion"
                       class="smart-label">
                    Ask a Question
                </label>

                <input type="text"
                       id="userQuestion"
                       class="form-control smart-input"
                       placeholder="Type your question here..."
                       autocomplete="off" />

            </div>

            <div class="mt-3">

                <button type="button"
                        id="askAssistantButton"
                        class="smart-btn-primary">

                    <i class="bi bi-send me-2"
                       aria-hidden="true"></i>

                    Ask Assistant

                </button>

            </div>

            <div id="chatResponse"
                 class="mt-4"
                 aria-live="polite">
            </div>

        </div>

    </div>

</section>

@section Scripts {
    <script src="~/js/chatbot.js" asp-append-version="true"></script>
}