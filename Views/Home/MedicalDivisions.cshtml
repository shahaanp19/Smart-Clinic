@{
    ViewData["Title"] = "Medical Divisions";
}

<div class="public-page">

    <!-- HERO -->
    <section class="service-directory-hero"
             aria-labelledby="medicalDivisionsHeading">

        <div class="container">

            <div class="service-directory-hero-content">

                <span class="smart-badge">
                    Healthcare Services
                </span>

                <h1 id="medicalDivisionsHeading">
                    Our Medical Divisions
                </h1>

                <p>
                    Explore the healthcare services available at
                    Doringkloof Medical Centre and find the right
                    support for your individual healthcare needs.
                </p>

            </div>

        </div>

    </section>


    <!-- INTRODUCTION -->
    <section class="page-section"
             aria-labelledby="careApproachHeading">

        <div class="container">

            <div class="row align-items-center g-5">

                <div class="col-lg-6">

                    <div class="public-image-frame">

                        <img src="~/images/Consult 2.jpg"
                             alt="Doctor consulting with a patient at Doringkloof Medical Centre"
                             class="img-fluid" />

                    </div>

                </div>

                <div class="col-lg-6">

                    <span class="smart-badge">
                        Comprehensive Care
                    </span>

                    <h2 id="careApproachHeading"
                        class="section-title mt-3 mb-4">

                        Healthcare in one convenient location

                    </h2>

                    <p class="public-lead">
                        Doringkloof Medical Centre brings together
                        different healthcare disciplines within one
                        convenient environment.
                    </p>

                    <p>
                        Our multidisciplinary approach allows patients
                        and families to explore a range of medical,
                        rehabilitation and wellness services according
                        to their individual needs.
                    </p>

                    <p class="mb-0">
                        Select a service below to learn more about the
                        care it provides.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- SERVICES -->
    <section class="page-section public-services-section"
             aria-labelledby="servicesHeading">

        <div class="container">

            <div class="public-section-heading text-center">

                <span class="smart-badge">
                    Our Services
                </span>

                <h2 id="servicesHeading"
                    class="section-title mt-3 mb-3">

                    Areas of Healthcare

                </h2>

                <p class="section-subtitle mx-auto">
                    Explore our healthcare disciplines and discover
                    the services available to support your health
                    and wellbeing.
                </p>

            </div>


            <div class="row g-4">

                <!-- DOCTORS -->
                <div class="col-md-6 col-lg-4">

                    <a asp-controller="Home"
                           asp-action="Doctors"
                           class="public-service-card">

                        <div class="public-service-icon"
                             aria-hidden="true">

                            <i class="bi bi-heart-pulse"></i>

                        </div>

                        <div class="public-service-content">

                            <h3>Doctors</h3>

                            <p>
                                General and family healthcare for
                                everyday medical needs, assessment
                                and ongoing care.
                            </p>

                        </div>

                        <div class="public-service-footer">

                            <span>Explore Medical Care</span>

                            <i class="bi bi-arrow-up-right"
                               aria-hidden="true"></i>

                        </div>

                    </a>

                </div>


                <!-- DENTISTRY -->
                <div class="col-md-6 col-lg-4">

                    <a asp-controller="Home"
                           asp-action="Dentistry"
                           class="public-service-card">

                        <div class="public-service-icon"
                             aria-hidden="true">

                            <i class="bi bi-emoji-smile"></i>

                        </div>

                        <div class="public-service-content">

                            <h3>Dentistry</h3>

                            <p>
                                Preventive, restorative, cosmetic
                                and paediatric dental care.
                            </p>

                        </div>

                        <div class="public-service-footer">

                            <span>Explore Dental Care</span>

                            <i class="bi bi-arrow-up-right"
                               aria-hidden="true"></i>

                        </div>

                    </a>

                </div>


                <!-- DIETETICS -->
                <div class="col-md-6 col-lg-4">

                    <a asp-controller="Home"
                           asp-action="Dietetics"
                           class="public-service-card">

                        <div class="public-service-icon"
                             aria-hidden="true">

                            <i class="bi bi-apple"></i>

                        </div>

                        <div class="public-service-content">

                            <h3>Dietetics</h3>

                            <p>
                                Nutrition planning and personalised
                                dietary guidance supporting healthier
                                lifestyles.
                            </p>

                        </div>

                        <div class="public-service-footer">

                            <span>Explore Nutrition Care</span>

                            <i class="bi bi-arrow-up-right"
                               aria-hidden="true"></i>

                        </div>

                    </a>

                </div>


                <!-- ORTHOTICS -->
                <div class="col-md-6 col-lg-4">

                    <a asp-controller="Home"
                           asp-action="Orthotics"
                           class="public-service-card">

                        <div class="public-service-icon"
                             aria-hidden="true">

                            <i class="bi bi-person-standing"></i>

                        </div>

                        <div class="public-service-content">

                            <h3>Orthotics &amp; Prosthetics</h3>

                            <p>
                                Specialist support for mobility,
                                rehabilitation and physical function.
                            </p>

                        </div>

                        <div class="public-service-footer">

                            <span>Explore Rehabilitation</span>

                            <i class="bi bi-arrow-up-right"
                               aria-hidden="true"></i>

                        </div>

                    </a>

                </div>


                <!-- PHYSIOTHERAPY -->
                <div class="col-md-6 col-lg-4">

                    <a asp-controller="Home"
                           asp-action="Physiotherapy"
                           class="public-service-card">

                        <div class="public-service-icon"
                             aria-hidden="true">

                            <i class="bi bi-activity"></i>

                        </div>

                        <div class="public-service-content">

                            <h3>Physiotherapy</h3>

                            <p>
                                Movement-focused care supporting
                                recovery, rehabilitation and
                                physical wellbeing.
                            </p>

                        </div>

                        <div class="public-service-footer">

                            <span>Explore Physical Care</span>

                            <i class="bi bi-arrow-up-right"
                               aria-hidden="true"></i>

                        </div>

                    </a>

                </div>


                <!-- PODIATRY -->
                <div class="col-md-6 col-lg-4">

                    <a asp-controller="Home"
                           asp-action="Podiatry"
                           class="public-service-card">

                        <div class="public-service-icon"
                             aria-hidden="true">

                            <i class="bi bi-person-walking"></i>

                        </div>

                        <div class="public-service-content">

                            <h3>Podiatry</h3>

                            <p>
                                Professional care focused on foot,
                                ankle and lower-limb health.
                            </p>

                        </div>

                        <div class="public-service-footer">

                            <span>Explore Lower-Limb Care</span>

                            <i class="bi bi-arrow-up-right"
                               aria-hidden="true"></i>

                        </div>

                    </a>

                </div>

            </div>

        </div>

    </section>


    <!-- CTA -->
    <section class="page-section">

        <div class="container">

            <div class="public-cta">

                <div>

                    <span class="smart-badge">
                        Need Assistance?
                    </span>

                    <h2 class="mt-3 mb-3">
                        Have a question about our services?
                    </h2>

                    <p class="mb-0">
                        Contact the practice for more information
                        about the healthcare services available.
                    </p>

                </div>

                <div>

                    <a asp-controller="Home"
                           asp-action="Contact"
                           class="smart-btn-primary">

                        Contact Us

                        <i class="bi bi-arrow-right"
                           aria-hidden="true"></i>

                    </a>

                </div>

            </div>

        </div>

    </section>

</div>