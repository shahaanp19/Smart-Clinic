@{
    ViewData["Title"] = "Medical Divisions";
}

<section class="container py-5">

    <div class="text-center mb-5">

        <h1 class="dashboard-title">
            Our Medical Divisions
        </h1>

        <p class="lead">
            Comprehensive healthcare services for the whole family.
        </p>

    </div>


    <!-- CONSULTATION IMAGE -->

    <div class="row justify-content-center mb-5">

        <div class="col-lg-10">

            <div class="smart-card p-0 overflow-hidden">

                <img src="/Images/Consult 2.jpg"
                     alt="Medical consultation"
                     class="img-fluid w-100"
                     style="max-height:420px; object-fit:cover;" />

            </div>

        </div>

    </div>


    <!-- MEDICAL DIVISIONS -->

    <div class="row g-4">

        <!-- Doctors -->

        <div class="col-md-4">

            <div class="smart-card h-100">

                <h4>Doctors</h4>

                <p>
                    Family healthcare and general practice.
                </p>

                <a href="#">Read More</a>

            </div>

        </div>


        <!-- Dentists -->

        <div class="col-md-4">

            <div class="smart-card h-100">

                <h4>Dentists</h4>

                <p>
                    Preventative and cosmetic dentistry.
                </p>

                <a href="#">Read More</a>

            </div>

        </div>


        <!-- Dieticians -->

        <div class="col-md-4">

            <div class="smart-card h-100">

                <h4>Dieticians</h4>

                <p>
                    Nutrition and lifestyle planning.
                </p>

                <a href="#">Read More</a>

            </div>

        </div>

    </div>

</section>