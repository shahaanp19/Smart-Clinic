@{
    ViewData["Title"] = "Medical Divisions";
}

<!-- PAGE HERO -->

<section class="hero-about py-5">
    <div class="container py-lg-5">

        ```
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">

                <span class="smart-badge">
                    Healthcare Services
                </span>

                <h1 class="hero-title mt-4 mb-4">
                    Our Medical Divisions
                </h1>

                <p class="hero-text mx-auto">
                    Access a range of healthcare services from
                    professionals working together to support
                    the health and wellbeing of individuals and families.
                </p>

            </div>
        </div>

    </div>
    ```

</section>

<!-- INTRODUCTION -->

<section class="page-section">
    <div class="container">

        ```
        <div class="row align-items-center g-5">

            <!-- IMAGE -->
            <div class="col-lg-6">
                <div class="division-image-wrapper">

                    <img src="~/images/Consult 2.jpg"
                         alt="Medical consultation"
                         class="img-fluid division-image" />

                </div>
            </div>

            <!-- CONTENT -->
            <div class="col-lg-6">

                <div class="division-intro">

                    <span class="smart-badge">
                        Comprehensive Care
                    </span>

                    <h2 class="section-title mt-3 mb-4">
                        Healthcare in one convenient location
                    </h2>

                    <p class="mb-4">
                        Doringkloof Medical Centre provides access to
                        different areas of healthcare within one
                        convenient environment.
                    </p>

                    <p class="mb-0">
                        Explore the services available through our
                        multidisciplinary healthcare practice.
                    </p>

                </div>

            </div>

        </div>

    </div>
    ```

</section>

<!-- DIVISIONS -->

<section class="page-section bg-white">
    <div class="container">

        ```
        <div class="row justify-content-center text-center mb-5">
            <div class="col-lg-8">

                <span class="smart-badge">
                    Our Services
                </span>

                <h2 class="section-title mt-3 mb-3">
                    Areas of Healthcare
                </h2>

                <p class="section-subtitle">
                    Our healthcare professionals provide services
                    across a range of medical and wellness disciplines.
                </p>

            </div>
        </div>


        <div class="row g-4">

            <!-- DOCTORS -->
            <div class="col-md-6 col-lg-4">
                <div class="smart-card division-card h-100">

                    <div class="division-card-icon">
                        <i class="bi bi-heart-pulse"></i>
                    </div>

                    <div class="division-card-content">

                        <h3>
                            Doctors
                        </h3>

                        <p>
                            Family healthcare and general medical
                            services for patients and families.
                        </p>

                    </div>

                    <div class="division-card-footer">
                        <span>
                            Medical Care
                        </span>

                        <i class="bi bi-arrow-right"></i>
                    </div>

                </div>
            </div>


            <!-- DENTISTRY -->
            <div class="col-md-6 col-lg-4">
                <div class="smart-card division-card h-100">

                    <div class="division-card-icon">
                        <i class="bi bi-emoji-smile"></i>
                    </div>

                    <div class="division-card-content">

                        <h3>
                            Dentistry
                        </h3>

                        <p>
                            Preventive, cosmetic and paediatric
                            dental services.
                        </p>

                    </div>

                    <div class="division-card-footer">
                        <span>
                            Dental Care
                        </span>

                        <i class="bi bi-arrow-right"></i>
                    </div>

                </div>
            </div>


            <!-- DIETETICS -->
            <div class="col-md-6 col-lg-4">
                <div class="smart-card division-card h-100">

                    <div class="division-card-icon">
                        <i class="bi bi-apple"></i>
                    </div>

                    <div class="division-card-content">

                        <h3>
                            Dietetics
                        </h3>

                        <p>
                            Nutrition planning and lifestyle support
                            tailored to individual needs.
                        </p>

                    </div>

                    <div class="division-card-footer">
                        <span>
                            Nutrition
                        </span>

                        <i class="bi bi-arrow-right"></i>
                    </div>

                </div>
            </div>


            <!-- ORTHOTICS -->
            <div class="col-md-6 col-lg-4">
                <div class="smart-card division-card h-100">

                    <div class="division-card-icon">
                        <i class="bi bi-person-standing"></i>
                    </div>

                    <div class="division-card-content">

                        <h3>
                            Orthotics & Prosthetics
                        </h3>

                        <p>
                            Specialist support for mobility,
                            rehabilitation and physical function.
                        </p>

                    </div>

                    <div class="division-card-footer">
                        <span>
                            Rehabilitation
                        </span>

                        <i class="bi bi-arrow-right"></i>
                    </div>

                </div>
            </div>


            <!-- PHYSIOTHERAPY -->
            <div class="col-md-6 col-lg-4">
                <div class="smart-card division-card h-100">

                    <div class="division-card-icon">
                        <i class="bi bi-activity"></i>
                    </div>

                    <div class="division-card-content">

                        <h3>
                            Physiotherapy
                        </h3>

                        <p>
                            Movement-focused care supporting recovery,
                            rehabilitation and physical wellbeing.
                        </p>

                    </div>

                    <div class="division-card-footer">
                        <span>
                            Physical Care
                        </span>

                        <i class="bi bi-arrow-right"></i>
                    </div>

                </div>
            </div>


            <!-- PODIATRY -->
            <div class="col-md-6 col-lg-4">
                <div class="smart-card division-card h-100">

                    <div class="division-card-icon">
                        <i class="bi bi-person-walking"></i>
                    </div>

                    <div class="division-card-content">

                        <h3>
                            Podiatry
                        </h3>

                        <p>
                            Professional care focused on foot,
                            ankle and lower-limb health.
                        </p>

                    </div>

                    <div class="division-card-footer">
                        <span>
                            Lower-Limb Care
                        </span>

                        <i class="bi bi-arrow-right"></i>
                    </div>

                </div>
            </div>

        </div>

    </div>
    ```

</section>

<!-- CTA -->

<section class="page-section">
    <div class="container">

        ```
        <div class="location-banner">

            <div class="row align-items-center g-4">

                <div class="col-lg-8">

                    <span class="smart-badge">
                        Need Assistance?
                    </span>

                    <h2 class="mt-3 mb-3">
                        Have a question about our services?
                    </h2>

                    <p class="mb-0">
                        Contact the practice for more information
                        about the healthcare services available.
                    </p>

                </div>

                <div class="col-lg-4 text-lg-end">

                    <a asp-controller="Home"
                           asp-action="Contact"
                           class="smart-btn-primary text-decoration-none">
                        Contact Us
                        <i class="bi bi-arrow-right ms-2"></i>
                    </a>

                </div>

            </div>

        </div>

    </div>
    ```

</section>
