@{
    ViewData["Title"] = "About Us";
}

<!-- HERO -->

<section class="hero-about py-5">
    <div class="container py-lg-5">

        ```
        <div class="row justify-content-center text-center">
            <div class="col-lg-9">

                <span class="smart-badge">
                    Doringkloof Medical Centre
                </span>

                <h1 class="hero-title mt-4 mb-4">
                    Healthcare for
                    <span class="text-primary">every stage of life.</span>
                </h1>

                <p class="hero-text mx-auto">
                    Doringkloof Medical Centre brings together a range
                    of healthcare professionals and services in one
                    convenient location in Centurion.
                </p>

            </div>
        </div>

    </div>
    ```

</section>

<!-- ABOUT THE PRACTICE -->

<section class="page-section">
    <div class="container">

        ```
        <div class="row align-items-stretch g-5">

            <div class="col-lg-6">
                <div class="about-image-wrapper h-100">

                    <img src="~/images/Doctor.jpg"
                         alt="Healthcare professional"
                         class="img-fluid about-image" />

                    <div class="about-image-caption">
                        <i class="bi bi-heart-pulse me-2"></i>
                        Patient-focused healthcare
                    </div>

                </div>
            </div>

            <div class="col-lg-6">
                <div class="about-content h-100">

                    <span class="smart-badge">
                        About Our Practice
                    </span>

                    <h2 class="section-title mt-3 mb-4">
                        A connected approach to healthcare
                    </h2>

                    <p class="mb-4">
                        Doringkloof Medical Centre is conveniently
                        located within Doringkloof Mall and provides
                        access to a range of healthcare professionals.
                    </p>

                    <p class="mb-4">
                        Our multidisciplinary environment brings
                        different areas of healthcare together,
                        helping patients access services in one
                        convenient location.
                    </p>

                    <div class="about-detail-list">

                        <div class="about-detail">
                            <div class="about-detail-icon">
                                <i class="bi bi-geo-alt"></i>
                            </div>

                            <div>
                                <strong>Convenient location</strong>
                                <span>
                                    Doringkloof Mall, Centurion
                                </span>
                            </div>
                        </div>

                        <div class="about-detail">
                            <div class="about-detail-icon">
                                <i class="bi bi-people"></i>
                            </div>

                            <div>
                                <strong>Multidisciplinary care</strong>
                                <span>
                                    A range of healthcare professionals
                                    in one environment
                                </span>
                            </div>
                        </div>

                        <div class="about-detail">
                            <div class="about-detail-icon">
                                <i class="bi bi-heart"></i>
                            </div>

                            <div>
                                <strong>Patient focused</strong>
                                <span>
                                    Healthcare designed around
                                    individual patient needs
                                </span>
                            </div>
                        </div>

                    </div>

                </div>
            </div>

        </div>
    </div>
    ```

</section>

<!-- SERVICES -->

<section class="page-section bg-white">
    <div class="container">

        ```
        <div class="row justify-content-center text-center mb-5">
            <div class="col-lg-8">

                <span class="smart-badge">
                    Healthcare Services
                </span>

                <h2 class="section-title mt-3 mb-3">
                    One location. Multiple areas of care.
                </h2>

                <p class="section-subtitle">
                    Our healthcare environment supports a range of
                    services for individuals and families.
                </p>

            </div>
        </div>


        <div class="row g-4">

            <div class="col-md-6 col-lg-4">
                <div class="smart-card service-card h-100">

                    <div class="service-icon">
                        <i class="bi bi-heart-pulse"></i>
                    </div>

                    <h4 class="mt-4">
                        Doctors
                    </h4>

                    <p>
                        Family healthcare and general medical
                        services for patients of different ages.
                    </p>

                </div>
            </div>


            <div class="col-md-6 col-lg-4">
                <div class="smart-card service-card h-100">

                    <div class="service-icon">
                        <i class="bi bi-emoji-smile"></i>
                    </div>

                    <h4 class="mt-4">
                        Dentistry
                    </h4>

                    <p>
                        Preventive, cosmetic and paediatric
                        dental services.
                    </p>

                </div>
            </div>


            <div class="col-md-6 col-lg-4">
                <div class="smart-card service-card h-100">

                    <div class="service-icon">
                        <i class="bi bi-apple"></i>
                    </div>

                    <h4 class="mt-4">
                        Dietetics
                    </h4>

                    <p>
                        Nutrition guidance and lifestyle support
                        tailored to individual needs.
                    </p>

                </div>
            </div>


            <div class="col-md-6 col-lg-4">
                <div class="smart-card service-card h-100">

                    <div class="service-icon">
                        <i class="bi bi-person-standing"></i>
                    </div>

                    <h4 class="mt-4">
                        Orthotics & Prosthetics
                    </h4>

                    <p>
                        Specialist support focused on mobility,
                        rehabilitation and physical function.
                    </p>

                </div>
            </div>


            <div class="col-md-6 col-lg-4">
                <div class="smart-card service-card h-100">

                    <div class="service-icon">
                        <i class="bi bi-activity"></i>
                    </div>

                    <h4 class="mt-4">
                        Physiotherapy
                    </h4>

                    <p>
                        Rehabilitation and movement-focused
                        healthcare support.
                    </p>

                </div>
            </div>


            <div class="col-md-6 col-lg-4">
                <div class="smart-card service-card h-100">

                    <div class="service-icon">
                        <i class="bi bi-person-walking"></i>
                    </div>

                    <h4 class="mt-4">
                        Podiatry
                    </h4>

                    <p>
                        Professional care focused on foot,
                        ankle and lower-limb health.
                    </p>

                </div>
            </div>

        </div>
    </div>
    ```

</section>

<!-- LOCATION -->

<section class="page-section">
    <div class="container">

        ```
        <div class="location-banner">

            <div class="row align-items-center g-4">

                <div class="col-lg-8">

                    <span class="smart-badge">
                        Find Us
                    </span>

                    <h2 class="mt-3 mb-3">
                        Visit Doringkloof Medical Centre
                    </h2>

                    <p class="mb-0">
                        Doringkloof Mall<br />
                        6 Aster Avenue<br />
                        Doringkloof, Centurion
                    </p>

                </div>

                <div class="col-lg-4 text-lg-end">

                    <a asp-controller="Home"
                           asp-action="Contact"
                           class="smart-btn-primary text-decoration-none">
                        Contact Us
                        <i class="bi bi-arrow-right ms-2"></i>
                    </a>

                </div>

            </div>

        </div>

    </div>
    ```

</section>

<!-- FINAL MESSAGE -->

<section class="contact-banner">
    <div class="container text-center">

        ```
        <div class="cta-icon">
            <i class="bi bi-people"></i>
        </div>

        <h2 class="mt-4 mb-3">
            A healthcare environment built around people.
        </h2>

        <p class="mb-4">
            Explore our healthcare services or get in touch
            with the practice.
        </p>

        <div class="d-flex justify-content-center flex-wrap gap-3">

            <a asp-controller="Home"
                   asp-action="Contact"
                   class="smart-btn-primary text-decoration-none">
                Contact Us
            </a>

            <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-outline-primary rounded-3 px-4 py-3">
                Back to Home
            </a>

        </div>

    </div>
    ```

</section>
