@{
    ViewData["Title"] = "About Us";
}

<!-- HERO -->
<section class="hero-about">

    <div class="container text-center">

        <span class="smart-badge">
            About Doringkloof Medical Centre
        </span>

        <h1 class="hero-title mt-4">
            Our Health Services
        </h1>

        <p class="lead mt-4 mx-auto"
               style="max-width:800px;">

            At Doringkloof Medical Centre we offer a wide variety of medical
            expertise ranging from physical healthcare to dental and mental
            health services.

            We believe in offering excellent full-range healthcare services
            for the entire family.

        </p>

    </div>

</section>


<!-- PRACTICE INFORMATION -->
<section class="page-section">

    <div class="container">

        <div class="row g-4 align-items-stretch">


            <!-- DOCTOR IMAGE -->
            <div class="col-lg-5">

                <div class="smart-card h-100 p-0 overflow-hidden">

                    <img src="~/images/Doctor.jpg"
                         alt="Medical Professional"
                         class="img-fluid w-100"
                         style="height:100%;
                    min-height:350px;
                    object-fit:cover;" />

                </div>

            </div>


            <!-- PRACTICE INFORMATION -->
            <div class="col-lg-7">

                <div class="smart-card h-100">

                    <h2 class="section-title mb-4">
                        Our Practice
                    </h2>

                    <p class="mb-4">

                        Our practice is conveniently located within
                        Doringkloof Mall and can easily be accessed via
                        the Botha Road off-ramp from the N1 highway.

                    </p>

                    <p class="mb-0">

                        Dr Ester Greffrath's Travel Clinic is open
                        Monday–Friday from 07h30–13h00.

                    </p>

                </div>

            </div>

        </div>


        <!-- LOCATION -->
        <div class="row mt-4">

            <div class="col-lg-12">

                <div class="smart-card">

                    <div class="d-flex align-items-center mb-3">

                        <i class="bi bi-geo-alt-fill me-3"
                               style="font-size:28px;
                            color:var(--primary);">
                        </i>

                        <h4 class="mb-0">
                            Location
                        </h4>

                    </div>

                    <p class="mb-0">

                        6 Aster Avenue<br />
                        Doringkloof<br />
                        Centurion

                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- SERVICES -->
<section class="page-section bg-white">

    <div class="container">

        <div class="text-center mb-5">

            <span class="smart-badge">
                Healthcare Services
            </span>

            <h2 class="section-title mt-3">
                What We Do
            </h2>

            <p class="section-subtitle">

                Our multidisciplinary healthcare team provides
                comprehensive medical and wellness services
                for patients of all ages.

            </p>

        </div>


        <div class="row g-4">


            <!-- DOCTORS -->
            <div class="col-md-4">

                <div class="smart-card h-100 text-center">

                    <i class="bi bi-heart-pulse feature-icon"></i>

                    <h4>
                        Doctors
                    </h4>

                    <p>

                        Dr Esmé Cilliers and Dr Ester Greffrath provide
                        comprehensive family healthcare services.

                    </p>

                </div>

            </div>


            <!-- DENTISTS -->
            <div class="col-md-4">

                <div class="smart-card h-100 text-center">

                    <i class="bi bi-emoji-smile feature-icon"></i>

                    <h4>
                        Dentists
                    </h4>

                    <p>

                        Dentique provides preventive, cosmetic and
                        paediatric dentistry.

                    </p>

                </div>

            </div>


            <!-- DIETICIANS -->
            <div class="col-md-4">

                <div class="smart-card h-100 text-center">

                    <i class="bi bi-apple feature-icon"></i>

                    <h4>
                        Dieticians
                    </h4>

                    <p>

                        Pure Health Dieticians assist with nutrition
                        planning and healthy lifestyle management.

                    </p>

                </div>

            </div>


            <!-- ORTHOTISTS & PROSTHETISTS -->
            <div class="col-md-4">

                <div class="smart-card h-100 text-center">

                    <i class="bi bi-person-standing feature-icon"></i>

                    <h4>
                        Orthotists & Prosthetists
                    </h4>

                    <p>

                        Swanepoel Orthotics and Prosthetics provide
                        rehabilitation support services.

                    </p>

                </div>

            </div>


            <!-- PHYSIOTHERAPY -->
            <div class="col-md-4">

                <div class="smart-card h-100 text-center">

                    <i class="bi bi-activity feature-icon"></i>

                    <h4>
                        Physiotherapy
                    </h4>

                    <p>

                        Patient-focused multidisciplinary care.

                    </p>

                </div>

            </div>


            <!-- PODIATRIST -->
            <div class="col-md-4">

                <div class="smart-card h-100 text-center">

                    <i class="bi bi-person-walking feature-icon"></i>

                    <h4>
                        Podiatrist
                    </h4>

                    <p>

                        Lucas Breedt provides expert lower limb
                        healthcare services.

                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- LOCATION BANNER -->
<section class="contact-banner">

    <div class="container text-center">

        <i class="bi bi-geo-alt-fill mb-3"
               style="font-size:48px;">
        </i>

        <h2 class="mb-3">
            Where To Find Us
        </h2>

        <p class="mb-4">

            Doringkloof Mall<br />
            6 Aster Avenue<br />
            Centurion

        </p>

        <a asp-controller="Home"
               asp-action="Contact"
               class="smart-btn-primary text-decoration-none">

            Contact Us

        </a>

    </div>

</section>