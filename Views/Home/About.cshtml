@{
    ViewData["Title"] = "About Us";
}

<div class="public-page">

    <!-- HERO -->

    <section class="service-directory-hero"
             aria-labelledby="aboutHeading">

        <div class="container">

            <div class="service-directory-hero-content">

                <span class="smart-badge">
                    Doringkloof Medical Centre
                </span>

                <h1 id="aboutHeading">
                    Healthcare for
                    <span class="text-primary">
                        every stage of life.
                    </span>
                </h1>

                <p>
                    Doringkloof Medical Centre brings together a range
                    of healthcare professionals and services in one
                    convenient location in Centurion.
                </p>

            </div>

        </div>

    </section>

    <!-- ABOUT THE PRACTICE -->

    <section class="page-section">

        <div class="container">

            <div class="row align-items-stretch g-5">

                <div class="col-lg-6">

                    <div class="about-image-wrapper h-100">

                        <img src="~/images/Doctor.jpg"
                             alt="Healthcare professional"
                             class="img-fluid about-image" />

                    </div>

                </div>

                <div class="col-lg-6">

                    <div class="about-content h-100 p-4 p-lg-5">

                        <span class="smart-badge">
                            About Our Practice
                        </span>

                        <h2 class="section-title mt-3 mb-4">
                            A connected approach to healthcare
                        </h2>

                        <p class="mb-4">
                            Doringkloof Medical Centre is conveniently
                            located within Doringkloof Mall and provides
                            access to a range of healthcare professionals.
                        </p>

                        <p class="mb-4">
                            Our multidisciplinary environment brings
                            different areas of healthcare together,
                            helping patients access services in one
                            convenient location.
                        </p>

                        <div class="about-detail-list">

                            <div class="about-detail">

                                <div class="about-detail-icon"
                                     aria-hidden="true">
                                    <i class="bi bi-geo-alt"></i>
                                </div>

                                <div>
                                    <strong>
                                        Convenient location
                                    </strong>

                                    <span>
                                        Doringkloof Mall, Centurion
                                    </span>
                                </div>

                            </div>

                            <div class="about-detail">

                                <div class="about-detail-icon"
                                     aria-hidden="true">
                                    <i class="bi bi-people"></i>
                                </div>

                                <div>
                                    <strong>
                                        Multidisciplinary care
                                    </strong>

                                    <span>
                                        A range of healthcare professionals
                                        in one environment
                                    </span>
                                </div>

                            </div>

                            <div class="about-detail">

                                <div class="about-detail-icon"
                                     aria-hidden="true">
                                    <i class="bi bi-heart"></i>
                                </div>

                                <div>
                                    <strong>
                                        Patient focused
                                    </strong>

                                    <span>
                                        Healthcare designed around
                                        individual patient needs
                                    </span>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- OUR APPROACH -->

    <section class="page-section bg-white"
             aria-labelledby="approachHeading">

        <div class="container">

            <div class="row align-items-center g-5">

                <div class="col-lg-7">

                    <span class="smart-badge">
                        Our Approach
                    </span>

                    <h2 id="approachHeading"
                        class="section-title mt-3 mb-4">

                        Healthcare centred around the patient

                    </h2>

                    <p class="public-lead">
                        We believe healthcare should be accessible,
                        connected and focused on the individual.
                    </p>

                    <p>
                        Doringkloof Medical Centre brings together
                        different areas of healthcare within a
                        convenient environment, making it easier for
                        patients and families to access the support
                        they need.
                    </p>

                    <p class="mb-0">
                        From general medical care to dental,
                        nutritional and rehabilitation services,
                        our healthcare environment supports a
                        broad range of individual needs.
                    </p>

                </div>

                <div class="col-lg-5">

                    <div class="about-approach-panel">

                        <div class="about-approach-item">

                            <i class="bi bi-person-heart"
                               aria-hidden="true"></i>

                            <div>
                                <strong>
                                    Patient centred
                                </strong>

                                <span>
                                    Care that considers the individual
                                    needs of each patient.
                                </span>
                            </div>

                        </div>

                        <div class="about-approach-item">

                            <i class="bi bi-diagram-3"
                               aria-hidden="true"></i>

                            <div>
                                <strong>
                                    Connected care
                                </strong>

                                <span>
                                    Multiple healthcare disciplines
                                    in one convenient environment.
                                </span>
                            </div>

                        </div>

                        <div class="about-approach-item">

                            <i class="bi bi-shield-check"
                               aria-hidden="true"></i>

                            <div>
                                <strong>
                                    Professional support
                                </strong>

                                <span>
                                    Access to healthcare professionals
                                    across different areas of care.
                                </span>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- LOCATION -->

    <section class="page-section">

        <div class="container">

            <div class="location-banner p-4 p-lg-5">

                <div class="row align-items-center g-4">

                    <div class="col-lg-8">

                        <span class="smart-badge">
                            Find Us
                        </span>

                        <h2 class="mt-3 mb-3">
                            Visit Doringkloof Medical Centre
                        </h2>

                        <p class="mb-0">
                            Doringkloof Mall<br />
                            6 Aster Avenue<br />
                            Doringkloof, Centurion
                        </p>

                    </div>

                    <div class="col-lg-4 text-lg-end">

                        <a asp-controller="Home"
                               asp-action="Contact"
                               class="smart-btn-primary text-decoration-none">

                            Contact Us

                            <i class="bi bi-arrow-right ms-2"
                               aria-hidden="true"></i>

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- FINAL MESSAGE -->

    <section class="contact-banner">

        <div class="container text-center">

            <h2 class="mt-4 mb-3">
                A healthcare environment built around people.
            </h2>

            <p class="mb-4">
                Explore our healthcare services or get in touch
                with the practice.
            </p>

            <div class="d-flex justify-content-center flex-wrap gap-3">

                <a asp-controller="Home"
                       asp-action="Contact"
                       class="smart-btn-primary text-decoration-none">

                    Contact Us

                </a>

                <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-outline-primary rounded-3 px-4 py-3">

                    Back to Home

                </a>

            </div>

        </div>

    </section>

</div>