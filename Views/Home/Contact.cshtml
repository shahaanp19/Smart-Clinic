@{
    ViewData["Title"] = "Contact";
}

<section class="container py-5">

    <div class="row">

        <div class="col-lg-5">

            <h1>Get in touch</h1>

            <p>

                Doringkloof Mall, 6 Aster Avenue,<br>

                Doringkloof, Centurion

            </p>

            <p>

                julia@drlvd.co.za

            </p>

            <p>

                (012) 667-2550

            </p>

            <p>

                (012) 667-2551

            </p>

        </div>


        <div class="col-lg-7">

            <div class="smart-card">

                <h3>

                    Message us

                </h3>

                <p>

                    Fields marked with * are required

                </p>

                <form>

                    <input class="form-control mb-3"
                           placeholder="Name *">

                    <input class="form-control mb-3"
                           placeholder="Surname *">

                    <input class="form-control mb-3"
                           placeholder="Phone Number *">

                    <input class="form-control mb-3"
                           placeholder="Email *">


                    <select class="form-select mb-3">

                        <option>

                            Family Practitioner

                        </option>

                    </select>

                    <textarea class="form-control mb-3"
                          rows="6"
                              placeholder="Message *">
</textarea>

                    <button class="smart-btn-primary">

                        Send Message

                    </button>

                </form>

            </div>

        </div>

    </div>

</section>