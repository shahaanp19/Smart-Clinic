@{
    ViewData["Title"] = "Contact";
}

<div class="public-page">

    <!-- HERO -->

    <section class="service-directory-hero"
             aria-labelledby="contactHeading">

        <div class="container">

            <div class="service-directory-hero-content">

                <span class="smart-badge">
                    Contact Us
                </span>

                <h1 id="contactHeading">
                    We're here to help.
                </h1>

                <p>
                    Get in touch with Doringkloof Medical Centre
                    for appointments, enquiries or information
                    about our healthcare services.
                </p>

            </div>

        </div>

    </section>

    <!-- CONTACT CONTENT -->

    <section class="page-section">

        <div class="container">

            <div class="row g-5 align-items-stretch">

                <!-- CONTACT INFORMATION -->

                <div class="col-lg-5">

                    <div class="contact-info-panel h-100 p-4 p-lg-5">

                        <span class="smart-badge">
                            Get in Touch
                        </span>

                        <h2 class="section-title mt-3 mb-4">
                            Contact information
                        </h2>

                        <p class="contact-intro mb-4">
                            Whether you have a question about our services
                            or need assistance contacting the practice,
                            our team is available to assist.
                        </p>

                        <div class="contact-detail">

                            <div class="contact-detail-icon"
                                 aria-hidden="true">
                                <i class="bi bi-geo-alt"></i>
                            </div>

                            <div>
                                <span class="contact-detail-label">
                                    Address
                                </span>

                                <p class="mb-0">
                                    Doringkloof Mall<br />
                                    6 Aster Avenue<br />
                                    Doringkloof<br />
                                    Centurion
                                </p>
                            </div>

                        </div>

                        <div class="contact-detail">

                            <div class="contact-detail-icon"
                                 aria-hidden="true">
                                <i class="bi bi-envelope"></i>
                            </div>

                            <div>
                                <span class="contact-detail-label">
                                    Email
                                </span>

                                <p class="mb-0">
                                    julia@drlvd.co.za
                                </p>
                            </div>

                        </div>

                        <div class="contact-detail">

                            <div class="contact-detail-icon"
                                 aria-hidden="true">
                                <i class="bi bi-telephone"></i>
                            </div>

                            <div>
                                <span class="contact-detail-label">
                                    Telephone
                                </span>

                                <p class="mb-0">
                                    (012) 667-2550<br />
                                    (012) 667-2551
                                </p>
                            </div>

                        </div>

                    </div>

                </div>

                <!-- CONTACT FORM -->

                <div class="col-lg-7">

                    <div class="smart-card contact-form-card h-100 p-4 p-lg-5">

                        <div class="mb-4">

                            <span class="smart-badge">
                                Send a Message
                            </span>

                            <h2 class="mt-3 mb-2">
                                How can we help?
                            </h2>

                            <p class="text-muted mb-0">
                                Complete the form below and provide
                                as much information as possible.
                            </p>

                        </div>

                        <form>

                            <div class="row g-4">

                                <div class="col-md-6">

                                    <label for="name"
                                           class="form-label smart-label">
                                        Name
                                    </label>

                                    <input id="name"
                                           name="name"
                                           type="text"
                                           class="form-control smart-input"
                                           placeholder="Enter your name"
                                           autocomplete="given-name"
                                           required />

                                </div>

                                <div class="col-md-6">

                                    <label for="surname"
                                           class="form-label smart-label">
                                        Surname
                                    </label>

                                    <input id="surname"
                                           name="surname"
                                           type="text"
                                           class="form-control smart-input"
                                           placeholder="Enter your surname"
                                           autocomplete="family-name"
                                           required />

                                </div>

                                <div class="col-md-6">

                                    <label for="phone"
                                           class="form-label smart-label">
                                        Phone Number
                                    </label>

                                    <input id="phone"
                                           name="phone"
                                           type="tel"
                                           class="form-control smart-input"
                                           placeholder="Enter your phone number"
                                           autocomplete="tel"
                                           required />

                                </div>

                                <div class="col-md-6">

                                    <label for="email"
                                           class="form-label smart-label">
                                        Email Address
                                    </label>

                                    <input id="email"
                                           name="email"
                                           type="email"
                                           class="form-control smart-input"
                                           placeholder="Enter your email address"
                                           autocomplete="email"
                                           required />

                                </div>

                                <div class="col-12">

                                    <label for="service"
                                           class="form-label smart-label">
                                        Enquiry Type
                                    </label>

                                    <select id="service"
                                            name="service"
                                            class="form-select smart-input"
                                            required>

                                        <option value=""
                                                selected
                                                disabled>
                                            Select an enquiry type
                                        </option>

                                        <option value="general">
                                            General Enquiry
                                        </option>

                                        <option value="appointment">
                                            Appointment Enquiry
                                        </option>

                                        <option value="medical-services">
                                            Medical Services
                                        </option>

                                        <option value="patient-portal">
                                            Patient Portal
                                        </option>

                                        <option value="other">
                                            Other
                                        </option>

                                    </select>

                                </div>

                                <div class="col-12">

                                    <label for="message"
                                           class="form-label smart-label">
                                        Message
                                    </label>

                                    <textarea id="message"
                                              name="message"
                                              class="form-control smart-input"
                                              rows="6"
                                              placeholder="How can we help?"
                                              required></textarea>

                                </div>

                                <div class="col-12 pt-2">

                                    <button type="submit"
                                            class="smart-btn-primary">

                                        <i class="bi bi-send me-2"
                                           aria-hidden="true"></i>

                                        Send Message

                                    </button>

                                </div>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- LOCATION -->

    <section class="page-section bg-white">

        <div class="container">

            <div class="row justify-content-center text-center">

                <div class="col-lg-8">

                    <span class="smart-badge">
                        Find Us
                    </span>

                    <h2 class="section-title mt-3 mb-3">
                        Visit Doringkloof Medical Centre
                    </h2>

                    <p class="section-subtitle mb-4">
                        Doringkloof Mall, 6 Aster Avenue,
                        Doringkloof, Centurion.
                    </p>

                    <a href="https://www.google.com/maps/search/?api=1&amp;query=6+Aster+Avenue+Doringkloof+Centurion"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-outline-primary rounded-3 px-4 py-3">

                        <i class="bi bi-geo-alt me-2"
                           aria-hidden="true"></i>

                        View Location

                    </a>

                </div>

            </div>

        </div>

    </section>

    <!-- FINAL CTA -->

    <section class="contact-banner">

        <div class="container text-center">

            <h2 class="mt-4 mb-3">
                Need assistance?
            </h2>

            <p class="mb-4">
                We're ready to help with your enquiry.
            </p>

            <a asp-controller="Patient"
                   asp-action="Dashboard"
                   class="smart-btn-primary text-decoration-none">

                Patient Portal

                <i class="bi bi-arrow-right ms-2"
                   aria-hidden="true"></i>

            </a>

        </div>

    </section>

</div>