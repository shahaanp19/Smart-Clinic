@{
    ViewData["Title"] = "Home";
}

<div class="home-page">

    ```
    <!-- HERO -->
    <section class="home-hero-section">
        <div class="container">

            <div class="home-hero-card">

                <div class="home-hero-content">

                    <div class="home-logo-wrap">
                        <img src="~/images/Logo.png"
                             alt="Doringkloof Medical Centre"
                             class="home-logo" />
                    </div>

                    <div class="home-eyebrow">
                        <i class="bi bi-heart-pulse-fill"></i>
                        Smart Healthcare
                    </div>

                    <h1 class="home-hero-title">
                        Healthcare that
                        <span>puts you first.</span>
                    </h1>

                    <p class="home-hero-text">
                        A simple digital experience for accessing healthcare
                        services, managing appointments and staying connected
                        with your clinic.
                    </p>

                    <div class="home-hero-actions">

                        <a asp-controller="Patient"
                               asp-action="Dashboard"
                               class="home-primary-button">

                            <i class="bi bi-person-circle"></i>

                            Patient Portal

                            <i class="bi bi-arrow-right"></i>

                        </a>

                        <a asp-controller="Home"
                               asp-action="Divisions"
                               class="home-secondary-button">

                            Explore Services

                            <i class="bi bi-arrow-up-right"></i>

                        </a>

                    </div>

                </div>

                <div class="home-hero-image">

                    <img src="~/images/Consult 3.jpg"
                         alt="Doctor consulting with a patient" />

                    <div class="home-hero-status">

                        <div class="home-status-icon">
                            <i class="bi bi-check-lg"></i>
                        </div>

                        <div>
                            <span>Smart Clinic</span>
                            <strong>Your care, connected.</strong>
                        </div>

                    </div>

                </div>

            </div>

        </div>
    </section>


    <!-- QUICK ACCESS -->
    <section class="home-section">

        <div class="container">

            <div class="home-section-header">

                <div>
                    <span class="home-section-label">
                        Quick Access
                    </span>

                    <h2>
                        Your healthcare at a glance.
                    </h2>
                </div>

                <p>
                    Access the services and information you use most.
                </p>

            </div>


            <div class="row g-4">

                <!-- APPOINTMENTS -->
                <div class="col-md-6 col-xl-3">

                    <a asp-controller="Patient"
                           asp-action="Dashboard"
                           class="home-smart-card">

                        <div class="home-card-top">

                            <div class="home-card-icon">
                                <i class="bi bi-calendar2-check"></i>
                            </div>

                            <span class="home-card-number">
                                01
                            </span>

                        </div>

                        <div class="home-card-body">

                            <h3>
                                Appointments
                            </h3>

                            <p>
                                View and manage your healthcare appointments.
                            </p>

                        </div>

                        <div class="home-card-footer">

                            <span>
                                Patient Portal
                            </span>

                            <i class="bi bi-arrow-up-right"></i>

                        </div>

                    </a>

                </div>


                <!-- MEDICAL RECORDS -->
                <div class="col-md-6 col-xl-3">

                    <a asp-controller="Patient"
                           asp-action="Dashboard"
                           class="home-smart-card">

                        <div class="home-card-top">

                            <div class="home-card-icon">
                                <i class="bi bi-file-earmark-medical"></i>
                            </div>

                            <span class="home-card-number">
                                02
                            </span>

                        </div>

                        <div class="home-card-body">

                            <h3>
                                Medical Records
                            </h3>

                            <p>
                                Access your healthcare information in one place.
                            </p>

                        </div>

                        <div class="home-card-footer">

                            <span>
                                Patient Portal
                            </span>

                            <i class="bi bi-arrow-up-right"></i>

                        </div>

                    </a>

                </div>


                <!-- SERVICES -->
                <div class="col-md-6 col-xl-3">

                    <a asp-controller="Home"
                           asp-action="Divisions"
                           class="home-smart-card">

                        <div class="home-card-top">

                            <div class="home-card-icon">
                                <i class="bi bi-grid-1x2"></i>
                            </div>

                            <span class="home-card-number">
                                03
                            </span>

                        </div>

                        <div class="home-card-body">

                            <h3>
                                Medical Services
                            </h3>

                            <p>
                                Explore the healthcare services available.
                            </p>

                        </div>

                        <div class="home-card-footer">

                            <span>
                                Explore Services
                            </span>

                            <i class="bi bi-arrow-up-right"></i>

                        </div>

                    </a>

                </div>


                <!-- CONTACT -->
                <div class="col-md-6 col-xl-3">

                    <a asp-controller="Home"
                           asp-action="Contact"
                           class="home-smart-card">

                        <div class="home-card-top">

                            <div class="home-card-icon">
                                <i class="bi bi-chat-square-text"></i>
                            </div>

                            <span class="home-card-number">
                                04
                            </span>

                        </div>

                        <div class="home-card-body">

                            <h3>
                                Contact Us
                            </h3>

                            <p>
                                Get in touch with the medical centre.
                            </p>

                        </div>

                        <div class="home-card-footer">

                            <span>
                                Contact Practice
                            </span>

                            <i class="bi bi-arrow-up-right"></i>

                        </div>

                    </a>

                </div>

            </div>

        </div>

    </section>


    <!-- SERVICES -->
    <section class="home-section home-services">

        <div class="container">

            <div class="home-section-header">

                <div>

                    <span class="home-section-label">
                        Healthcare Services
                    </span>

                    <h2>
                        Comprehensive care.
                    </h2>

                </div>

                <a asp-controller="Home"
                       asp-action="Divisions"
                       class="home-section-link">

                    View all services

                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>


            <div class="row g-4">

                <!-- DOCTORS -->
                <div class="col-md-6 col-lg-4">

                    <div class="home-service-card">

                        <div class="home-service-header">

                            <div class="home-service-icon">
                                <i class="bi bi-heart-pulse"></i>
                            </div>

                            <span>01</span>

                        </div>

                        <h3>
                            Doctors
                        </h3>

                        <p>
                            General and family healthcare for everyday
                            medical needs.
                        </p>

                        <a asp-controller="Home"
                               asp-action="Divisions"
                               class="home-service-link">

                            Learn more

                            <i class="bi bi-arrow-right"></i>

                        </a>

                    </div>

                </div>


                <!-- DENTISTRY -->
                <div class="col-md-6 col-lg-4">

                    <div class="home-service-card">

                        <div class="home-service-header">

                            <div class="home-service-icon">
                                <i class="bi bi-emoji-smile"></i>
                            </div>

                            <span>02</span>

                        </div>

                        <h3>
                            Dentistry
                        </h3>

                        <p>
                            Preventive, cosmetic and paediatric
                            dental care.
                        </p>

                        <a asp-controller="Home"
                               asp-action="Divisions"
                               class="home-service-link">

                            Learn more

                            <i class="bi bi-arrow-right"></i>

                        </a>

                    </div>

                </div>


                <!-- DIETETICS -->
                <div class="col-md-6 col-lg-4">

                    <div class="home-service-card">

                        <div class="home-service-header">

                            <div class="home-service-icon">
                                <i class="bi bi-apple"></i>
                            </div>

                            <span>03</span>

                        </div>

                        <h3>
                            Dietetics
                        </h3>

                        <p>
                            Nutrition guidance and personalised
                            lifestyle support.
                        </p>

                        <a asp-controller="Home"
                               asp-action="Divisions"
                               class="home-service-link">

                            Learn more

                            <i class="bi bi-arrow-right"></i>

                        </a>

                    </div>

                </div>


                <!-- ORTHOTICS -->
                <div class="col-md-6 col-lg-4">

                    <div class="home-service-card">

                        <div class="home-service-header">

                            <div class="home-service-icon">
                                <i class="bi bi-person-standing"></i>
                            </div>

                            <span>04</span>

                        </div>

                        <h3>
                            Orthotics & Prosthetics
                        </h3>

                        <p>
                            Support for mobility, rehabilitation
                            and improved function.
                        </p>

                        <a asp-controller="Home"
                               asp-action="Divisions"
                               class="home-service-link">

                            Learn more

                            <i class="bi bi-arrow-right"></i>

                        </a>

                    </div>

                </div>


                <!-- PHYSIOTHERAPY -->
                <div class="col-md-6 col-lg-4">

                    <div class="home-service-card">

                        <div class="home-service-header">

                            <div class="home-service-icon">
                                <i class="bi bi-activity"></i>
                            </div>

                            <span>05</span>

                        </div>

                        <h3>
                            Physiotherapy
                        </h3>

                        <p>
                            Rehabilitation and movement-focused
                            healthcare.
                        </p>

                        <a asp-controller="Home"
                               asp-action="Divisions"
                               class="home-service-link">

                            Learn more

                            <i class="bi bi-arrow-right"></i>

                        </a>

                    </div>

                </div>


                <!-- PODIATRY -->
                <div class="col-md-6 col-lg-4">

                    <div class="home-service-card">

                        <div class="home-service-header">

                            <div class="home-service-icon">
                                <i class="bi bi-person-walking"></i>
                            </div>

                            <span>06</span>

                        </div>

                        <h3>
                            Podiatry
                        </h3>

                        <p>
                            Foot, ankle and lower-limb healthcare
                            and treatment.
                        </p>

                        <a asp-controller="Home"
                               asp-action="Divisions"
                               class="home-service-link">

                            Learn more

                            <i class="bi bi-arrow-right"></i>

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- PATIENT PORTAL -->
    <section class="home-section">

        <div class="container">

            <div class="home-patient-card">

                <div class="home-patient-content">

                    <span class="home-section-label">
                        Patient Portal
                    </span>

                    <h2>
                        Your healthcare,
                        <span>in one place.</span>
                    </h2>

                    <p>
                        Access your patient dashboard and manage your
                        healthcare experience through one convenient
                        digital portal.
                    </p>

                    <a asp-controller="Patient"
                           asp-action="Dashboard"
                           class="home-primary-button">

                        Open Patient Portal

                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>


                <div class="home-patient-features">

                    <div class="home-patient-feature">

                        <div class="home-mini-icon">
                            <i class="bi bi-calendar-check"></i>
                        </div>

                        <div>
                            <strong>Appointments</strong>
                            <span>Manage your visits</span>
                        </div>

                    </div>


                    <div class="home-patient-feature">

                        <div class="home-mini-icon">
                            <i class="bi bi-file-medical"></i>
                        </div>

                        <div>
                            <strong>Medical Records</strong>
                            <span>Access your information</span>
                        </div>

                    </div>


                    <div class="home-patient-feature">

                        <div class="home-mini-icon">
                            <i class="bi bi-person-check"></i>
                        </div>

                        <div>
                            <strong>Profile</strong>
                            <span>Manage your details</span>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- CHATBOT -->
    <div class="home-chatbot">

        <a asp-controller="Home"
               asp-action="Chatbot"
               aria-label="Open healthcare assistant">

            <i class="bi bi-chat-dots-fill"></i>

        </a>

    </div>
    ```

</div>
