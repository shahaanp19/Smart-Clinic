@{
    ViewData["Title"] = "Home";
}

<div class="home-page">

    <!-- HERO -->
    <section class="home-hero-section">
        <div class="container">
            <div class="home-hero-card">

                <div class="home-hero-content">

                    <div class="home-eyebrow">
                        <i class="bi bi-heart-pulse-fill" aria-hidden="true"></i>
                        Smart Healthcare
                    </div>

                    <h1 class="home-hero-title">
                        Healthcare that
                        <span>puts you first.</span>
                    </h1>

                    <p class="home-hero-text">
                        A simple digital experience for accessing healthcare
                        services, managing appointments and staying connected
                        with Doringkloof Medical Centre.
                    </p>

                    <div class="home-hero-actions">

                        <a asp-controller="Patient"
                               asp-action="Dashboard"
                               class="home-primary-button">
                            <i class="bi bi-person-circle" aria-hidden="true"></i>
                            <span>Patient Portal</span>
                            <i class="bi bi-arrow-right" aria-hidden="true"></i>
                        </a>

                        <a asp-controller="Home"
                               asp-action="MedicalDivisions"
                               class="home-secondary-button">
                            <span>Explore Services</span>
                            <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                        </a>

                    </div>

                </div>

                <div class="home-hero-image">
                    <img src="~/images/Consult 3.jpg"
                         alt="Doctor consulting with a patient at Doringkloof Medical Centre"
                         loading="eager" />
                </div>

            </div>
        </div>
    </section>


    <!-- QUICK ACCESS -->
    <section class="home-section" aria-labelledby="quickAccessHeading">

        <div class="container">

            <div class="home-section-header">

                <div>
                    <span class="home-section-label">
                        Quick Access
                    </span>

                    <h2 id="quickAccessHeading">
                        Your healthcare at a glance.
                    </h2>
                </div>

                <p>
                    Access the services and information you use most.
                </p>

            </div>

            <div class="row g-4">

                <!-- APPOINTMENTS -->
                <div class="col-md-6 col-xl-3">

                    <a asp-controller="Patient"
                           asp-action="Dashboard"
                           class="home-smart-card">

                        <div class="home-card-body">

                            <h3>
                                Appointments
                            </h3>

                            <p>
                                View and manage your healthcare appointments.
                            </p>

                        </div>

                        <div class="home-card-footer">

                            <span>
                                Patient Portal
                            </span>

                            <i class="bi bi-arrow-up-right"
                               aria-hidden="true"></i>

                        </div>

                    </a>

                </div>


                <!-- MEDICAL RECORDS -->
                <div class="col-md-6 col-xl-3">

                    <a asp-controller="Patient"
                           asp-action="Dashboard"
                           class="home-smart-card">

                        <div class="home-card-body">

                            <h3>
                                Medical Records
                            </h3>

                            <p>
                                Access your healthcare information in one place.
                            </p>

                        </div>

                        <div class="home-card-footer">

                            <span>
                                Patient Portal
                            </span>

                            <i class="bi bi-arrow-up-right"
                               aria-hidden="true"></i>

                        </div>

                    </a>

                </div>


                <!-- SERVICES -->
                <div class="col-md-6 col-xl-3">

                    <a asp-controller="Home"
                           asp-action="MedicalDivisions"
                           class="home-smart-card">

                        <div class="home-card-body">

                            <h3>
                                Medical Services
                            </h3>

                            <p>
                                Explore the healthcare services available.
                            </p>

                        </div>

                        <div class="home-card-footer">

                            <span>
                                Explore Services
                            </span>

                            <i class="bi bi-arrow-up-right"
                               aria-hidden="true"></i>

                        </div>

                    </a>

                </div>


                <!-- CONTACT -->
                <div class="col-md-6 col-xl-3">

                    <a asp-controller="Home"
                           asp-action="Contact"
                           class="home-smart-card">

                        <div class="home-card-body">

                            <h3>
                                Contact Us
                            </h3>

                            <p>
                                Get in touch with the medical centre.
                            </p>

                        </div>

                        <div class="home-card-footer">

                            <span>
                                Contact Practice
                            </span>

                            <i class="bi bi-arrow-up-right"
                               aria-hidden="true"></i>

                        </div>

                    </a>

                </div>

            </div>

        </div>

    </section>


    <!-- SERVICES -->
    <section class="home-section home-services"
             aria-labelledby="servicesHeading">

        <div class="container">

            <div class="home-section-header">

                <div>

                    <span class="home-section-label">
                        Healthcare Services
                    </span>

                    <h2 id="servicesHeading">
                        Comprehensive care.
                    </h2>

                </div>

                <a asp-controller="Home"
                       asp-action="MedicalDivisions"
                       class="home-section-link">

                    View all services

                    <i class="bi bi-arrow-right"
                       aria-hidden="true"></i>

                </a>

            </div>


            <div class="row g-4">

                <!-- DOCTORS -->
                <div class="col-md-6 col-lg-4">

                    <div class="home-service-card">

                        <h3>
                            Doctors
                        </h3>

                        <p>
                            General and family healthcare for everyday
                            medical needs.
                        </p>

                        <a asp-controller="Home"
                               asp-action="Doctors"
                               class="home-service-link">

                            Learn more

                            <i class="bi bi-arrow-right"
                               aria-hidden="true"></i>

                        </a>

                    </div>

                </div>


                <!-- DENTISTRY -->
                <div class="col-md-6 col-lg-4">

                    <div class="home-service-card">

                        <h3>
                            Dentistry
                        </h3>

                        <p>
                            Preventive, cosmetic and paediatric
                            dental care.
                        </p>

                        <a asp-controller="Home"
                               asp-action="Dentistry"
                               class="home-service-link">

                            Learn more

                            <i class="bi bi-arrow-right"
                               aria-hidden="true"></i>

                        </a>

                    </div>

                </div>


                <!-- DIETETICS -->
                <div class="col-md-6 col-lg-4">

                    <div class="home-service-card">

                        <h3>
                            Dietetics
                        </h3>

                        <p>
                            Nutrition guidance and personalised
                            lifestyle support.
                        </p>

                        <a asp-controller="Home"
                               asp-action="Dietetics"
                               class="home-service-link">

                            Learn more

                            <i class="bi bi-arrow-right"
                               aria-hidden="true"></i>

                        </a>

                    </div>

                </div>


                <!-- ORTHOTICS & PROSTHETICS -->
                <div class="col-md-6 col-lg-4">

                    <div class="home-service-card">

                        <h3>
                            Orthotics &amp; Prosthetics
                        </h3>

                        <p>
                            Support for mobility, rehabilitation
                            and improved function.
                        </p>

                        <a asp-controller="Home"
                               asp-action="OrthoticsAndProsthetics"
                               class="home-service-link">

                            Learn more

                            <i class="bi bi-arrow-right"
                               aria-hidden="true"></i>

                        </a>

                    </div>

                </div>


                <!-- PHYSIOTHERAPY -->
                <div class="col-md-6 col-lg-4">

                    <div class="home-service-card">

                        <h3>
                            Physiotherapy
                        </h3>

                        <p>
                            Rehabilitation and movement-focused
                            healthcare.
                        </p>

                        <a asp-controller="Home"
                               asp-action="Physiotherapy"
                               class="home-service-link">

                            Learn more

                            <i class="bi bi-arrow-right"
                               aria-hidden="true"></i>

                        </a>

                    </div>

                </div>


                <!-- PODIATRY -->
                <div class="col-md-6 col-lg-4">

                    <div class="home-service-card">

                        <h3>
                            Podiatry
                        </h3>

                        <p>
                            Foot, ankle and lower-limb healthcare
                            and treatment.
                        </p>

                        <a asp-controller="Home"
                               asp-action="Podiatry"
                               class="home-service-link">

                            Learn more

                            <i class="bi bi-arrow-right"
                               aria-hidden="true"></i>

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- PATIENT PORTAL -->
    <section class="home-section"
             aria-labelledby="patientPortalHeading">

        <div class="container">

            <div class="home-patient-card">

                <div class="home-patient-content">

                    <span class="home-section-label">
                        Patient Portal
                    </span>

                    <h2 id="patientPortalHeading">
                        Your healthcare,
                        <span>in one place.</span>
                    </h2>

                    <p>
                        Access your patient dashboard and manage your
                        healthcare experience through one convenient
                        digital portal.
                    </p>

                    <a asp-controller="Patient"
                           asp-action="Dashboard"
                           class="home-primary-button">

                        <span>
                            Open Patient Portal
                        </span>

                        <i class="bi bi-arrow-right"
                           aria-hidden="true"></i>

                    </a>

                </div>


                <div class="home-patient-features"
                     aria-label="Patient portal features">

                    <div class="home-patient-feature">

                        <div class="home-mini-icon">
                            <i class="bi bi-calendar-check"
                               aria-hidden="true"></i>
                        </div>

                        <div>
                            <strong>Appointments</strong>
                            <span>Manage your visits</span>
                        </div>

                    </div>


                    <div class="home-patient-feature">

                        <div class="home-mini-icon">
                            <i class="bi bi-file-medical"
                               aria-hidden="true"></i>
                        </div>

                        <div>
                            <strong>Medical Records</strong>
                            <span>Access your information</span>
                        </div>

                    </div>


                    <div class="home-patient-feature">

                        <div class="home-mini-icon">
                            <i class="bi bi-person-check"
                               aria-hidden="true"></i>
                        </div>

                        <div>
                            <strong>Profile</strong>
                            <span>Manage your details</span>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- CHATBOT -->
    <div class="home-chatbot">

        <a asp-controller="Home"
               asp-action="Chatbot"
               class="home-chatbot-button"
               aria-label="Open healthcare assistant">

            <i class="bi bi-chat-dots-fill"
               aria-hidden="true"></i>

            <span>...</span>

        </a>

    
    </div>

</div>