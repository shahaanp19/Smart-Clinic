@{
    ViewData["Title"] = "Reports & Analytics";
}

<section class="page-section admin-reports-page">

    <div class="container">

        <div class="reports-page-header">

            <div>
                <span class="smart-badge">
                    Clinic Analytics
                </span>

                <h1 class="dashboard-title mt-3">
                    Reports & Analytics
                </h1>

                <p class="text-muted mb-0">
                    Review clinic performance, appointments, attendance,
                    utilisation and operational activity.
                </p>
            </div>

            <div class="reports-header-icon">
                <i class="bi bi-bar-chart-line"></i>
            </div>

        </div>


        <!-- OVERVIEW -->

        <div class="reports-stat-grid">

            <div class="smart-card reports-stat-card">

                <div class="reports-stat-icon">
                    <i class="bi bi-calendar-check"></i>
                </div>

                <div>
                    <span>Appointments</span>
                    <strong>—</strong>
                    <small>No data available</small>
                </div>

            </div>


            <div class="smart-card reports-stat-card">

                <div class="reports-stat-icon">
                    <i class="bi bi-people"></i>
                </div>

                <div>
                    <span>Registered Patients</span>
                    <strong>—</strong>
                    <small>No data available</small>
                </div>

            </div>


            <div class="smart-card reports-stat-card">

                <div class="reports-stat-icon">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>

                <div>
                    <span>Attendance Rate</span>
                    <strong>—</strong>
                    <small>No data available</small>
                </div>

            </div>


            <div class="smart-card reports-stat-card">

                <div class="reports-stat-icon">
                    <i class="bi bi-cash-stack"></i>
                </div>

                <div>
                    <span>Revenue</span>
                    <strong>—</strong>
                    <small>No data available</small>
                </div>

            </div>

        </div>


        <!-- REPORT FILTERS -->

        <div class="smart-card reports-filter-card">

            <div class="reports-card-header">

                <div>
                    <span class="reports-section-label">
                        REPORT PARAMETERS
                    </span>

                    <h3>
                        Report Period
                    </h3>

                    <p>
                        Select a reporting period to generate analytics.
                    </p>
                </div>

                <div class="reports-period-control">

                    <label for="reportPeriod">
                        Period
                    </label>

                    <select id="reportPeriod"
                            class="form-select smart-input">

                        <option value="monthly">
                            Monthly
                        </option>

                        <option value="quarterly">
                            Quarterly
                        </option>

                        <option value="yearly">
                            Yearly
                        </option>

                    </select>

                </div>

            </div>


            <div class="reports-date-grid">

                <div>
                    <label for="dateFrom"
                           class="form-label reports-label">
                        From
                    </label>

                    <input id="dateFrom"
                           type="date"
                           class="form-control smart-input" />
                </div>


                <div>
                    <label for="dateTo"
                           class="form-label reports-label">
                        To
                    </label>

                    <input id="dateTo"
                           type="date"
                           class="form-control smart-input" />
                </div>


                <div class="reports-generate-wrapper">

                    <button type="button"
                            id="generateReport"
                            class="smart-btn-primary reports-generate-button">

                        <i class="bi bi-arrow-repeat me-2"></i>
                        Generate Report

                    </button>

                </div>

            </div>


            <div id="reportMessage"
                 class="reports-message d-none">
            </div>

        </div>


        <!-- ANALYTICS -->

        <div class="reports-analytics-grid">

            <div class="smart-card reports-analytics-card">

                <div class="reports-card-header compact">

                    <div>
                        <span class="reports-section-label">
                            APPOINTMENTS
                        </span>

                        <h3>
                            Appointment Trends
                        </h3>
                    </div>

                </div>


                <div class="reports-empty-state">

                    <div class="reports-empty-icon">
                        <i class="bi bi-calendar2-week"></i>
                    </div>

                    <h4>
                        No appointment data available
                    </h4>

                    <p>
                        Appointment trends will appear here once
                        clinic appointment data has been recorded.
                    </p>

                </div>

            </div>


            <div class="smart-card reports-analytics-card">

                <div class="reports-card-header compact">

                    <div>
                        <span class="reports-section-label">
                            FINANCIAL
                        </span>

                        <h3>
                            Revenue Growth
                        </h3>
                    </div>

                </div>


                <div class="reports-empty-state">

                    <div class="reports-empty-icon">
                        <i class="bi bi-cash-stack"></i>
                    </div>

                    <h4>
                        No revenue data available
                    </h4>

                    <p>
                        Revenue information will appear here once
                        financial records are available.
                    </p>

                </div>

            </div>

        </div>


        <!-- DOCTOR UTILISATION -->

        <div class="smart-card reports-table-card">

            <div class="reports-card-header">

                <div>
                    <span class="reports-section-label">
                        STAFF OPERATIONS
                    </span>

                    <h3>
                        Doctor Utilisation Report
                    </h3>

                    <p>
                        Review appointment activity and utilisation across
                        the clinic's medical staff.
                    </p>
                </div>

                <span class="reports-period-label">
                    Monthly Overview
                </span>

            </div>


            <div class="reports-empty-table">

                <div class="reports-empty-icon">
                    <i class="bi bi-person-badge"></i>
                </div>

                <h4>
                    No doctor utilisation data available
                </h4>

                <p>
                    Doctor utilisation information will appear here
                    once appointment activity has been recorded.
                </p>

            </div>

        </div>


        <!-- SUMMARY -->

        <div class="reports-summary-grid">

            <div class="smart-card reports-summary-card">

                <div class="reports-card-header compact">

                    <div>
                        <span class="reports-section-label">
                            ATTENDANCE
                        </span>

                        <h3>
                            Attendance Statistics
                        </h3>
                    </div>

                </div>


                <div class="reports-summary-empty">

                    <div class="reports-summary-row">
                        <span>Appointments Attended</span>
                        <strong>—</strong>
                    </div>

                    <div class="reports-summary-row">
                        <span>Late Arrivals</span>
                        <strong>—</strong>
                    </div>

                    <div class="reports-summary-row">
                        <span>No Shows</span>
                        <strong>—</strong>
                    </div>

                </div>

            </div>


            <div class="smart-card reports-summary-card">

                <div class="reports-card-header compact">

                    <div>
                        <span class="reports-section-label">
                            SYSTEM
                        </span>

                        <h3>
                            System Activity
                        </h3>
                    </div>

                </div>


                <div class="reports-empty-state reports-system-empty">

                    <div class="reports-empty-icon">
                        <i class="bi bi-activity"></i>
                    </div>

                    <h4>
                        No activity available
                    </h4>

                    <p>
                        Report and system activity will appear here
                        when records are available.
                    </p>

                </div>

            </div>

        </div>


        <!-- REPORT ACTIONS -->

        <div class="smart-card reports-actions-card">

            <div class="reports-card-header">

                <div>
                    <span class="reports-section-label">
                        EXPORTS
                    </span>

                    <h3>
                        Report Actions
                    </h3>

                    <p>
                        Select a report to prepare it for export.
                    </p>
                </div>

            </div>


            <div class="reports-actions-grid">

                <button type="button"
                        class="reports-export-button export-report"
                        data-report="Appointment Report">

                    <i class="bi bi-calendar-check"></i>

                    <span>
                        Export Appointment Report
                    </span>

                    <i class="bi bi-arrow-right"></i>

                </button>


                <button type="button"
                        class="reports-export-button export-report"
                        data-report="Revenue Report">

                    <i class="bi bi-cash-stack"></i>

                    <span>
                        Export Revenue Report
                    </span>

                    <i class="bi bi-arrow-right"></i>

                </button>


                <button type="button"
                        class="reports-export-button export-report"
                        data-report="Doctor Utilisation">

                    <i class="bi bi-person-badge"></i>

                    <span>
                        Export Doctor Utilisation
                    </span>

                    <i class="bi bi-arrow-right"></i>

                </button>


                <button type="button"
                        class="reports-export-button"
                        id="downloadSummary">

                    <i class="bi bi-file-earmark-pdf"></i>

                    <span>
                        Download PDF Summary
                    </span>

                    <i class="bi bi-arrow-right"></i>

                </button>

            </div>


            <div id="exportMessage"
                 class="reports-message d-none">
            </div>

        </div>

    </div>


    <style>

            .admin-reports-page {
                padding-top: 8px;
                padding-bottom: 48px;
            }


            /* HEADER */

            .reports-page-header {
                display: flex;
                align-items: flex-end;
                justify-content: space-between;
                gap: 24px;
                margin-bottom: 30px;
            }

            .reports-header-icon {
                display: flex;
                align-items: center;
                justify-content: center;
                flex: 0 0 auto;
                width: 52px;
                height: 52px;
                border-radius: 14px;
                background: #f0fdfa;
                color: var(--primary);
                font-size: 22px;
            }


            /* STATISTICS */

            .reports-stat-grid {
                display: grid;
                grid-template-columns: repeat(4, minmax(0, 1fr));
                gap: 20px;
                margin-bottom: 24px;
            }

            .reports-stat-card {
                display: flex;
                align-items: center;
                gap: 14px;
                padding: 21px;
                border-radius: 17px;
            }

            .reports-stat-icon {
                display: flex;
                align-items: center;
                justify-content: center;
                flex: 0 0 auto;
                width: 44px;
                height: 44px;
                border-radius: 12px;
                background: #f0fdfa;
                color: var(--primary);
                font-size: 18px;
            }

            .reports-stat-card > div:last-child {
                min-width: 0;
            }

            .reports-stat-card span {
                display: block;
                margin-bottom: 2px;
                color: #64748b;
                font-size: 12px;
                font-weight: 700;
            }

            .reports-stat-card strong {
                display: block;
                color: #334155;
                font-size: 24px;
                line-height: 1.2;
            }

            .reports-stat-card small {
                display: block;
                margin-top: 2px;
                color: #94a3b8;
                font-size: 10px;
            }


            /* SHARED CARD HEADERS */

            .reports-card-header {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                gap: 20px;
                padding-bottom: 18px;
                margin-bottom: 20px;
                border-bottom: 1px solid #eef2f7;
            }

                .reports-card-header.compact {
                    margin-bottom: 18px;
                }

            .reports-section-label {
                display: block;
                margin-bottom: 5px;
                color: var(--primary);
                font-size: 10px;
                font-weight: 800;
                letter-spacing: 0.14em;
            }

            .reports-card-header h3 {
                margin: 0;
                color: #111827;
                font-size: 19px;
                font-weight: 700;
                letter-spacing: -0.02em;
            }

            .reports-card-header p {
                max-width: 620px;
                margin: 6px 0 0;
                color: #94a3b8;
                font-size: 12px;
                line-height: 1.5;
            }

            .reports-period-label {
                flex-shrink: 0;
                color: #94a3b8;
                font-size: 12px;
                font-weight: 600;
            }


            /* FILTER */

            .reports-filter-card {
                padding: 26px;
                margin-bottom: 24px;
                border-radius: 18px;
            }

            .reports-period-control {
                width: 210px;
                flex-shrink: 0;
            }

                .reports-period-control label,
                .reports-label {
                    margin-bottom: 7px;
                    color: #334155;
                    font-size: 12px;
                    font-weight: 700;
                }

                .reports-period-control .smart-input {
                    min-height: 44px;
                }

            .reports-date-grid {
                display: grid;
                grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 180px;
                gap: 18px;
                align-items: end;
            }

            .reports-generate-button {
                width: 100%;
                min-height: 46px;
            }

            .reports-message {
                padding: 11px 14px;
                margin-top: 18px;
                border-radius: 10px;
                font-size: 13px;
                line-height: 1.5;
            }

                .reports-message.success {
                    border: 1px solid #bbf7d0;
                    background: #f0fdf4;
                    color: #166534;
                }

                .reports-message.warning {
                    border: 1px solid #fde68a;
                    background: #fffbeb;
                    color: #92400e;
                }


            /* ANALYTICS */

            .reports-analytics-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 24px;
                margin-bottom: 24px;
            }

            .reports-analytics-card {
                padding: 26px;
                border-radius: 18px;
            }

            .reports-empty-state {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 28px 20px;
                border: 1px dashed #dbe4ea;
                border-radius: 14px;
                background: #fafcfd;
                text-align: center;
            }

            .reports-empty-icon {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 46px;
                height: 46px;
                margin-bottom: 12px;
                border-radius: 12px;
                background: #f0fdfa;
                color: var(--primary);
                font-size: 18px;
            }

            .reports-empty-state h4,
            .reports-empty-table h4 {
                margin: 0 0 5px;
                color: #334155;
                font-size: 14px;
                font-weight: 700;
            }

            .reports-empty-state p,
            .reports-empty-table p {
                max-width: 440px;
                margin: 0;
                color: #94a3b8;
                font-size: 12px;
                line-height: 1.6;
            }


            /* TABLE */

            .reports-table-card {
                padding: 26px;
                margin-bottom: 24px;
                border-radius: 18px;
            }

            .reports-empty-table {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 34px 20px;
                border: 1px dashed #dbe4ea;
                border-radius: 14px;
                background: #fafcfd;
                text-align: center;
            }


            /* SUMMARY */

            .reports-summary-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 24px;
                margin-bottom: 24px;
            }

            .reports-summary-card {
                padding: 26px;
                border-radius: 18px;
            }

            .reports-summary-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 20px;
                padding: 13px 0;
                border-bottom: 1px solid #eef2f7;
                color: #64748b;
                font-size: 13px;
            }

                .reports-summary-row:last-child {
                    border-bottom: 0;
                }

                .reports-summary-row strong {
                    color: #334155;
                    font-size: 16px;
                }

            .reports-system-empty {
                padding-top: 22px;
                padding-bottom: 22px;
            }


            /* ACTIONS */

            .reports-actions-card {
                padding: 26px;
                border-radius: 18px;
            }

            .reports-actions-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 12px;
            }

            .reports-export-button {
                display: flex;
                align-items: center;
                gap: 12px;
                width: 100%;
                min-width: 0;
                padding: 14px 16px;
                border: 1px solid #e2e8f0;
                border-radius: 12px;
                background: #ffffff;
                color: #334155;
                text-align: left;
                font-size: 13px;
                font-weight: 700;
                cursor: pointer;
                transition: all 0.2s ease;
            }

                .reports-export-button > i:first-child {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    flex: 0 0 auto;
                    width: 34px;
                    height: 34px;
                    border-radius: 9px;
                    background: #f0fdfa;
                    color: var(--primary);
                    font-size: 15px;
                }

                .reports-export-button span {
                    min-width: 0;
                }

                .reports-export-button > i:last-child {
                    margin-left: auto;
                    color: #cbd5e1;
                    transition: transform 0.2s ease, color 0.2s ease;
                }

                .reports-export-button:hover {
                    border-color: rgba(15, 118, 110, 0.2);
                    background: #f8fffe;
                    color: #1f2937;
                    transform: translateY(-1px);
                    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.05);
                }

                    .reports-export-button:hover > i:last-child {
                        color: var(--primary);
                        transform: translateX(2px);
                    }


            /* RESPONSIVE */

            @@media (max-width: 1100px) {

                .reports-stat-grid {
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                }

                .reports-date-grid {
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                }

                .reports-generate-wrapper {
                    grid-column: 1 / -1;
                }

                .reports-generate-button {
                    width: 220px;
                }
            }


            @@media (max-width: 767.98px) {

                .admin-reports-page {
                    padding-bottom: 32px;
                }

                .reports-page-header {
                    display: block;
                    margin-bottom: 24px;
                }

                .reports-header-icon {
                    margin-top: 18px;
                }

                .reports-stat-grid,
                .reports-analytics-grid,
                .reports-summary-grid,
                .reports-actions-grid {
                    grid-template-columns: 1fr;
                }

                .reports-filter-card,
                .reports-analytics-card,
                .reports-table-card,
                .reports-summary-card,
                .reports-actions-card {
                    padding: 21px;
                }

                .reports-card-header {
                    display: block;
                }

                .reports-period-control {
                    width: 100%;
                    margin-top: 16px;
                }

                .reports-date-grid {
                    grid-template-columns: 1fr;
                }

                .reports-generate-wrapper {
                    grid-column: auto;
                }

                .reports-generate-button {
                    width: 100%;
                }

                .reports-period-label {
                    display: block;
                    margin-top: 8px;
                }
            }


            @@media (max-width: 575.98px) {

                .reports-stat-card {
                    padding: 18px;
                }

                .reports-empty-state,
                .reports-empty-table {
                    padding: 24px 16px;
                }
            }

    </style>


    <script>

            const generateButton = document.getElementById("generateReport");
            const reportMessage = document.getElementById("reportMessage");

            if (generateButton) {

                generateButton.addEventListener("click", function () {

                    const from = document.getElementById("dateFrom").value;
                    const to = document.getElementById("dateTo").value;

                    if (!from || !to) {

                        reportMessage.className = "reports-message warning";
                        reportMessage.textContent =
                            "Please select both a start and end date.";

                        return;
                    }

                    if (from > to) {

                        reportMessage.className = "reports-message warning";
                        reportMessage.textContent =
                            "The start date cannot be after the end date.";

                        return;
                    }

                    reportMessage.className = "reports-message success";
                    reportMessage.textContent =
                        "Report generated successfully.";

                });

            }


            document.querySelectorAll(".export-report").forEach(button => {

                button.addEventListener("click", function () {

                    const message = document.getElementById("exportMessage");

                    message.className = "reports-message success";
                    message.textContent =
                        this.dataset.report + " prepared for export.";

                });

            });


            const downloadButton = document.getElementById("downloadSummary");

            if (downloadButton) {

                downloadButton.addEventListener("click", function () {

                    const message = document.getElementById("exportMessage");

                    message.className = "reports-message success";
                    message.textContent =
                        "PDF summary prepared successfully.";

                });

            }

    </script>

</section>