@{
    ViewData["Title"] = "Admin Dashboard";
}

<section class="admin-dashboard-page">

    <div class="container-fluid py-4 py-lg-5">

        <!-- Header -->
        <div class="dashboard-header mb-4 mb-lg-5">

            <div>

                <div class="dashboard-eyebrow mb-2">
                    <i class="bi bi-shield-lock me-2" aria-hidden="true"></i>
                    Clinic Administration
                </div>

                <h1 class="display-6 fw-bold mb-2">
                    Administration Dashboard
                </h1>

                <p class="text-muted mb-0">
                    Manage clinic operations, users, appointments and reporting
                    from one central workspace.
                </p>

            </div>

            <a asp-controller="Admin"
                   asp-action="Reports"
                   class="btn btn-primary btn-lg">

                <i class="bi bi-bar-chart-line me-2" aria-hidden="true"></i>
                View Reports

            </a>

        </div>


        <!-- Administration Overview -->
        <section class="mb-4 mb-lg-5"
                 aria-labelledby="admin-overview-heading">

            <div class="mb-3">

                <h2 id="admin-overview-heading" class="h5 fw-bold mb-1">
                    Administration Overview
                </h2>

                <p class="text-muted small mb-0">
                    Current clinic management areas and reporting availability.
                </p>

            </div>


            <div class="row g-3 g-lg-4">

                <div class="col-12 col-sm-6 col-xl-3">

                    <div class="overview-card h-100">

                        <div class="overview-content">

                            <span class="overview-label">
                                Patients
                            </span>

                            <strong class="overview-value">
                                —
                            </strong>

                            <span class="overview-description">
                                Patient account information
                            </span>

                        </div>

                        <div class="overview-icon">
                            <i class="bi bi-people" aria-hidden="true"></i>
                        </div>

                    </div>

                </div>


                <div class="col-12 col-sm-6 col-xl-3">

                    <div class="overview-card h-100">

                        <div class="overview-content">

                            <span class="overview-label">
                                Doctors
                            </span>

                            <strong class="overview-value">
                                —
                            </strong>

                            <span class="overview-description">
                                Clinical staff information
                            </span>

                        </div>

                        <div class="overview-icon">
                            <i class="bi bi-person-badge" aria-hidden="true"></i>
                        </div>

                    </div>

                </div>


                <div class="col-12 col-sm-6 col-xl-3">

                    <div class="overview-card h-100">

                        <div class="overview-content">

                            <span class="overview-label">
                                Appointments
                            </span>

                            <strong class="overview-value">
                                —
                            </strong>

                            <span class="overview-description">
                                Clinic scheduling information
                            </span>

                        </div>

                        <div class="overview-icon">
                            <i class="bi bi-calendar-check" aria-hidden="true"></i>
                        </div>

                    </div>

                </div>


                <div class="col-12 col-sm-6 col-xl-3">

                    <div class="overview-card h-100">

                        <div class="overview-content">

                            <span class="overview-label">
                                Attendance
                            </span>

                            <strong class="overview-value">
                                —
                            </strong>

                            <span class="overview-description">
                                Clinic attendance information
                            </span>

                        </div>

                        <div class="overview-icon">
                            <i class="bi bi-graph-up-arrow" aria-hidden="true"></i>
                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- Main Workspace -->
        <div class="row g-4">

            <!-- Administration Workflows -->
            <div class="col-12 col-xl-8">

                <section class="workspace-panel h-100"
                         aria-labelledby="admin-workflow-heading">

                    <div class="workspace-panel-header">

                        <h2 id="admin-workflow-heading" class="h5 fw-bold mb-1">
                            Administration Workflows
                        </h2>

                        <p class="text-muted small mb-0">
                            Access the core clinic management functions.
                        </p>

                    </div>


                    <div class="workflow-list">

                        <a asp-controller="Admin"
                               asp-action="UserManagement"
                               class="workflow-item">

                            <div class="workflow-icon">
                                <i class="bi bi-people-fill" aria-hidden="true"></i>
                            </div>

                            <div class="workflow-content">

                                <h3 class="h6 fw-bold mb-1">
                                    Manage Users
                                </h3>

                                <p class="text-muted small mb-0">
                                    Manage patient and staff accounts and account status.
                                </p>

                            </div>

                            <i class="bi bi-arrow-right workflow-arrow"
                               aria-hidden="true"></i>

                        </a>


                        <a href="#doctorUtilisation"
                               class="workflow-item">

                            <div class="workflow-icon">
                                <i class="bi bi-calendar-week" aria-hidden="true"></i>
                            </div>

                            <div class="workflow-content">

                                <h3 class="h6 fw-bold mb-1">
                                    Schedules
                                </h3>

                                <p class="text-muted small mb-0">
                                    Review doctor availability and clinic scheduling activity.
                                </p>

                            </div>

                            <i class="bi bi-arrow-right workflow-arrow"
                               aria-hidden="true"></i>

                        </a>


                        <a href="#clinicServices"
                               class="workflow-item">

                            <div class="workflow-icon">
                                <i class="bi bi-hospital" aria-hidden="true"></i>
                            </div>

                            <div class="workflow-content">

                                <h3 class="h6 fw-bold mb-1">
                                    Clinic Services
                                </h3>

                                <p class="text-muted small mb-0">
                                    Review the medical services available through the clinic.
                                </p>

                            </div>

                            <i class="bi bi-arrow-right workflow-arrow"
                               aria-hidden="true"></i>

                        </a>


                        <a asp-controller="Admin"
                               asp-action="Reports"
                               class="workflow-item">

                            <div class="workflow-icon">
                                <i class="bi bi-bar-chart-line" aria-hidden="true"></i>
                            </div>

                            <div class="workflow-content">

                                <h3 class="h6 fw-bold mb-1">
                                    Reports
                                </h3>

                                <p class="text-muted small mb-0">
                                    View clinic reporting and operational information.
                                </p>

                            </div>

                            <i class="bi bi-arrow-right workflow-arrow"
                               aria-hidden="true"></i>

                        </a>

                    </div>

                </section>

            </div>


            <!-- System Status -->
            <div class="col-12 col-xl-4">

                <div class="d-flex flex-column gap-4">

                    <section class="status-card"
                             aria-labelledby="system-status-heading">

                        <div class="status-card-header">

                            <div class="status-icon">
                                <i class="bi bi-activity" aria-hidden="true"></i>
                            </div>

                            <div>

                                <h2 id="system-status-heading"
                                    class="h6 fw-bold mb-1">
                                    System Status
                                </h2>

                                <p class="text-muted small mb-0">
                                    Current administrative system information.
                                </p>

                            </div>

                        </div>

                        <div class="security-note">
                            <i class="bi bi-shield-check me-2"
                               aria-hidden="true"></i>
                            Administrative workspace secured
                        </div>

                    </section>


                    <section class="status-card"
                             aria-labelledby="activity-status-heading">

                        <div class="mb-3">

                            <h2 id="activity-status-heading"
                                class="h6 fw-bold mb-1">
                                Recent Activity
                            </h2>

                            <p class="text-muted small mb-0">
                                Administrative activity information.
                            </p>

                        </div>


                        <div class="status-empty">

                            <div class="status-empty-icon">
                                <i class="bi bi-clock-history"
                                   aria-hidden="true"></i>
                            </div>

                            <h3 class="h6 fw-bold mb-1">
                                No recent activity
                            </h3>

                            <p class="text-muted small mb-0">
                                Recent clinic and administrative activity
                                will appear here when available.
                            </p>

                        </div>

                    </section>

                </div>

            </div>

        </div>


        <!-- Detailed Administration Information -->
        <div class="row g-4 mt-1">

            <div class="col-12 col-xl-8">

                <section class="workspace-panel"
                         id="doctorUtilisation"
                         aria-labelledby="doctor-utilisation-heading">

                    <div class="workspace-panel-header">

                        <div class="d-flex flex-column flex-sm-row justify-content-between gap-2">

                            <div>

                                <span class="section-label">
                                    STAFF OPERATIONS
                                </span>

                                <h2 id="doctor-utilisation-heading"
                                    class="h5 fw-bold mb-1">
                                    Doctor Utilisation Overview
                                </h2>

                                <p class="text-muted small mb-0">
                                    Current doctor appointment and utilisation information.
                                </p>

                            </div>

                            <span class="section-period">
                                Current Month
                            </span>

                        </div>

                    </div>


                    <div class="empty-state">

                        <div class="empty-icon">
                            <i class="bi bi-bar-chart" aria-hidden="true"></i>
                        </div>

                        <h3 class="h6 fw-bold mb-1">
                            No utilisation data available
                        </h3>

                        <p class="text-muted small mb-0">
                            Doctor appointment and utilisation information will appear
                            here once clinic activity has been recorded.
                        </p>

                    </div>

                </section>

            </div>


            <div class="col-12 col-xl-4">

                <section class="workspace-panel h-100"
                         id="clinicServices"
                         aria-labelledby="clinic-services-heading">

                    <div class="workspace-panel-header">

                        <span class="section-label">
                            CLINIC CONFIGURATION
                        </span>

                        <h2 id="clinic-services-heading"
                            class="h5 fw-bold mb-1">
                            Clinic Services
                        </h2>

                        <p class="text-muted small mb-0">
                            Available clinic service information.
                        </p>

                    </div>


                    <div class="empty-state compact">

                        <div class="empty-icon">
                            <i class="bi bi-hospital" aria-hidden="true"></i>
                        </div>

                        <h3 class="h6 fw-bold mb-1">
                            No service information available
                        </h3>

                        <p class="text-muted small mb-0">
                            Configured clinic services will appear here
                            when service data is available.
                        </p>

                    </div>

                </section>

            </div>

        </div>

    </div>

</section>


<style>
    .admin-dashboard-page {
        min-height: calc(100vh - 70px);
        background: #f7fbff;
    }

    .dashboard-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        padding: 1.75rem 2rem;
        background: linear-gradient(135deg, #e7f5ff 0%, #f5fbff 100%);
        border: 1px solid #d5ebf9;
        border-radius: 1.25rem;
        box-shadow: 0 0.35rem 1.25rem rgba(31, 91, 122, 0.06);
    }

    .dashboard-eyebrow {
        display: inline-flex;
        align-items: center;
        color: #0b6fa4;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .overview-card {
        position: relative;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        min-height: 165px;
        padding: 1.5rem;
        overflow: hidden;
        background: linear-gradient(135deg, #e4f4ff 0%, #f4faff 100%);
        border: 1px solid #cfe7f6;
        border-radius: 1.15rem;
        box-shadow: 0 0.35rem 1.25rem rgba(31, 91, 122, 0.07);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .overview-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.7rem 1.5rem rgba(31, 91, 122, 0.11);
        }

    .overview-content {
        display: flex;
        flex-direction: column;
    }

    .overview-label {
        color: #526b7a;
        font-size: 0.85rem;
        font-weight: 700;
    }

    .overview-value {
        margin-top: 0.4rem;
        color: #123b53;
        font-size: 2.4rem;
        line-height: 1.1;
        font-weight: 800;
    }

    .overview-description {
        margin-top: 0.55rem;
        color: #66808f;
        font-size: 0.78rem;
    }

    .overview-icon,
    .workflow-icon,
    .status-icon,
    .empty-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        color: #1479ad;
        background: #e7f5ff;
        border: 1px solid #d2ebf9;
    }

    .overview-icon {
        width: 58px;
        height: 58px;
        border-radius: 50%;
        font-size: 1.4rem;
    }

    .workspace-panel,
    .status-card {
        background: #ffffff;
        border: 1px solid #dfedf5;
        border-radius: 1.15rem;
        box-shadow: 0 0.35rem 1.25rem rgba(31, 91, 122, 0.06);
    }

    .workspace-panel-header {
        padding: 1.5rem;
        border-bottom: 1px solid #eaf2f6;
    }

    .workflow-list {
        padding: 0.5rem 1rem 1rem;
    }

    .workflow-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.15rem 0.75rem;
        color: inherit;
        text-decoration: none;
        border-bottom: 1px solid #eaf2f6;
        border-radius: 0.75rem;
        transition: background-color 0.2s ease, padding-left 0.2s ease;
    }

        .workflow-item:last-child {
            border-bottom: 0;
        }

        .workflow-item:hover {
            padding-left: 1rem;
            background: #eef8ff;
        }

        .workflow-item:focus-visible {
            outline: 3px solid rgba(13, 110, 253, 0.2);
            outline-offset: 2px;
        }

    .workflow-icon {
        width: 48px;
        height: 48px;
        border-radius: 0.8rem;
        font-size: 1.2rem;
    }

    .workflow-content {
        flex: 1;
        min-width: 0;
    }

    .workflow-arrow {
        color: #7d9aaa;
        font-size: 1rem;
        transition: transform 0.2s ease, color 0.2s ease;
    }

    .workflow-item:hover .workflow-arrow {
        color: #0d6efd;
        transform: translateX(3px);
    }

    .status-card {
        padding: 1.5rem;
    }

    .status-card-header {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
    }

    .status-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        font-size: 1.15rem;
    }

    .security-note {
        margin-top: 1.25rem;
        padding: 0.8rem 1rem;
        color: #176b4d;
        background: #edf9f4;
        border: 1px solid #d4eee2;
        border-radius: 0.7rem;
        font-size: 0.82rem;
        font-weight: 600;
    }

    .status-empty {
        padding: 1rem 0 0;
        text-align: center;
    }

    .status-empty-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        margin: 0 auto 0.85rem;
        color: #1479ad;
        background: #e7f5ff;
        border: 1px solid #d2ebf9;
        border-radius: 50%;
        font-size: 1.15rem;
    }

    .section-label {
        display: block;
        margin-bottom: 5px;
        color: #0b6fa4;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.14em;
    }

    .section-period {
        color: #7d929e;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 220px;
        padding: 2rem;
        text-align: center;
    }

        .empty-state.compact {
            min-height: 245px;
        }

    .empty-icon {
        width: 52px;
        height: 52px;
        margin-bottom: 1rem;
        border-radius: 50%;
        font-size: 1.2rem;
    }

    .empty-state p {
        max-width: 500px;
    }
</style>