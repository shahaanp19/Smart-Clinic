```cshtml
@{
    ViewData["Title"] = "Admin Login";
}

<section class="login-section">
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-75">
            <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">

                <div class="smart-card login-card">

                    <div class="text-center login-header">
                        <div class="login-icon-wrapper">
                            <i class="bi bi-shield-lock login-icon"></i>
                        </div>

                        <h1 class="login-title">
                            Admin Login
                        </h1>

                        <p class="login-subtitle">
                            Sign in to the administration portal.
                        </p>
                    </div>

                    <form id="adminLoginForm" class="login-form">

                        <div class="login-field">
                            <label for="adminEmail" class="form-label smart-label">
                                Email Address
                            </label>

                            <div class="login-input-wrapper">
                                <i class="bi bi-envelope login-input-icon"></i>

                                <input id="adminEmail"
                                       name="email"
                                       type="email"
                                       class="form-control smart-input login-input"
                                       value="admin@smartclinic.co.za"
                                       readonly />
                            </div>
                        </div>

                        <div class="login-field">
                            <label for="adminPassword" class="form-label smart-label">
                                Password
                            </label>

                            <div class="login-input-wrapper">
                                <i class="bi bi-lock login-input-icon"></i>

                                <input id="adminPassword"
                                       name="password"
                                       type="password"
                                       class="form-control smart-input login-input"
                                       value="password123"
                                       readonly />
                            </div>
                        </div>

                        <div id="loginError"
                             class="alert alert-danger login-error d-none"
                             role="alert">
                            Invalid administrator credentials.
                        </div>

                        <div class="d-grid login-action">
                            <button type="submit"
                                    class="smart-btn-primary login-button">
                                Login
                            </button>
                        </div>

                    </form>

                    <div class="prototype-login-details">
                        <div class="prototype-login-title">
                            <i class="bi bi-info-circle me-2"></i>
                            Prototype Login
                        </div>

                        <div class="prototype-login-row">
                            <span>Email</span>
                            <strong>admin@smartclinic.co.za</strong>
                        </div>

                        <div class="prototype-login-row">
                            <span>Password</span>
                            <strong>password123</strong>
                        </div>
                    </div>

                    <div class="login-footer text-center">
                        <span>
                            Smart Clinic Administration Portal
                        </span>
                    </div>

                </div>

            </div>
        </div>
    </div>
</section>

<script>
    document.getElementById("adminLoginForm")
        .addEventListener("submit", function (event) {

            event.preventDefault();

            const email = document
                .getElementById("adminEmail")
                .value
                .trim();

            const password = document
                .getElementById("adminPassword")
                .value;

            const error = document
                .getElementById("loginError");

            if (
                email === "admin@smartclinic.co.za" &&
                password === "password123"
            ) {
                window.location.href =
                    '@Url.Action("Dashboard", "Admin")';
            } else {
                error.classList.remove("d-none");
            }
        });
</script>
```
