@{
    ViewData["Title"] = "User Management";

    var users = ViewBag.Users as IEnumerable<SmartClinicManagementSystem.Models.ViewModels.UserManagementViewModel>
        ?? Enumerable.Empty<SmartClinicManagementSystem.Models.ViewModels.UserManagementViewModel>();
}

<section class="page-section">
    <div class="container">

        <div class="mb-4">
            <span class="smart-badge">Clinic Administrator</span>

            <h1 class="dashboard-title mt-3">
                User Management
            </h1>

            <p class="text-muted mb-0">
                Manage patients, doctors and reception staff within the clinic system.
            </p>
        </div>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>
                @successMessage

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>
                @errorMessage

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>
            </div>
        }

        <div class="row g-4 mb-4">

            <div class="col-md-4">
                <div class="smart-card stat-panel">
                    <i class="bi bi-people"></i>
                    <h3>
                        @users.Count(u =>
                            string.Equals(
                                u.Role,
                                "Patient",
                                StringComparison.OrdinalIgnoreCase))
                    </h3>
                    <p class="mb-0">Registered Patients</p>
                    <small>Active system accounts</small>
                </div>
            </div>

            <div class="col-md-4">
                <div class="smart-card stat-panel">
                    <i class="bi bi-heart-pulse"></i>
                    <h3>
                        @users.Count(u =>
                            string.Equals(
                                u.Role,
                                "Doctor",
                                StringComparison.OrdinalIgnoreCase))
                    </h3>
                    <p class="mb-0">Active Doctors</p>
                    <small>Active system accounts</small>
                </div>
            </div>

            <div class="col-md-4">
                <div class="smart-card stat-panel">
                    <i class="bi bi-headset"></i>
                    <h3>
                        @users.Count(u =>
                            string.Equals(
                                u.Role,
                                "Receptionist",
                                StringComparison.OrdinalIgnoreCase))
                    </h3>
                    <p class="mb-0">Reception Staff</p>
                    <small>Active system accounts</small>
                </div>
            </div>

        </div>

        <div class="smart-card mb-4 user-filters-card">

            <div class="section-header mb-3">
                <div>
                    <h4 class="mb-1">Find Users</h4>
                    <p class="text-muted mb-0">
                        Search and filter existing clinic accounts.
                    </p>
                </div>
            </div>

            <div class="row g-3">

                <div class="col-md-6">
                    <label for="userSearch" class="form-label">Search</label>
                    <input id="userSearch"
                           type="text"
                           class="form-control smart-input"
                           placeholder="Search by name or email..."
                           autocomplete="off" />
                </div>

                <div class="col-md-3">
                    <label for="roleFilter" class="form-label">Role</label>

                    <select id="roleFilter"
                            class="form-select smart-input">

                        <option value="">All Roles</option>
                        <option value="Patient">Patient</option>
                        <option value="Doctor">Doctor</option>
                        <option value="Receptionist">Receptionist</option>
                        <option value="Administrator">Administrator</option>

                    </select>
                </div>

                <div class="col-md-3 d-flex align-items-end">
                    <button type="button"
                            id="clearFilters"
                            class="btn btn-outline-secondary w-100">

                        <i class="bi bi-arrow-counterclockwise me-2"></i>
                        Clear Filters

                    </button>
                </div>

            </div>

        </div>

        <div class="smart-card">

            <div class="section-header mb-4">

                <div>
                    <h4 class="mb-1">System Users</h4>

                    <p class="text-muted mb-0">
                        Manage existing clinic accounts.
                    </p>
                </div>

                <button type="button"
                        class="smart-btn-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#addUserModal">

                    <i class="bi bi-person-plus me-2"></i>
                    Add User

                </button>

            </div>

            @if (users.Any())
            {
                <div class="table-responsive">

                    <table class="table align-middle mb-0"
                           id="usersTable">

                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var user in users)
                            {
                                <tr class="user-row"
                                    data-name="@user.FullName"
                                    data-email="@user.Email"
                                    data-role="@user.Role">

                                    <td>
                                        <strong>@user.FullName</strong>
                                    </td>

                                    <td>
                                        @user.Email
                                    </td>

                                    <td>
                                        <span class="badge bg-light text-dark">
                                            @user.Role
                                        </span>
                                    </td>

                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge text-bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary">
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @user.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")
                                    </td>

                                    <td class="text-end">

                                        <form asp-controller="Admin"
                                              asp-action="ToggleUserStatus"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@user.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-secondary">

                                                @(user.IsActive ? "Deactivate" : "Activate")

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <div id="noFilteredUsers"
                     class="user-empty-state d-none">

                    <div class="user-empty-icon">
                        <i class="bi bi-search"></i>
                    </div>

                    <h5>No matching users</h5>

                    <p>
                        No users match the current search or role filter.
                    </p>

                </div>
            }
            else
            {
                <div class="user-empty-state">

                    <div class="user-empty-icon">
                        <i class="bi bi-people"></i>
                    </div>

                    <h5>No users available</h5>

                    <p>
                        There are currently no user records to display.
                        Add a user when you are ready to create a clinic account.
                    </p>

                    <button type="button"
                            class="smart-btn-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#addUserModal">

                        <i class="bi bi-person-plus me-2"></i>
                        Add First User

                    </button>

                </div>
            }

        </div>

    </div>
</section>

<div class="modal fade"
     id="addUserModal"
     tabindex="-1"
     aria-labelledby="addUserModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <div>
                    <h5 class="modal-title"
                        id="addUserModalLabel">

                        Add User

                    </h5>

                    <p class="text-muted small mb-0">
                        Create a new clinic system user.
                    </p>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>

            </div>

            <form asp-controller="Admin"
                  asp-action="CreateUser"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label for="firstName"
                                   class="form-label">

                                First Name

                            </label>

                            <input id="firstName"
                                   name="firstName"
                                   type="text"
                                   class="form-control"
                                   autocomplete="given-name"
                                   required />

                        </div>

                        <div class="col-md-6">

                            <label for="lastName"
                                   class="form-label">

                                Last Name

                            </label>

                            <input id="lastName"
                                   name="lastName"
                                   type="text"
                                   class="form-control"
                                   autocomplete="family-name"
                                   required />

                        </div>

                    </div>

                    <div class="mt-3">

                        <label for="email"
                               class="form-label">

                            Email / Username

                        </label>

                        <input id="email"
                               name="email"
                               type="email"
                               class="form-control"
                               autocomplete="email"
                               required />

                        <div class="form-text">
                            This email address will be used to log in.
                        </div>

                    </div>

                    <div class="mt-3">

                        <label for="password"
                               class="form-label">

                            Password

                        </label>

                        <input id="password"
                               name="password"
                               type="password"
                               class="form-control"
                               minlength="8"
                               autocomplete="new-password"
                               required />

                        <div class="form-text">
                            Minimum 8 characters.
                        </div>

                    </div>

                    <div class="mt-3">

                        <label for="role"
                               class="form-label">

                            Role

                        </label>

                        <select id="role"
                                name="role"
                                class="form-select"
                                required>

                            <option value="">
                                Select role
                            </option>

                            <option value="Patient">
                                Patient
                            </option>

                            <option value="Doctor">
                                Doctor
                            </option>

                            <option value="Receptionist">
                                Receptionist
                            </option>

                            <option value="Administrator">
                                Administrator
                            </option>

                        </select>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="smart-btn-primary">

                        <i class="bi bi-person-plus me-2"></i>
                        Create User

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<style>
    .user-filters-card {
        padding: 1.5rem;
    }

    .user-empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 2.5rem 1.5rem;
        border: 1px dashed #d5dde5;
        border-radius: 16px;
        background: #fafcfd;
    }

    .user-empty-icon {
        width: 64px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        background: #e7f5f3;
        color: #0f766e;
        font-size: 1.7rem;
        margin-bottom: 1rem;
    }

    .user-empty-state h5 {
        margin-bottom: 0.5rem;
        color: #243447;
    }

    .user-empty-state p {
        max-width: 520px;
        margin: 0 auto 1.25rem;
        color: #6c757d;
        line-height: 1.6;
    }

    .stat-panel {
        height: auto;
    }

        .stat-panel small {
            display: block;
            margin-top: 0.35rem;
            color: #7a8793;
            font-size: 0.82rem;
        }

    .modal-content {
        border: 0;
        border-radius: 18px;
        box-shadow: 0 18px 50px rgba(15, 23, 42, 0.16);
    }

    .modal-header,
    .modal-footer {
        border-color: #edf1f4;
    }

    .modal-header {
        padding: 1.25rem 1.5rem;
    }

    .modal-body {
        padding: 1.5rem;
    }

    .modal-footer {
        padding: 1rem 1.5rem;
    }

    #usersTable th {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        white-space: nowrap;
    }

    #usersTable td {
        color: #334155;
    }

    @@media (max-width: 767.98px) {

        .user-filters-card {
            padding: 1.25rem;
        }

        .section-header {
            gap: 1rem;
            align-items: flex-start;
        }

            .section-header .smart-btn-primary {
                width: 100%;
            }

        .user-empty-state {
            padding: 2rem 1rem;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const searchInput =
            document.getElementById("userSearch");

        const roleFilter =
            document.getElementById("roleFilter");

        const clearFilters =
            document.getElementById("clearFilters");

        const rows =
            Array.from(document.querySelectorAll(".user-row"));

        const noFilteredUsers =
            document.getElementById("noFilteredUsers");

        function applyFilters() {

            if (!rows.length) {
                return;
            }

            const search =
                (searchInput?.value || "")
                    .trim()
                    .toLowerCase();

            const role =
                (roleFilter?.value || "")
                    .trim()
                    .toLowerCase();

            let visibleCount = 0;

            rows.forEach(function (row) {

                const name =
                    (row.dataset.name || "")
                        .toLowerCase();

                const email =
                    (row.dataset.email || "")
                        .toLowerCase();

                const rowRole =
                    (row.dataset.role || "")
                        .toLowerCase();

                const matchesSearch =
                    !search ||
                    name.includes(search) ||
                    email.includes(search);

                const matchesRole =
                    !role ||
                    rowRole === role;

                const visible =
                    matchesSearch &&
                    matchesRole;

                row.classList.toggle(
                    "d-none",
                    !visible);

                if (visible) {
                    visibleCount++;
                }
            });

            if (noFilteredUsers) {
                noFilteredUsers.classList.toggle(
                    "d-none",
                    visibleCount !== 0);
            }
        }

        if (searchInput) {
            searchInput.addEventListener(
                "input",
                applyFilters);
        }

        if (roleFilter) {
            roleFilter.addEventListener(
                "change",
                applyFilters);
        }

        if (clearFilters) {
            clearFilters.addEventListener(
                "click",
                function () {

                    if (searchInput) {
                        searchInput.value = "";
                    }

                    if (roleFilter) {
                        roleFilter.value = "";
                    }

                    applyFilters();
                });
        }

    });
</script>

