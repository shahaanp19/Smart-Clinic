@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    bool IsActive(string controller, string? action = null)
    {
        if (!string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return action == null ||
               string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description"
          content="Doringkloof Medical Centre Smart Clinic Management System" />

    <meta name="theme-color" content="#0F4C81" />

    <title>
        @ViewData["Title"] - Doringkloof Medical Centre
    </title>

    <link rel="icon"
          type="image/png"
          href="~/images/Logo.png"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <!-- Accessibility: keyboard users can bypass navigation -->
    <a class="skip-link"
           href="#main-content">
        Skip to main content
    </a>

    <header class="site-header">
        <nav class="navbar navbar-expand-lg smart-navbar"
             aria-label="Primary navigation">

            <div class="container">

                <!-- Brand -->
                <a class="navbar-brand clinic-brand d-flex align-items-center"
                       asp-controller="Home"
                       asp-action="Index"
                       aria-label="Doringkloof Medical Centre home">

                    <img src="~/images/Logo.png"
                         alt=""
                         class="clinic-logo"
                         width="70"
                         height="70" />

                    <span class="clinic-brand-copy">
                        <span class="clinic-brand-title">
                            Doringkloof Medical Centre
                        </span>

                        <span class="clinic-brand-subtitle">
                            Smart Clinic Management System
                        </span>
                    </span>

                </a>

                <!-- Mobile navigation toggle -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <li class="nav-item">
                            <a class="nav-link @(IsActive("Home", "Index") ? "active" : "")"
                                   asp-controller="Home"
                                   asp-action="Index"
                                   aria-current="@(IsActive("Home", "Index") ? "page" : null)">
                                <i class="bi bi-house-door me-1"
                                   aria-hidden="true"></i>
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(IsActive("Home", "About") ? "active" : "")"
                                   asp-controller="Home"
                                   asp-action="About"
                                   aria-current="@(IsActive("Home", "About") ? "page" : null)">
                                About Us
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(IsActive("Home", "MedicalDivisions") ? "active" : "")"
                                   asp-controller="Home"
                                   asp-action="MedicalDivisions"
                                   aria-current="@(IsActive("Home", "MedicalDivisions") ? "page" : null)">
                                Medical Divisions
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(IsActive("Home", "Contact") ? "active" : "")"
                                   asp-controller="Home"
                                   asp-action="Contact"
                                   aria-current="@(IsActive("Home", "Contact") ? "page" : null)">
                                Contact Us
                            </a>
                        </li>

                        <!-- Portal navigation -->
                        <li class="nav-item dropdown ms-lg-3 mt-3 mt-lg-0">

                            <button class="btn smart-login-btn dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">

                                <i class="bi bi-person-circle me-1"
                                   aria-hidden="true"></i>

                                Portal Login

                            </button>

                            <ul class="dropdown-menu dropdown-menu-end portal-dropdown">

                                <li>
                                    <h6 class="dropdown-header">
                                        Select your portal
                                    </h6>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                           asp-controller="Patient"
                                           asp-action="Login">

                                        <i class="bi bi-person-heart"
                                           aria-hidden="true"></i>

                                        <span>
                                            <strong>Patient Portal</strong>
                                            <small>Appointments & medical information</small>
                                        </span>

                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                           asp-controller="Doctor"
                                           asp-action="Login">

                                        <i class="bi bi-person-badge"
                                           aria-hidden="true"></i>

                                        <span>
                                            <strong>Doctor Login</strong>
                                            <small>Clinical management</small>
                                        </span>

                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                           asp-controller="Reception"
                                           asp-action="Login">

                                        <i class="bi bi-headset"
                                           aria-hidden="true"></i>

                                        <span>
                                            <strong>Reception</strong>
                                            <small>Front-desk management</small>
                                        </span>

                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                           asp-controller="Admin"
                                           asp-action="Login">

                                        <i class="bi bi-shield-lock"
                                           aria-hidden="true"></i>

                                        <span>
                                            <strong>Administrator</strong>
                                            <small>System administration</small>
                                        </span>

                                    </a>
                                </li>

                            </ul>

                        </li>

                    </ul>

                </div>

            </div>
        </nav>
    </header>


    <!-- Main application content -->
    <main id="main-content"
          role="main"
          tabindex="-1">

        @RenderBody()

    </main>


    <!-- Global footer -->
    <footer class="smart-footer">

        <div class="container">

            <div class="row align-items-center g-4">

                <div class="col-lg-6">

                    <div class="footer-brand">

                        <div class="footer-brand-title">
                            Doringkloof Medical Centre
                        </div>

                        <p class="footer-tagline mb-0">
                            Smart healthcare management for a better patient experience.
                        </p>

                    </div>

                </div>

                <div class="col-lg-6 text-lg-end">

                    <div class="footer-links mb-2">

                        <a asp-controller="Home"
                               asp-action="Privacy">
                            Privacy
                        </a>

                        <span aria-hidden="true">•</span>

                        <a asp-controller="Home"
                               asp-action="Contact">
                            Contact
                        </a>

                    </div>

                    <p class="footer-copyright mb-0">
                        © @DateTime.Now.Year Doringkloof Medical Centre.
                        All rights reserved.
                    </p>

                </div>

            </div>

        </div>

    </footer>


    <!-- Bootstrap JavaScript -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"
            asp-append-version="true"></script>

    <!-- Application JavaScript -->
    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>