@{
    ViewData["Title"] = "Doctor Schedule";
}

<section class="page-section">
    <div class="container">

        <!-- Header -->
        <div class="smart-card mb-5">

            <div class="row align-items-center">

                <div class="col-lg-8">

                    <span class="smart-badge">
                        Doctor Portal
                    </span>

                    <h1 class="dashboard-title mt-3">
                        Schedule Management
                    </h1>

                    <p class="text-muted mb-0">
                        View appointments, manage availability and monitor upcoming consultations.
                    </p>

                </div>

                <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">

                    <a asp-controller="Doctor"
                           asp-action="Dashboard"
                           class="btn btn-outline-secondary rounded-3">

                        Back to Dashboard

                    </a>

                </div>

            </div>

        </div>

        <!-- Statistics -->
        <div class="row g-4 mb-5">

            <div class="col-md-3">

                <div class="smart-card stat-panel">

                    <i class="bi bi-calendar-check"></i>

                    <h3>28</h3>

                    <p>This Week</p>

                </div>

            </div>

            <div class="col-md-3">

                <div class="smart-card stat-panel">

                    <i class="bi bi-person-check"></i>

                    <h3>8</h3>

                    <p>Today</p>

                </div>

            </div>

            <div class="col-md-3">

                <div class="smart-card stat-panel">

                    <i class="bi bi-clock-history"></i>

                    <h3>4</h3>

                    <p>Pending</p>

                </div>

            </div>

            <div class="col-md-3">

                <div class="smart-card stat-panel">

                    <i class="bi bi-check-circle"></i>

                    <h3>91%</h3>

                    <p>Attendance Rate</p>

                </div>

            </div>

        </div>

        <!-- Calendar -->
        <div class="smart-card mb-5">

            <div class="section-header">

                <h4>June 2026 Calendar</h4>

                <span class="text-muted">
                    Monthly Overview
                </span>

            </div>

            <div class="table-responsive">

                <table class="table table-bordered text-center align-middle">

                    <thead class="table-light">

                        <tr>
                            <th>Mon</th>
                            <th>Tue</th>
                            <th>Wed</th>
                            <th>Thu</th>
                            <th>Fri</th>
                            <th>Sat</th>
                            <th>Sun</th>
                        </tr>

                    </thead>

                    <tbody>

                        <tr>
                            <td></td>
                            <td>1</td>
                            <td>2</td>
                            <td>3</td>
                            <td><strong>4</strong><br /><small>8 Appointments</small></td>
                            <td>5</td>
                            <td>6</td>
                        </tr>

                        <tr>
                            <td>7</td>
                            <td><strong>8</strong><br /><small>6 Appointments</small></td>
                            <td>9</td>
                            <td>10</td>
                            <td><strong>11</strong><br /><small>7 Appointments</small></td>
                            <td>12</td>
                            <td>13</td>
                        </tr>

                        <tr>
                            <td>14</td>
                            <td>15</td>
                            <td>16</td>
                            <td><strong>17</strong><br /><small>9 Appointments</small></td>
                            <td>18</td>
                            <td>19</td>
                            <td>20</td>
                        </tr>

                        <tr>
                            <td>21</td>
                            <td>22</td>
                            <td>23</td>
                            <td>24</td>
                            <td>25</td>
                            <td>26</td>
                            <td>27</td>
                        </tr>

                        <tr>
                            <td>28</td>
                            <td>29</td>
                            <td>30</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

        <div class="row g-4">

            <!-- Weekly Schedule -->
            <div class="col-lg-8">

                <div class="smart-card">

                    <div class="section-header">

                        <h4>This Week's Schedule</h4>

                    </div>

                    <div class="table-responsive">

                        <table class="table align-middle smart-table">

                            <thead>

                                <tr>
                                    <th>Date</th>
                                    <th>Patient</th>
                                    <th>Time</th>
                                    <th>Service</th>
                                    <th>Status</th>
                                </tr>

                            </thead>

                            <tbody>

                                <tr>
                                    <td>Mon 8 Jun</td>
                                    <td>Sarah Jacobs</td>
                                    <td>09:00</td>
                                    <td>General Consultation</td>
                                    <td><span class="status-badge confirmed">Confirmed</span></td>
                                </tr>

                                <tr>
                                    <td>Mon 8 Jun</td>
                                    <td>Michael Brown</td>
                                    <td>09:30</td>
                                    <td>Follow-Up</td>
                                    <td><span class="status-badge pending">Waiting</span></td>
                                </tr>

                                <tr>
                                    <td>Tue 9 Jun</td>
                                    <td>Lisa Adams</td>
                                    <td>10:00</td>
                                    <td>Medical Review</td>
                                    <td><span class="status-badge confirmed">Confirmed</span></td>
                                </tr>

                                <tr>
                                    <td>Wed 10 Jun</td>
                                    <td>James Wilson</td>
                                    <td>11:30</td>
                                    <td>Consultation</td>
                                    <td><span class="status-badge pending">Scheduled</span></td>
                                </tr>

                                <tr>
                                    <td>Thu 11 Jun</td>
                                    <td>Emma Smith</td>
                                    <td>14:00</td>
                                    <td>Review</td>
                                    <td><span class="status-badge confirmed">Confirmed</span></td>
                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">

                <div class="smart-card">

                    <h4 class="mb-4">
                        Upcoming Consultations
                    </h4>

                    <div class="notification-item">

                        <i class="bi bi-person-heart"></i>

                        <div>

                            <strong>Sarah Jacobs</strong>

                            <p>
                                Today • 09:00
                            </p>

                        </div>

                    </div>

                    <div class="notification-item">

                        <i class="bi bi-person-heart"></i>

                        <div>

                            <strong>Michael Brown</strong>

                            <p>
                                Today • 09:30
                            </p>

                        </div>

                    </div>

                    <div class="notification-item">

                        <i class="bi bi-person-heart"></i>

                        <div>

                            <strong>Lisa Adams</strong>

                            <p>
                                Tomorrow • 10:00
                            </p>

                        </div>

                    </div>

                </div>

                <div class="smart-card mt-4">

                    <h4 class="mb-4">
                        Availability
                    </h4>

                    <p class="mb-2">
                        <strong>Monday - Friday</strong>
                    </p>

                    <p class="text-muted">
                        08:00 - 17:00
                    </p>

                    <hr />

                    <p class="mb-2">
                        <strong>Next Available Slot</strong>
                    </p>

                    <p class="text-success mb-0">
                        Today • 15:30
                    </p>

                </div>

            </div>

        </div>

    </div>
</section>