@{
    ViewData["Title"] = "Doctor Schedule";
}

<section class="page-section">
    <div class="container">

        <div class="smart-card schedule-header mb-4">

            <div>
                <span class="smart-badge">
                    Doctor Portal
                </span>

                <h1 class="dashboard-title mt-3 mb-2">
                    Schedule Management
                </h1>

                <p class="text-muted mb-0">
                    View appointments, manage availability and monitor upcoming consultations.
                </p>
            </div>

            <a asp-controller="Doctor"
                   asp-action="Dashboard"
                   class="btn btn-outline-secondary rounded-3 px-4">
                <i class="bi bi-arrow-left me-2"></i>
                Back to Dashboard
            </a>

        </div>

        <div class="schedule-stats">

            <div class="smart-card stat-panel">
                <div class="stat-icon">
                    <i class="bi bi-calendar-check"></i>
                </div>

                <div>
                    <h3>—</h3>
                    <p>This Week</p>
                    <span>No data available</span>
                </div>
            </div>

            <div class="smart-card stat-panel">
                <div class="stat-icon">
                    <i class="bi bi-person-check"></i>
                </div>

                <div>
                    <h3>—</h3>
                    <p>Today</p>
                    <span>No data available</span>
                </div>
            </div>

            <div class="smart-card stat-panel">
                <div class="stat-icon">
                    <i class="bi bi-clock-history"></i>
                </div>

                <div>
                    <h3>—</h3>
                    <p>Pending</p>
                    <span>No data available</span>
                </div>
            </div>

            <div class="smart-card stat-panel">
                <div class="stat-icon">
                    <i class="bi bi-check-circle"></i>
                </div>

                <div>
                    <h3>—</h3>
                    <p>Attendance Rate</p>
                    <span>No data available</span>
                </div>
            </div>

        </div>

        <div class="smart-card calendar-card mb-4">

            <div class="section-header mb-4">

                <div>
                    <h4 class="mb-1">
                        Calendar
                    </h4>

                    <p class="text-muted mb-0">
                        Monthly appointment overview.
                    </p>
                </div>

                <span class="records-count">
                    No appointments
                </span>

            </div>

            <div class="calendar-empty-state">

                <div class="calendar-empty-icon">
                    <i class="bi bi-calendar3"></i>
                </div>

                <h5>
                    Calendar data unavailable
                </h5>

                <p>
                    Appointment dates and consultation activity will appear here once schedule data is available.
                </p>

            </div>

        </div>

        <div class="schedule-content-grid">

            <div class="smart-card">

                <div class="section-header mb-4">

                    <div>
                        <h4 class="mb-1">
                            This Week's Schedule
                        </h4>

                        <p class="text-muted mb-0">
                            Upcoming consultations and appointment status.
                        </p>
                    </div>

                    <span class="records-count">
                        No appointments
                    </span>

                </div>

                <div class="schedule-empty-state">

                    <div class="schedule-empty-icon">
                        <i class="bi bi-calendar-x"></i>
                    </div>

                    <h5>
                        No scheduled consultations
                    </h5>

                    <p>
                        Your weekly appointment schedule will appear here when consultation data is available.
                    </p>

                </div>

            </div>

            <aside class="schedule-sidebar">

                <div class="smart-card">

                    <div class="section-header mb-4">

                        <div>
                            <h4 class="mb-1">
                                Upcoming Consultations
                            </h4>

                            <p class="text-muted mb-0">
                                Next scheduled patient visits.
                            </p>
                        </div>

                    </div>

                    <div class="sidebar-empty-state">

                        <i class="bi bi-person-heart"></i>

                        <strong>
                            No upcoming consultations
                        </strong>

                        <p>
                            Upcoming patient appointments will appear here.
                        </p>

                    </div>

                </div>

                <div class="smart-card">

                    <div class="section-header mb-4">

                        <div>
                            <h4 class="mb-1">
                                Availability
                            </h4>

                            <p class="text-muted mb-0">
                                Current working hours and available slots.
                            </p>
                        </div>

                    </div>

                    <div class="availability-empty-state">

                        <div class="availability-icon">
                            <i class="bi bi-clock"></i>
                        </div>

                        <h5>
                            Availability not configured
                        </h5>

                        <p>
                            Working hours and available consultation slots will appear when availability data is configured.
                        </p>

                    </div>

                    <div class="availability-details">

                        <div class="availability-row">
                            <span>Working Hours</span>
                            <strong>Not available</strong>
                        </div>

                        <div class="availability-row border-0">
                            <span>Next Available Slot</span>
                            <strong>Not available</strong>
                        </div>

                    </div>

                </div>

            </aside>

        </div>

    </div>
</section>

<style>
    .schedule-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        padding: 1.75rem 2rem;
    }

    .schedule-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .stat-panel {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.4rem 1.5rem;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        flex: 0 0 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: #e7f5f3;
        color: var(--primary);
        font-size: 1.25rem;
    }

    .stat-panel h3 {
        margin: 0;
        color: #243447;
        font-size: 1.7rem;
        font-weight: 700;
    }

    .stat-panel p {
        margin: 0.15rem 0;
        color: #495866;
        font-size: 0.86rem;
        font-weight: 600;
    }

    .stat-panel span {
        color: #8a96a1;
        font-size: 0.75rem;
    }

    .calendar-card,
    .schedule-content-grid > .smart-card,
    .schedule-sidebar .smart-card {
        padding: 1.75rem;
    }

    .records-count {
        padding: 0.4rem 0.75rem;
        border-radius: 999px;
        background: #f1f4f6;
        color: #687681;
        font-size: 0.76rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .calendar-empty-state,
    .schedule-empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 2.5rem 1.5rem;
        border: 1px dashed #d5dde5;
        border-radius: 15px;
        background: #fafcfd;
    }

    .calendar-empty-icon,
    .schedule-empty-icon {
        width: 58px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
        border-radius: 15px;
        background: #e7f5f3;
        color: var(--primary);
        font-size: 1.4rem;
    }

    .calendar-empty-state h5,
    .schedule-empty-state h5 {
        margin-bottom: 0.45rem;
        color: #243447;
    }

    .calendar-empty-state p,
    .schedule-empty-state p {
        max-width: 520px;
        margin: 0;
        color: #6c757d;
        font-size: 0.85rem;
        line-height: 1.6;
    }

    .schedule-content-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.7fr) minmax(280px, 0.78fr);
        gap: 1.5rem;
        align-items: start;
    }

    .schedule-sidebar {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .sidebar-empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 1.5rem 1rem;
        border: 1px dashed #d5dde5;
        border-radius: 14px;
        background: #fafcfd;
    }

        .sidebar-empty-state > i {
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 0.75rem;
            border-radius: 13px;
            background: #e7f5f3;
            color: var(--primary);
            font-size: 1.2rem;
        }

        .sidebar-empty-state strong {
            color: #243447;
            font-size: 0.9rem;
            margin-bottom: 0.3rem;
        }

        .sidebar-empty-state p {
            margin: 0;
            color: #6c757d;
            font-size: 0.8rem;
            line-height: 1.5;
        }

    .availability-empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 1.25rem;
        border: 1px dashed #d5dde5;
        border-radius: 14px;
        background: #fafcfd;
    }

    .availability-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 0.75rem;
        border-radius: 13px;
        background: #e7f5f3;
        color: var(--primary);
        font-size: 1.2rem;
    }

    .availability-empty-state h5 {
        margin-bottom: 0.3rem;
        color: #243447;
        font-size: 0.92rem;
    }

    .availability-empty-state p {
        margin: 0;
        color: #6c757d;
        font-size: 0.8rem;
        line-height: 1.5;
    }

    .availability-details {
        margin-top: 1rem;
    }

    .availability-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 0.8rem 0;
        border-bottom: 1px solid #edf1f3;
    }

        .availability-row span {
            color: #7a8793;
            font-size: 0.8rem;
        }

        .availability-row strong {
            color: #243447;
            font-size: 0.8rem;
            text-align: right;
        }

    @@media (max-width: 1199.98px) {
        .schedule-stats {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 991.98px) {
        .schedule-content-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 767.98px) {
        .schedule-header {
            flex-direction: column;
            align-items: flex-start;
            padding: 1.25rem;
        }

            .schedule-header a {
                width: 100%;
                text-align: center;
            }

        .schedule-stats {
            grid-template-columns: 1fr;
        }

        .calendar-card,
        .schedule-content-grid > .smart-card,
        .schedule-sidebar .smart-card {
            padding: 1.25rem;
        }

        .section-header {
            gap: 0.75rem;
            flex-wrap: wrap;
        }

        .records-count {
            align-self: flex-start;
        }

        .availability-row {
            align-items: flex-start;
            flex-direction: column;
            gap: 0.25rem;
        }

            .availability-row strong {
                text-align: left;
            }
    }
</style>