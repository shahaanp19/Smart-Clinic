@using SmartClinicManagementSystem.DTOs

@{
    ViewData["Title"] = "Doctor Schedule";

    var appointments =
        ViewBag.Appointments as List<AppointmentDto>
        ?? new List<AppointmentDto>();
}

<div class="container-fluid py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">My Schedule</h1>
            <p class="text-muted mb-0">
                View your upcoming patient appointments and clinical workload.
            </p>
        </div>

        <span class="badge rounded-pill text-bg-primary px-3 py-2">
            <i class="bi bi-calendar3 me-1" aria-hidden="true"></i>
            Doctor Schedule
        </span>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert"
             aria-live="polite">
            <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>
            @successMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert"
             aria-live="assertive">
            <i class="bi bi-exclamation-triangle-fill me-2"
               aria-hidden="true"></i>
            @errorMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    @{
        var scheduledCount = appointments.Count(a =>
            string.Equals(a.Status, "Scheduled", StringComparison.OrdinalIgnoreCase));

        var completedCount = appointments.Count(a =>
            string.Equals(a.Status, "Completed", StringComparison.OrdinalIgnoreCase));

        var cancelledCount = appointments.Count(a =>
            string.Equals(a.Status, "Cancelled", StringComparison.OrdinalIgnoreCase));

        var upcomingAppointments = appointments
            .Where(a =>
                a.AppointmentDateTime >= DateTime.UtcNow &&
                !string.Equals(a.Status, "Cancelled", StringComparison.OrdinalIgnoreCase))
            .OrderBy(a => a.AppointmentDateTime)
            .ToList();
    }

    <!-- Summary -->
    <div class="row g-4 mb-4">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small fw-semibold">
                                Total Appointments
                            </div>
                            <div class="display-6 fw-bold mt-1">
                                @appointments.Count
                            </div>
                        </div>

                        <span class="rounded-circle bg-primary-subtle text-primary d-inline-flex align-items-center justify-content-center"
                              style="width:52px;height:52px;">
                            <i class="bi bi-calendar-check fs-4"
                               aria-hidden="true"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small fw-semibold">
                                Scheduled
                            </div>
                            <div class="display-6 fw-bold mt-1">
                                @scheduledCount
                            </div>
                        </div>

                        <span class="rounded-circle bg-info-subtle text-info d-inline-flex align-items-center justify-content-center"
                              style="width:52px;height:52px;">
                            <i class="bi bi-clock fs-4"
                               aria-hidden="true"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small fw-semibold">
                                Completed
                            </div>
                            <div class="display-6 fw-bold mt-1">
                                @completedCount
                            </div>
                        </div>

                        <span class="rounded-circle bg-success-subtle text-success d-inline-flex align-items-center justify-content-center"
                              style="width:52px;height:52px;">
                            <i class="bi bi-check2-circle fs-4"
                               aria-hidden="true"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small fw-semibold">
                                Cancelled
                            </div>
                            <div class="display-6 fw-bold mt-1">
                                @cancelledCount
                            </div>
                        </div>

                        <span class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center"
                              style="width:52px;height:52px;">
                            <i class="bi bi-calendar-x fs-4"
                               aria-hidden="true"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Upcoming -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-transparent border-0 pt-4 px-4">
            <div>
                <h2 class="h5 fw-bold mb-1">
                    Upcoming Appointments
                </h2>

                <p class="text-muted small mb-0">
                    Your next scheduled patient appointments.
                </p>
            </div>
        </div>

        <div class="card-body">

            @if (upcomingAppointments.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar2-x display-5 text-muted"
                       aria-hidden="true"></i>

                    <h3 class="h6 fw-bold mt-3">
                        No upcoming appointments
                    </h3>

                    <p class="text-muted mb-0">
                        Your upcoming schedule is currently clear.
                    </p>
                </div>
            }
            else
            {
                <div class="row g-3">

                    @foreach (var appointment in upcomingAppointments)
                    {
                        var appointmentDate =
                            appointment.AppointmentDateTime.ToLocalTime();

                        var statusClass =
                            appointment.Status.Equals(
                                "Completed",
                                StringComparison.OrdinalIgnoreCase)
                                ? "text-bg-success"
                                : "text-bg-primary";

                        <div class="col-12 col-lg-6 col-xxl-4">
                            <div class="border rounded-4 p-4 h-100">

                                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                    <div>
                                        <div class="text-muted small">
                                            Appointment #@appointment.Id
                                        </div>

                                        <div class="fw-bold fs-5">
                                            @appointmentDate.ToString("dd MMM yyyy")
                                        </div>

                                        <div class="text-muted">
                                            @appointmentDate.ToString("HH:mm")
                                        </div>
                                    </div>

                                    <span class="badge rounded-pill @statusClass">
                                        @appointment.Status
                                    </span>
                                </div>

                                <div class="mb-3">
                                    <div class="small text-muted mb-1">
                                        Patient
                                    </div>

                                    <div class="fw-semibold">
                                        @(string.IsNullOrWhiteSpace(appointment.PatientName)
                                            ? $"Patient #{appointment.PatientId}"
                                            : appointment.PatientName)
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(appointment.Reason))
                                {
                                    <div class="mb-3">
                                        <div class="small text-muted mb-1">
                                            Reason
                                        </div>

                                        <div>
                                            @appointment.Reason
                                        </div>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(appointment.Notes))
                                {
                                    <div>
                                        <div class="small text-muted mb-1">
                                            Notes
                                        </div>

                                        <div class="small">
                                            @appointment.Notes
                                        </div>
                                    </div>
                                }

                            </div>
                        </div>
                    }

                </div>
            }

        </div>
    </div>

    <!-- Full schedule -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-header bg-transparent border-0 pt-4 px-4">
            <div class="d-flex flex-column flex-md-row justify-content-between gap-2">
                <div>
                    <h2 class="h5 fw-bold mb-1">
                        Appointment History
                    </h2>

                    <p class="text-muted small mb-0">
                        Complete appointment list for your schedule.
                    </p>
                </div>

                <span class="badge rounded-pill text-bg-light align-self-start">
                    @appointments.Count appointment@(appointments.Count == 1 ? "" : "s")
                </span>
            </div>
        </div>

        <div class="card-body p-0">

            @if (appointments.Count == 0)
            {
                <div class="text-center py-5 px-4">
                    <i class="bi bi-calendar-event display-5 text-muted"
                       aria-hidden="true"></i>

                    <h3 class="h6 fw-bold mt-3">
                        No appointments found
                    </h3>

                    <p class="text-muted mb-0">
                        Appointment records will appear here.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th scope="col">Date &amp; Time</th>
                                <th scope="col">Patient</th>
                                <th scope="col">Reason</th>
                                <th scope="col">Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var appointment in appointments
                                .OrderBy(a => a.AppointmentDateTime))
                            {
                                var appointmentDate =
                                    appointment.AppointmentDateTime.ToLocalTime();

                                var badgeClass =
                                    appointment.Status.Equals(
                                        "Completed",
                                        StringComparison.OrdinalIgnoreCase)
                                        ? "text-bg-success"
                                        : appointment.Status.Equals(
                                            "Cancelled",
                                            StringComparison.OrdinalIgnoreCase)
                                            ? "text-bg-danger"
                                            : "text-bg-primary";

                                <tr>
                                    <td class="text-nowrap">
                                        <div class="fw-semibold">
                                            @appointmentDate.ToString("dd MMM yyyy")
                                        </div>

                                        <small class="text-muted">
                                            @appointmentDate.ToString("HH:mm")
                                        </small>
                                    </td>

                                    <td>
                                        <div class="fw-semibold">
                                            @(string.IsNullOrWhiteSpace(appointment.PatientName)
                                                ? $"Patient #{appointment.PatientId}"
                                                : appointment.PatientName)
                                        </div>

                                        <small class="text-muted">
                                            ID: @appointment.PatientId
                                        </small>
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(appointment.Reason))
                                        {
                                            @appointment.Reason
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not specified
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <span class="badge rounded-pill @badgeClass">
                                            @appointment.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>

</div>