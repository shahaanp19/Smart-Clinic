@using SmartClinicManagementSystem.DTOs

@{
    ViewData["Title"] = "Medical Records";

    var consultations =
        ViewBag.Consultations as List<ConsultationDto>
        ?? new List<ConsultationDto>();

    var prescriptions =
        ViewBag.Prescriptions as List<PrescriptionDto>
        ?? new List<PrescriptionDto>();
}

<div class="container-fluid py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Medical Records</h1>
            <p class="text-muted mb-0">
                Review clinical consultations and prescriptions recorded by you.
            </p>
        </div>

        <span class="badge rounded-pill text-bg-primary px-3 py-2">
            <i class="bi bi-folder2-open me-1" aria-hidden="true"></i>
            Clinical Archive
        </span>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert"
             aria-live="polite">
            <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>
            @successMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <div class="row g-4 mb-4">

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small fw-semibold">
                                Consultations
                            </div>

                            <div class="display-6 fw-bold mt-1">
                                @consultations.Count
                            </div>
                        </div>

                        <span class="rounded-circle bg-primary-subtle text-primary d-inline-flex align-items-center justify-content-center"
                              style="width:52px;height:52px;">
                            <i class="bi bi-clipboard2-pulse fs-4"
                               aria-hidden="true"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small fw-semibold">
                                Prescriptions
                            </div>

                            <div class="display-6 fw-bold mt-1">
                                @prescriptions.Count
                            </div>
                        </div>

                        <span class="rounded-circle bg-success-subtle text-success d-inline-flex align-items-center justify-content-center"
                              style="width:52px;height:52px;">
                            <i class="bi bi-capsule-pill fs-4"
                               aria-hidden="true"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small fw-semibold">
                                Unique Patients
                            </div>

                            <div class="display-6 fw-bold mt-1">
                                @{
                                    var uniquePatients = consultations
                                        .Select(c => c.PatientId)
                                        .Concat(prescriptions.Select(p => p.PatientId))
                                        .Distinct()
                                        .Count();
                                }

                                @uniquePatients
                            </div>
                        </div>

                        <span class="rounded-circle bg-info-subtle text-info d-inline-flex align-items-center justify-content-center"
                              style="width:52px;height:52px;">
                            <i class="bi bi-people fs-4"
                               aria-hidden="true"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small fw-semibold">
                                Latest Activity
                            </div>

                            <div class="fw-bold mt-2">
                                @{
                                    var latestConsultation =
                                        consultations
                                            .OrderByDescending(c => c.ConsultationDateUtc)
                                            .Select(c => (DateTime?)c.ConsultationDateUtc)
                                            .FirstOrDefault();

                                    var latestPrescription =
                                        prescriptions
                                            .OrderByDescending(p => p.PrescribedAtUtc)
                                            .Select(p => (DateTime?)p.PrescribedAtUtc)
                                            .FirstOrDefault();

                                    var latestActivity =
                                        new[] { latestConsultation, latestPrescription }
                                            .Where(d => d.HasValue)
                                            .Select(d => d!.Value)
                                            .OrderByDescending(d => d)
                                            .FirstOrDefault();
                                }

                                @if (latestActivity != default)
                                {
                                    @latestActivity.ToLocalTime().ToString("dd MMM yyyy")
                                }
                                else
                                {
                                    <span class="text-muted">No activity</span>
                                }
                            </div>
                        </div>

                        <span class="rounded-circle bg-warning-subtle text-warning d-inline-flex align-items-center justify-content-center"
                              style="width:52px;height:52px;">
                            <i class="bi bi-clock-history fs-4"
                               aria-hidden="true"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Consultations -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-transparent border-0 pt-4 px-4">
            <div class="d-flex flex-column flex-md-row justify-content-between gap-2">
                <div>
                    <h2 class="h5 fw-bold mb-1">
                        Consultation Records
                    </h2>

                    <p class="text-muted small mb-0">
                        Clinical assessments and treatment information.
                    </p>
                </div>

                <span class="badge rounded-pill text-bg-light align-self-start">
                    @consultations.Count record@(consultations.Count == 1 ? "" : "s")
                </span>
            </div>
        </div>

        <div class="card-body p-0">

            @if (consultations.Count == 0)
            {
                <div class="text-center py-5 px-4">
                    <i class="bi bi-clipboard2-x display-5 text-muted"
                       aria-hidden="true"></i>

                    <h3 class="h6 fw-bold mt-3">
                        No consultation records
                    </h3>

                    <p class="text-muted mb-0">
                        Recorded consultations will appear here.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th scope="col">Patient</th>
                                <th scope="col">Diagnosis</th>
                                <th scope="col">Treatment Plan</th>
                                <th scope="col">Consultation Date</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var consultation in consultations
                                .OrderByDescending(c => c.ConsultationDateUtc))
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">
                                            @consultation.PatientName
                                        </div>

                                        <small class="text-muted">
                                            Patient #@consultation.PatientId
                                        </small>
                                    </td>

                                    <td>
                                        @consultation.Diagnosis
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(
                                            consultation.TreatmentPlan))
                                        {
                                            @consultation.TreatmentPlan
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No treatment plan recorded
                                            </span>
                                        }
                                    </td>

                                    <td class="text-nowrap">
                                        @consultation.ConsultationDateUtc
                                        .ToLocalTime()
                                        .ToString("dd MMM yyyy")
                                        <br />
                                        <small class="text-muted">
                                            @consultation.ConsultationDateUtc
                                            .ToLocalTime()
                                            .ToString("HH:mm")
                                        </small>
                                    </td>
                                </tr>

                                @if (!string.IsNullOrWhiteSpace(
                                    consultation.ClinicalNotes))
                                {
                                    <tr class="table-light">
                                        <td colspan="4">
                                            <div class="small">
                                                <strong>
                                                    <i class="bi bi-journal-text me-1"
                                                       aria-hidden="true"></i>
                                                    Clinical Notes:
                                                </strong>

                                                @consultation.ClinicalNotes
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>

    <!-- Prescriptions -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-header bg-transparent border-0 pt-4 px-4">
            <div class="d-flex flex-column flex-md-row justify-content-between gap-2">
                <div>
                    <h2 class="h5 fw-bold mb-1">
                        Prescription Records
                    </h2>

                    <p class="text-muted small mb-0">
                        Medication and prescribing instructions.
                    </p>
                </div>

                <span class="badge rounded-pill text-bg-light align-self-start">
                    @prescriptions.Count prescription@(prescriptions.Count == 1 ? "" : "s")
                </span>
            </div>
        </div>

        <div class="card-body p-0">

            @if (prescriptions.Count == 0)
            {
                <div class="text-center py-5 px-4">
                    <i class="bi bi-prescription2 display-5 text-muted"
                       aria-hidden="true"></i>

                    <h3 class="h6 fw-bold mt-3">
                        No prescription records
                    </h3>

                    <p class="text-muted mb-0">
                        Generated prescriptions will appear here.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th scope="col">Patient</th>
                                <th scope="col">Medication</th>
                                <th scope="col">Dosage</th>
                                <th scope="col">Frequency</th>
                                <th scope="col">Duration</th>
                                <th scope="col">Prescribed</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var prescription in prescriptions
                                .OrderByDescending(p => p.PrescribedAtUtc))
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">
                                            @prescription.PatientName
                                        </div>

                                        <small class="text-muted">
                                            Patient #@prescription.PatientId
                                        </small>
                                    </td>

                                    <td>
                                        <span class="fw-semibold">
                                            @prescription.MedicationName
                                        </span>
                                    </td>

                                    <td>
                                        @prescription.Dosage
                                    </td>

                                    <td>
                                        @prescription.Frequency
                                    </td>

                                    <td>
                                        @prescription.Duration
                                    </td>

                                    <td class="text-nowrap">
                                        @prescription.PrescribedAtUtc
                                        .ToLocalTime()
                                        .ToString("dd MMM yyyy")
                                        <br />
                                        <small class="text-muted">
                                            @prescription.PrescribedAtUtc
                                            .ToLocalTime()
                                            .ToString("HH:mm")
                                        </small>
                                    </td>
                                </tr>

                                @if (!string.IsNullOrWhiteSpace(
                                    prescription.Instructions))
                                {
                                    <tr class="table-light">
                                        <td colspan="6">
                                            <div class="small">
                                                <strong>
                                                    <i class="bi bi-info-circle me-1"
                                                       aria-hidden="true"></i>
                                                    Instructions:
                                                </strong>

                                                @prescription.Instructions
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>

</div>