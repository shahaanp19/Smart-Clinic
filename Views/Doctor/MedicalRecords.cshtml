@{
    ViewData["Title"] = "Patient Records";
}

<section class="page-section">
    <div class="container">

        <div class="smart-card records-header mb-4">

            <div>
                <span class="smart-badge">
                    Doctor Portal
                </span>

                <h1 class="dashboard-title mt-3 mb-2">
                    Patient Records
                </h1>

                <p class="text-muted mb-0">
                    Search, review and manage patient medical information.
                </p>
            </div>

            <a asp-controller="Doctor"
                   asp-action="Dashboard"
                   class="btn btn-outline-primary rounded-3 px-4">
                <i class="bi bi-arrow-left me-2"></i>
                Back to Dashboard
            </a>

        </div>

        <div class="records-stats">

            <div class="smart-card stat-panel">
                <div class="stat-icon">
                    <i class="bi bi-people"></i>
                </div>

                <div>
                    <h3>—</h3>
                    <p>Total Patients</p>
                    <span>No data available</span>
                </div>
            </div>

            <div class="smart-card stat-panel">
                <div class="stat-icon">
                    <i class="bi bi-file-medical"></i>
                </div>

                <div>
                    <h3>—</h3>
                    <p>Records Updated Today</p>
                    <span>No data available</span>
                </div>
            </div>

            <div class="smart-card stat-panel">
                <div class="stat-icon">
                    <i class="bi bi-calendar-check"></i>
                </div>

                <div>
                    <h3>—</h3>
                    <p>Today's Consultations</p>
                    <span>No data available</span>
                </div>
            </div>

        </div>

        <div class="smart-card records-search-card">

            <div class="section-header mb-3">
                <div>
                    <h4 class="mb-1">
                        Find a Patient
                    </h4>

                    <p class="text-muted mb-0">
                        Search by patient name, ID or medical record number.
                    </p>
                </div>
            </div>

            <div class="records-search">

                <div class="records-search-input">
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               class="form-control"
                               placeholder="Search patient records..." />
                    </div>
                </div>

                <button type="button"
                        class="smart-btn-primary border-0">
                    <i class="bi bi-search me-2"></i>
                    Search
                </button>

            </div>

        </div>

        <div class="smart-card records-list-card">

            <div class="section-header mb-4">

                <div>
                    <h4 class="mb-1">
                        Patient Records
                    </h4>

                    <p class="text-muted mb-0">
                        Patient records will appear here when available.
                    </p>
                </div>

                <span class="records-count">
                    No records
                </span>

            </div>

            <div class="records-empty-state">

                <div class="records-empty-icon">
                    <i class="bi bi-folder2-open"></i>
                </div>

                <h5>
                    No patient records available
                </h5>

                <p>
                    There are currently no patient records to display.
                    Search results will appear in this area once patient data is available.
                </p>

            </div>

        </div>

        <div class="smart-card quick-actions-card">

            <div class="section-header mb-4">

                <div>
                    <h4 class="mb-1">
                        Quick Actions
                    </h4>

                    <p class="text-muted mb-0">
                        Access common clinical workflows.
                    </p>
                </div>

            </div>

            <div class="quick-actions-grid">

                <a asp-controller="Doctor"
                       asp-action="Consultation"
                       class="portal-card text-decoration-none">

                    <div class="action-icon">
                        <i class="bi bi-clipboard2-pulse"></i>
                    </div>

                    <div>
                        <h5>
                            Start Consultation
                        </h5>

                        <p>
                            Begin a patient consultation.
                        </p>
                    </div>

                    <i class="bi bi-arrow-right action-arrow"></i>

                </a>

                <a asp-controller="Doctor"
                       asp-action="GeneratePrescription"
                       class="portal-card text-decoration-none">

                    <div class="action-icon">
                        <i class="bi bi-capsule-pill"></i>
                    </div>

                    <div>
                        <h5>
                            Generate Prescription
                        </h5>

                        <p>
                            Create a new patient prescription.
                        </p>
                    </div>

                    <i class="bi bi-arrow-right action-arrow"></i>

                </a>

                <a asp-controller="Doctor"
                       asp-action="Schedule"
                       class="portal-card text-decoration-none">

                    <div class="action-icon">
                        <i class="bi bi-calendar-week"></i>
                    </div>

                    <div>
                        <h5>
                            View Schedule
                        </h5>

                        <p>
                            Review upcoming consultations.
                        </p>
                    </div>

                    <i class="bi bi-arrow-right action-arrow"></i>

                </a>

            </div>

        </div>

    </div>
</section>

<style>
    .records-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        padding: 1.75rem 2rem;
    }

    .records-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .stat-panel {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.4rem 1.5rem;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        flex: 0 0 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: #e7f5f3;
        color: var(--primary);
        font-size: 1.25rem;
    }

    .stat-panel h3 {
        margin: 0;
        color: #243447;
        font-size: 1.7rem;
        font-weight: 700;
    }

    .stat-panel p {
        margin: 0.15rem 0;
        color: #495866;
        font-size: 0.86rem;
        font-weight: 600;
    }

    .stat-panel span {
        color: #8a96a1;
        font-size: 0.75rem;
    }

    .records-search-card,
    .records-list-card,
    .quick-actions-card {
        padding: 1.75rem;
        margin-bottom: 1.5rem;
    }

    .records-search {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 180px;
        gap: 0.9rem;
        align-items: center;
    }

        .records-search .input-group-text {
            background: #f8fafb;
            border-color: #dce4e9;
            color: #7b8792;
        }

        .records-search .form-control {
            border-color: #dce4e9;
            min-height: 46px;
        }

            .records-search .form-control:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 0.2rem rgba(15, 118, 110, 0.1);
            }

    .records-count {
        padding: 0.4rem 0.75rem;
        border-radius: 999px;
        background: #f1f4f6;
        color: #687681;
        font-size: 0.76rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .records-empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 2.5rem 1.5rem;
        border: 1px dashed #d5dde5;
        border-radius: 15px;
        background: #fafcfd;
    }

    .records-empty-icon {
        width: 58px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
        border-radius: 15px;
        background: #e7f5f3;
        color: var(--primary);
        font-size: 1.45rem;
    }

    .records-empty-state h5 {
        margin-bottom: 0.45rem;
        color: #243447;
    }

    .records-empty-state p {
        max-width: 560px;
        margin: 0;
        color: #6c757d;
        font-size: 0.86rem;
        line-height: 1.6;
    }

    .quick-actions-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
    }

        .quick-actions-grid .portal-card {
            position: relative;
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1.25rem;
            border: 1px solid #e1e8ec;
            border-radius: 14px;
            background: #fff;
            transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
        }

            .quick-actions-grid .portal-card:hover {
                transform: translateY(-2px);
                border-color: rgba(15, 118, 110, 0.3);
                box-shadow: 0 10px 25px rgba(31, 45, 61, 0.08);
            }

    .action-icon {
        width: 46px;
        height: 46px;
        flex: 0 0 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #e7f5f3;
        color: var(--primary);
        font-size: 1.2rem;
    }

    .quick-actions-grid h5 {
        margin: 0 0 0.25rem;
        color: #243447;
        font-size: 0.92rem;
    }

    .quick-actions-grid p {
        margin: 0;
        color: #7a8793;
        font-size: 0.78rem;
        line-height: 1.4;
    }

    .action-arrow {
        margin-left: auto;
        color: #8b98a3;
        font-size: 0.95rem;
    }

    @@media (max-width: 991.98px) {
        .records-stats {
            grid-template-columns: 1fr;
        }

        .quick-actions-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 767.98px) {
        .records-header {
            flex-direction: column;
            align-items: flex-start;
            padding: 1.25rem;
        }

            .records-header a {
                width: 100%;
                text-align: center;
            }

        .records-search-card,
        .records-list-card,
        .quick-actions-card {
            padding: 1.25rem;
        }

        .records-search {
            grid-template-columns: 1fr;
        }

            .records-search button {
                width: 100%;
            }

        .section-header {
            gap: 0.75rem;
        }

        .records-count {
            align-self: flex-start;
        }
    }
</style>