@{
    ViewData["Title"] = "My Profile";
}

<section class="page-section">
    <div class="container">

        <div class="mb-4">
            <span class="smart-badge">Patient Portal</span>

            <h1 class="dashboard-title mt-3">
                My Profile
            </h1>

            <p class="text-muted">
                View and manage your personal information.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-lg-4">

                <div class="smart-card text-center">

                    <i class="bi bi-person-circle"
                       style="font-size:120px;color:var(--primary);"></i>

                    <h4 class="mt-3">
                        Sarah Jacobs
                    </h4>

                    <p class="text-muted">
                        Active Patient
                    </p>

                </div>

            </div>

            <div class="col-lg-8">

                <div class="smart-card">

                    <h4 class="mb-4">
                        Personal Information
                    </h4>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="smart-label">First Name</label>
                            <input class="form-control smart-input"
                                   value="Sarah" />
                        </div>

                        <div class="col-md-6">
                            <label class="smart-label">Surname</label>
                            <input class="form-control smart-input"
                                   value="Jacobs" />
                        </div>

                        <div class="col-md-6">
                            <label class="smart-label">Email</label>
                            <input class="form-control smart-input"
                                   value="sarah.jacobs@email.com" />
                        </div>

                        <div class="col-md-6">
                            <label class="smart-label">Phone Number</label>
                            <input class="form-control smart-input"
                                   value="082 555 0147" />
                        </div>

                        <div class="col-md-6">
                            <label class="smart-label">Date of Birth</label>
                            <input class="form-control smart-input"
                                   value="12 March 1992" />
                        </div>

                        <div class="col-md-6">
                            <label class="smart-label">Gender</label>
                            <input class="form-control smart-input"
                                   value="Female" />
                        </div>

                    </div>

                    <div class="mt-4">

                        <button class="smart-btn-primary">
                            <i class="bi bi-save me-2"></i>
                            Save Changes
                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>
</section>