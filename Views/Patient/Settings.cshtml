@{
    ViewData["Title"] = "Settings";
}

<section class="page-section">
    <div class="container">

        ```
        <!-- Page Header -->

        <div class="mb-5">

            <span class="smart-badge">
                Patient Portal
            </span>

            <h1 class="dashboard-title mt-3">
                Account Settings
            </h1>

            <p class="text-muted">
                Manage your account information, notification preferences,
                privacy settings and security options.
            </p>

        </div>

        <div class="row g-4">

            <!-- Left Column -->

            <div class="col-lg-8">

                <!-- Account Information -->

                <div class="smart-card mb-4">

                    <h4 class="mb-4">
                        Account Information
                    </h4>

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label class="smart-label">
                                First Name
                            </label>

                            <input type="text"
                                   class="form-control smart-input"
                                   value="Sarah">

                        </div>

                        <div class="col-md-6">

                            <label class="smart-label">
                                Last Name
                            </label>

                            <input type="text"
                                   class="form-control smart-input"
                                   value="Jacobs">

                        </div>

                        <div class="col-md-6">

                            <label class="smart-label">
                                Email Address
                            </label>

                            <input type="email"
                                   class="form-control smart-input"
                                   value="sarah.jacobs@email.com">

                        </div>

                        <div class="col-md-6">

                            <label class="smart-label">
                                Phone Number
                            </label>

                            <input type="text"
                                   class="form-control smart-input"
                                   value="082 555 0147">

                        </div>

                    </div>

                </div>

                <!-- Notifications -->

                <div class="smart-card mb-4">

                    <h4 class="mb-4">
                        Notification Preferences
                    </h4>

                    <div class="form-check form-switch mb-3">

                        <input class="form-check-input"
                               type="checkbox"
                               checked>

                        <label class="form-check-label">
                            Appointment Reminders
                        </label>

                    </div>

                    <div class="form-check form-switch mb-3">

                        <input class="form-check-input"
                               type="checkbox"
                               checked>

                        <label class="form-check-label">
                            Prescription Notifications
                        </label>

                    </div>

                    <div class="form-check form-switch">

                        <input class="form-check-input"
                               type="checkbox">

                        <label class="form-check-label">
                            Promotional Communications
                        </label>

                    </div>

                </div>

                <!-- Security -->

                <div class="smart-card">

                    <h4 class="mb-4">
                        Security Settings
                    </h4>

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label class="smart-label">
                                New Password
                            </label>

                            <input type="password"
                                   class="form-control smart-input">

                        </div>

                        <div class="col-md-6">

                            <label class="smart-label">
                                Confirm Password
                            </label>

                            <input type="password"
                                   class="form-control smart-input">

                        </div>

                    </div>

                    <button class="smart-btn-primary mt-4">

                        <i class="bi bi-shield-lock me-2"></i>

                        Update Password

                    </button>

                </div>

            </div>

            <!-- Right Column -->

            <div class="col-lg-4">

                <!-- Profile Summary -->

                <div class="smart-card mb-4 text-center">

                    <i class="bi bi-person-circle"
                       style="font-size:80px;color:var(--primary);"></i>

                    <h4 class="mt-3">
                        Sarah Jacobs
                    </h4>

                    <p class="text-muted mb-3">
                        Active Patient
                    </p>

                    <span class="status-badge confirmed">
                        Account Verified
                    </span>

                </div>

                <!-- Security Status -->

                <div class="smart-card">

                    <h4 class="mb-3">
                        Account Status
                    </h4>

                    <p>
                        <strong>Email:</strong>
                        Verified
                    </p>

                    <p>
                        <strong>Phone:</strong>
                        Verified
                    </p>

                    <p>
                        <strong>Two-Factor Authentication:</strong>
                        Enabled
                    </p>

                    <p class="mb-0">
                        <strong>Last Login:</strong>
                        Today, 08:15
                    </p>

                </div>

            </div>

        </div>

        <!-- Save Button -->

        <div class="mt-5">

            <button class="smart-btn-primary">

                <i class="bi bi-check-circle me-2"></i>

                Save Settings

            </button>

        </div>

    </div>
    ```

</section>
