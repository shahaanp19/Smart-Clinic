@{
    ViewData["Title"] = "Login";
}

<section class="login-section">
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-75">
            <div class="col-lg-5">
                <div class="smart-card login-card">
                    <div class="text-center mb-4">
                        <i class="bi bi-hospital login-icon"></i>
                        <h1 class="dashboard-title mt-3">Smart Clinic Login</h1>
                        <p class="text-muted">Access your secure clinic portal.</p>
                    </div>

                    <form>
                        <div class="mb-3">
                            <label class="form-label smart-label">Email Address</label>
                            <input type="email" class="form-control smart-input" value="patient@email.com" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label smart-label">Password</label>
                            <input type="password" class="form-control smart-input" value="password123" />
                        </div>

                        <div class="d-grid mt-4">
                            <a asp-controller="Patient"
                                   asp-action="Dashboard"
                                   class="smart-btn-primary text-decoration-none text-center">
                                Login
                            </a>
                        </div>
                    </form>

                    <div class="text-center mt-4">
                        <p class="text-muted mb-0">
                            Prototype only — dummy login interface
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>