```cshtml
@{
    ViewData["Title"] = "Patient Login";
}

<section class="login-section">
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-75">
            <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">

                <div class="smart-card login-card">

                    <div class="text-center login-header">
                        <div class="login-icon-wrapper">
                            <i class="bi bi-person-circle login-icon"></i>
                        </div>

                        <h1 class="login-title">
                            Patient Login
                        </h1>

                        <p class="login-subtitle">
                            Sign in to your patient portal.
                        </p>
                    </div>

                    <form method="post" class="login-form">

                        <div class="login-field">
                            <label for="email" class="form-label smart-label">
                                Email Address
                            </label>

                            <div class="login-input-wrapper">
                                <i class="bi bi-envelope login-input-icon"></i>

                                <input id="email"
                                       name="email"
                                       type="email"
                                       class="form-control smart-input login-input"
                                       placeholder="patient@email.com"
                                       autocomplete="email"
                                       required />
                            </div>
                        </div>

                        <div class="login-field">
                            <label for="password" class="form-label smart-label">
                                Password
                            </label>

                            <div class="login-input-wrapper">
                                <i class="bi bi-lock login-input-icon"></i>

                                <input id="password"
                                       name="password"
                                       type="password"
                                       class="form-control smart-input login-input"
                                       placeholder="Enter your password"
                                       autocomplete="current-password"
                                       required />
                            </div>
                        </div>

                        <div class="login-options">
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="rememberPatient">

                                <label class="form-check-label"
                                       for="rememberPatient">
                                    Remember me
                                </label>
                            </div>

                            <a href="#" class="login-link">
                                Forgot password?
                            </a>
                        </div>

                        <div class="d-grid login-action">
                            <a asp-controller="Patient"
                                   asp-action="Dashboard"
                                   class="smart-btn-primary login-button text-decoration-none text-center">
                                Login
                            </a>
                        </div>

                    </form>

                    <div class="login-divider">
                        <span>OR</span>
                    </div>

                    <div class="create-account-section text-center">
                        <h2 class="create-account-title">
                            New to Smart Clinic?
                        </h2>

                        <p class="create-account-text">
                            Create a patient account to get started.
                        </p>

                        <div class="d-grid">
                            <a asp-controller="Patient"
                                   asp-action="Register"
                                   class="smart-btn-secondary login-button text-decoration-none text-center">
                                <i class="bi bi-person-plus me-2"></i>
                                Create Account
                            </a>
                        </div>
                    </div>

                    <div class="login-footer text-center">
                        <span>
                            Smart Clinic Patient Portal
                        </span>
                    </div>

                </div>

            </div>
        </div>
    </div>
</section>
```
