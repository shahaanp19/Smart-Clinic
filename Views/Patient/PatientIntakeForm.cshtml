@{
    ViewData["Title"] = "Medical History Form";
}

<section class="page-section patient-medical-form-page">

    <div class="container">

        <!-- PAGE HEADER -->
        <div class="medical-form-header mb-5">

            <div>
                <span class="smart-badge">
                    Patient Portal
                </span>

                <h1 class="dashboard-title mt-3 mb-2">
                    Medical History Form
                </h1>

                <p class="text-muted mb-0">
                    Keep your medical information up to date so healthcare
                    professionals have the information they need to support your care.
                </p>
            </div>

            <a asp-controller="Patient"
                   asp-action="Dashboard"
                   class="medical-form-back-link">

                <i class="bi bi-arrow-left"></i>
                Back to Dashboard

            </a>

        </div>


        <!-- FORM -->
        <form method="post"
              asp-controller="Patient"
              asp-action="PatientIntakeForm">

            <!-- PATIENT INFORMATION -->
            <div class="smart-card medical-form-card mb-4">

                <div class="medical-form-card-header">

                    <div class="medical-form-title">

                        <div class="medical-form-icon">
                            <i class="bi bi-person-vcard"></i>
                        </div>

                        <div>
                            <span>SECTION 01</span>
                            <h3>Patient Information</h3>
                        </div>

                    </div>

                </div>


                <div class="row g-4">

                    <div class="col-md-6">

                        <label class="smart-label">
                            Full Name
                        </label>

                        <input type="text"
                               name="FullName"
                               class="form-control smart-input"
                               placeholder="Enter your full name"
                               autocomplete="name" />

                    </div>


                    <div class="col-md-3">

                        <label class="smart-label">
                            Date of Birth
                        </label>

                        <input type="date"
                               name="DateOfBirth"
                               class="form-control smart-input"
                               autocomplete="bday" />

                    </div>


                    <div class="col-md-3">

                        <label class="smart-label">
                            Gender
                        </label>

                        <select name="Gender"
                                class="form-select smart-input">

                            <option value="" selected disabled>
                                Select gender
                            </option>

                            <option value="Male">
                                Male
                            </option>

                            <option value="Female">
                                Female
                            </option>

                            <option value="Other">
                                Other
                            </option>

                            <option value="PreferNotToSay">
                                Prefer not to say
                            </option>

                        </select>

                    </div>


                    <div class="col-md-8">

                        <label class="smart-label">
                            Address
                        </label>

                        <input type="text"
                               name="Address"
                               class="form-control smart-input"
                               placeholder="Enter your residential address"
                               autocomplete="street-address" />

                    </div>


                    <div class="col-md-4">

                        <label class="smart-label">
                            Phone Number
                        </label>

                        <input type="tel"
                               name="PhoneNumber"
                               class="form-control smart-input"
                               placeholder="Enter your phone number"
                               autocomplete="tel" />

                    </div>

                </div>

            </div>


            <!-- EMERGENCY CONTACT -->
            <div class="smart-card medical-form-card mb-4">

                <div class="medical-form-card-header">

                    <div class="medical-form-title">

                        <div class="medical-form-icon">
                            <i class="bi bi-telephone-plus"></i>
                        </div>

                        <div>
                            <span>SECTION 02</span>
                            <h3>Emergency Contact</h3>
                        </div>

                    </div>

                </div>


                <div class="row g-4">

                    <div class="col-md-4">

                        <label class="smart-label">
                            Name
                        </label>

                        <input type="text"
                               name="EmergencyContactName"
                               class="form-control smart-input"
                               placeholder="Contact's full name" />

                    </div>


                    <div class="col-md-4">

                        <label class="smart-label">
                            Relationship
                        </label>

                        <input type="text"
                               name="EmergencyContactRelationship"
                               class="form-control smart-input"
                               placeholder="e.g. Parent, spouse, sibling" />

                    </div>


                    <div class="col-md-4">

                        <label class="smart-label">
                            Phone Number
                        </label>

                        <input type="tel"
                               name="EmergencyContactPhone"
                               class="form-control smart-input"
                               placeholder="Contact phone number" />

                    </div>

                </div>

            </div>


            <!-- MEDICAL AID -->
            <div class="smart-card medical-form-card mb-4">

                <div class="medical-form-card-header">

                    <div class="medical-form-title">

                        <div class="medical-form-icon">
                            <i class="bi bi-shield-check"></i>
                        </div>

                        <div>
                            <span>SECTION 03</span>
                            <h3>Medical Aid / Insurance</h3>
                        </div>

                    </div>

                </div>


                <div class="row g-4">

                    <div class="col-md-6">

                        <label class="smart-label">
                            Medical Aid Provider
                        </label>

                        <input type="text"
                               name="MedicalAidProvider"
                               class="form-control smart-input"
                               placeholder="Enter provider name" />

                    </div>


                    <div class="col-md-6">

                        <label class="smart-label">
                            Policy Number
                        </label>

                        <input type="text"
                               name="PolicyNumber"
                               class="form-control smart-input"
                               placeholder="Enter policy number" />

                    </div>

                </div>

            </div>


            <!-- MEDICAL CONDITIONS -->
            <div class="smart-card medical-form-card mb-4">

                <div class="medical-form-card-header">

                    <div class="medical-form-title">

                        <div class="medical-form-icon">
                            <i class="bi bi-heart-pulse"></i>
                        </div>

                        <div>
                            <span>SECTION 04</span>
                            <h3>Medical History</h3>
                        </div>

                    </div>

                </div>


                <p class="medical-form-description">
                    Select any conditions that apply to you.
                </p>


                <div class="medical-checkbox-grid">

                    <label class="medical-check">
                        <input type="checkbox"
                               name="Conditions"
                               value="NoKnownConditions" />
                        <span>No Known Conditions</span>
                    </label>


                    <label class="medical-check">
                        <input type="checkbox"
                               name="Conditions"
                               value="Allergies" />
                        <span>Allergies</span>
                    </label>


                    <label class="medical-check">
                        <input type="checkbox"
                               name="Conditions"
                               value="Asthma" />
                        <span>Asthma</span>
                    </label>


                    <label class="medical-check">
                        <input type="checkbox"
                               name="Conditions"
                               value="Diabetes" />
                        <span>Diabetes</span>
                    </label>


                    <label class="medical-check">
                        <input type="checkbox"
                               name="Conditions"
                               value="Epilepsy" />
                        <span>Epilepsy</span>
                    </label>


                    <label class="medical-check">
                        <input type="checkbox"
                               name="Conditions"
                               value="Cancer" />
                        <span>Cancer</span>
                    </label>


                    <label class="medical-check">
                        <input type="checkbox"
                               name="Conditions"
                               value="Depression" />
                        <span>Depression</span>
                    </label>


                    <label class="medical-check">
                        <input type="checkbox"
                               name="Conditions"
                               value="HeartDisease" />
                        <span>Heart Disease</span>
                    </label>


                    <label class="medical-check">
                        <input type="checkbox"
                               name="Conditions"
                               value="HighBloodPressure" />
                        <span>High Blood Pressure</span>
                    </label>


                    <label class="medical-check">
                        <input type="checkbox"
                               name="Conditions"
                               value="HighCholesterol" />
                        <span>High Cholesterol</span>
                    </label>


                    <label class="medical-check">
                        <input type="checkbox"
                               name="Conditions"
                               value="KidneyDisease" />
                        <span>Kidney Disease</span>
                    </label>


                    <label class="medical-check">
                        <input type="checkbox"
                               name="Conditions"
                               value="LiverDisease" />
                        <span>Liver Disease</span>
                    </label>


                    <label class="medical-check">
                        <input type="checkbox"
                               name="Conditions"
                               value="Stroke" />
                        <span>Stroke</span>
                    </label>


                    <label class="medical-check">
                        <input type="checkbox"
                               name="Conditions"
                               value="Tuberculosis" />
                        <span>Tuberculosis</span>
                    </label>

                </div>


                <div class="mt-4">

                    <label class="smart-label">
                        Other Medical Conditions
                    </label>

                    <textarea name="OtherMedicalConditions"
                              class="form-control smart-input"
                              rows="4"
                              placeholder="Enter any other relevant medical conditions..."></textarea>

                </div>

            </div>


            <!-- MEDICATION -->
            <div class="smart-card medical-form-card mb-4">

                <div class="medical-form-card-header">

                    <div class="medical-form-title">

                        <div class="medical-form-icon">
                            <i class="bi bi-capsule-pill"></i>
                        </div>

                        <div>
                            <span>SECTION 05</span>
                            <h3>Current Medication</h3>
                        </div>

                    </div>

                </div>


                <label class="smart-label">
                    Medication currently being taken
                </label>

                <textarea name="CurrentMedication"
                          class="form-control smart-input"
                          rows="4"
                          placeholder="List medication, dosage and frequency where applicable..."></textarea>

            </div>


            <!-- ALLERGIES + SURGERIES -->
            <div class="row g-4 mb-4">

                <div class="col-md-6">

                    <div class="smart-card medical-form-card h-100">

                        <div class="medical-form-card-header">

                            <div class="medical-form-title">

                                <div class="medical-form-icon">
                                    <i class="bi bi-exclamation-triangle"></i>
                                </div>

                                <div>
                                    <span>SECTION 06</span>
                                    <h3>Allergies</h3>
                                </div>

                            </div>

                        </div>


                        <textarea name="Allergies"
                                  class="form-control smart-input"
                                  rows="6"
                                  placeholder="List known allergies and reactions..."></textarea>

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="smart-card medical-form-card h-100">

                        <div class="medical-form-card-header">

                            <div class="medical-form-title">

                                <div class="medical-form-icon">
                                    <i class="bi bi-bandaid"></i>
                                </div>

                                <div>
                                    <span>SECTION 07</span>
                                    <h3>Previous Surgeries</h3>
                                </div>

                            </div>

                        </div>


                        <textarea name="PreviousSurgeries"
                                  class="form-control smart-input"
                                  rows="6"
                                  placeholder="List previous surgeries and approximate dates if known..."></textarea>

                    </div>

                </div>

            </div>


            <!-- FAMILY HISTORY -->
            <div class="smart-card medical-form-card mb-4">

                <div class="medical-form-card-header">

                    <div class="medical-form-title">

                        <div class="medical-form-icon">
                            <i class="bi bi-people"></i>
                        </div>

                        <div>
                            <span>SECTION 08</span>
                            <h3>Family Medical History</h3>
                        </div>

                    </div>

                </div>


                <p class="medical-form-description">
                    Select conditions that have occurred in your immediate family.
                </p>


                <div class="medical-checkbox-grid family-history-grid">

                    <label class="medical-check">
                        <input type="checkbox"
                               name="FamilyHistory"
                               value="Cancer" />
                        <span>Cancer</span>
                    </label>


                    <label class="medical-check">
                        <input type="checkbox"
                               name="FamilyHistory"
                               value="Diabetes" />
                        <span>Diabetes</span>
                    </label>


                    <label class="medical-check">
                        <input type="checkbox"
                               name="FamilyHistory"
                               value="HeartDisease" />
                        <span>Heart Disease</span>
                    </label>


                    <label class="medical-check">
                        <input type="checkbox"
                               name="FamilyHistory"
                               value="Stroke" />
                        <span>Stroke</span>
                    </label>


                    <label class="medical-check">
                        <input type="checkbox"
                               name="FamilyHistory"
                               value="KidneyDisease" />
                        <span>Kidney Disease</span>
                    </label>


                    <label class="medical-check">
                        <input type="checkbox"
                               name="FamilyHistory"
                               value="MentalHealthConditions" />
                        <span>Mental Health Conditions</span>
                    </label>

                </div>

            </div>


            <!-- FORM ACTIONS -->
            <div class="medical-form-actions">

                <a asp-controller="Patient"
                       asp-action="Dashboard"
                       class="medical-cancel-button">

                    Cancel

                </a>

                <button type="submit"
                        class="smart-btn-primary">

                    <i class="bi bi-save me-2"></i>
                    Save Medical History

                </button>

            </div>

        </form>

    </div>


    <style>

            .patient-medical-form-page {
                padding-bottom: 80px;
            }


            /* HEADER */

            .medical-form-header {
                display: flex;
                align-items: flex-end;
                justify-content: space-between;
                gap: 30px;
            }


            .medical-form-back-link {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 10px 15px;
                border: 1px solid #e5e7eb;
                border-radius: 10px;
                background: #ffffff;
                color: #475569;
                font-size: 13px;
                font-weight: 700;
                text-decoration: none;
                transition: all 0.2s ease;
            }


                .medical-form-back-link:hover {
                    color: var(--primary);
                    border-color: rgba(15, 118, 110, 0.25);
                    background: #f0fdfa;
                }


            /* FORM CARDS */

            .medical-form-card {
                padding: 30px;
                border-radius: 20px;
            }


            .medical-form-card-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 28px;
                padding-bottom: 20px;
                border-bottom: 1px solid #eef2f7;
            }


            .medical-form-title {
                display: flex;
                align-items: center;
                gap: 14px;
            }


                .medical-form-title > div:last-child span {
                    display: block;
                    margin-bottom: 5px;
                    font-size: 10px;
                    font-weight: 800;
                    letter-spacing: 0.14em;
                    color: var(--primary);
                }


                .medical-form-title h3 {
                    margin: 0;
                    color: #111827;
                    font-size: 20px;
                    letter-spacing: -0.02em;
                }


            .medical-form-icon {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 44px;
                height: 44px;
                flex: 0 0 auto;
                border-radius: 13px;
                background: #f0fdfa;
                color: var(--primary);
                font-size: 19px;
            }


            .medical-form-description {
                margin: -8px 0 22px;
                color: #64748b;
                font-size: 13px;
                line-height: 1.6;
            }


            /* INPUTS */

            .smart-label {
                display: block;
                margin-bottom: 8px;
                color: #334155;
                font-size: 13px;
                font-weight: 700;
            }


            .smart-input {
                min-height: 48px;
                border-color: #dfe5eb;
                border-radius: 10px;
                color: #1f2937;
                font-size: 14px;
                box-shadow: none;
                transition: border-color 0.2s ease, box-shadow 0.2s ease;
            }


            textarea.smart-input {
                min-height: 120px;
                resize: vertical;
            }


            .smart-input:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.09);
            }


            .smart-input::placeholder {
                color: #94a3b8;
            }


            /* CHECKBOXES */

            .medical-checkbox-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 10px 14px;
            }


            .medical-check {
                display: flex;
                align-items: center;
                gap: 11px;
                min-height: 46px;
                padding: 10px 13px;
                border: 1px solid #e8edf2;
                border-radius: 10px;
                background: #ffffff;
                color: #475569;
                font-size: 13px;
                cursor: pointer;
                transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
            }


                .medical-check:hover {
                    border-color: rgba(15, 118, 110, 0.25);
                    background: #f8fffe;
                    color: #334155;
                }


                .medical-check input {
                    width: 17px;
                    height: 17px;
                    margin: 0;
                    accent-color: var(--primary);
                    cursor: pointer;
                }


                .medical-check:has(input:checked) {
                    border-color: rgba(15, 118, 110, 0.28);
                    background: #f0fdfa;
                    color: #134e4a;
                }


            /* ACTIONS */

            .medical-form-actions {
                display: flex;
                align-items: center;
                justify-content: flex-end;
                gap: 12px;
                padding-top: 8px;
            }


            .medical-cancel-button {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-height: 46px;
                padding: 0 20px;
                border: 1px solid #dfe5eb;
                border-radius: 10px;
                background: #ffffff;
                color: #64748b;
                font-size: 14px;
                font-weight: 700;
                text-decoration: none;
                transition: all 0.2s ease;
            }


                .medical-cancel-button:hover {
                    border-color: #cbd5e1;
                    background: #f8fafc;
                    color: #334155;
                }


            /* RESPONSIVE */

            @@media (max-width: 767.98px) {

                .medical-form-header {
                    display: block;
                }

                .medical-form-back-link {
                    margin-top: 18px;
                }

                .medical-form-card {
                    padding: 22px;
                }

                .medical-checkbox-grid {
                    grid-template-columns: 1fr;
                }

                .medical-form-actions {
                    flex-direction: column-reverse;
                    align-items: stretch;
                }

                    .medical-form-actions .smart-btn-primary,
                    .medical-cancel-button {
                        width: 100%;
                    }
            }

    </style>

</section>