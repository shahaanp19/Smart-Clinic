@{
    ViewData["Title"] = "Medical History Form";
}

<section class="page-section">
    <div class="container">

        <!-- Page Header -->
        <div class="mb-5">

            <span class="smart-badge">
                Patient Portal
            </span>

            <h1 class="dashboard-title mt-3">
                Medical History Form
            </h1>

            <p class="text-muted">
                Please complete your medical information accurately.
                This information assists healthcare professionals in
                providing safe and effective treatment.
            </p>

        </div>

        <!-- Patient Information -->
        <div class="smart-card mb-4">

            <h4 class="mb-4">
                <i class="bi bi-person-vcard me-2"></i>
                Patient Information
            </h4>

            <div class="row g-3">

                <div class="col-md-6">
                    <label class="smart-label">Full Name</label>
                    <input type="text" class="form-control smart-input" />
                </div>

                <div class="col-md-3">
                    <label class="smart-label">Date of Birth</label>
                    <input type="date" class="form-control smart-input" />
                </div>

                <div class="col-md-3">
                    <label class="smart-label">Gender</label>
                    <select class="form-select smart-input">
                        <option>Select Gender</option>
                        <option>Male</option>
                        <option>Female</option>
                        <option>Other</option>
                    </select>
                </div>

                <div class="col-md-8">
                    <label class="smart-label">Address</label>
                    <input type="text" class="form-control smart-input" />
                </div>

                <div class="col-md-4">
                    <label class="smart-label">Phone Number</label>
                    <input type="text" class="form-control smart-input" />
                </div>

            </div>

        </div>

        <!-- Emergency Contact -->
        <div class="smart-card mb-4">

            <h4 class="mb-4">
                <i class="bi bi-telephone-plus me-2"></i>
                Emergency Contact
            </h4>

            <div class="row g-3">

                <div class="col-md-4">
                    <label class="smart-label">Name</label>
                    <input type="text" class="form-control smart-input" />
                </div>

                <div class="col-md-4">
                    <label class="smart-label">Relationship</label>
                    <input type="text" class="form-control smart-input" />
                </div>

                <div class="col-md-4">
                    <label class="smart-label">Phone Number</label>
                    <input type="text" class="form-control smart-input" />
                </div>

            </div>

        </div>

        <!-- Insurance -->
        <div class="smart-card mb-4">

            <h4 class="mb-4">
                <i class="bi bi-shield-check me-2"></i>
                Medical Aid / Insurance Information
            </h4>

            <div class="row g-3">

                <div class="col-md-6">
                    <label class="smart-label">Medical Aid Provider</label>
                    <input type="text" class="form-control smart-input" />
                </div>

                <div class="col-md-6">
                    <label class="smart-label">Policy Number</label>
                    <input type="text" class="form-control smart-input" />
                </div>

            </div>

        </div>

        <!-- Medical Conditions -->
        <div class="smart-card mb-4">

            <h4 class="mb-4">
                <i class="bi bi-heart-pulse me-2"></i>
                Medical History
            </h4>

            <div class="row">

                <div class="col-md-6">

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox">
                        <label class="form-check-label">No Known Conditions</label>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox">
                        <label class="form-check-label">Allergies</label>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox">
                        <label class="form-check-label">Asthma</label>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox">
                        <label class="form-check-label">Diabetes</label>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox">
                        <label class="form-check-label">Epilepsy</label>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox">
                        <label class="form-check-label">Cancer</label>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox">
                        <label class="form-check-label">Depression</label>
                    </div>

                </div>

                <div class="col-md-6">

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox">
                        <label class="form-check-label">Heart Disease</label>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox">
                        <label class="form-check-label">High Blood Pressure</label>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox">
                        <label class="form-check-label">High Cholesterol</label>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox">
                        <label class="form-check-label">Kidney Disease</label>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox">
                        <label class="form-check-label">Liver Disease</label>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox">
                        <label class="form-check-label">Stroke</label>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox">
                        <label class="form-check-label">Tuberculosis</label>
                    </div>

                </div>

            </div>

            <div class="mt-4">

                <label class="smart-label">
                    Other Medical Conditions
                </label>

                <textarea class="form-control smart-input"
                          rows="3"></textarea>

            </div>

        </div>

        <!-- Medication -->
        <div class="smart-card mb-4">

            <h4 class="mb-4">
                <i class="bi bi-capsule-pill me-2"></i>
                Current Medication
            </h4>

            <textarea class="form-control smart-input"
                      rows="4"
                      placeholder="List any medication currently being taken"></textarea>

        </div>

        <!-- Allergies & Surgery -->
        <div class="row g-4 mb-4">

            <div class="col-md-6">

                <div class="smart-card h-100">

                    <h4 class="mb-3">
                        Allergies
                    </h4>

                    <textarea class="form-control smart-input"
                              rows="5"></textarea>

                </div>

            </div>

            <div class="col-md-6">

                <div class="smart-card h-100">

                    <h4 class="mb-3">
                        Previous Surgeries
                    </h4>

                    <textarea class="form-control smart-input"
                              rows="5"></textarea>

                </div>

            </div>

        </div>

        <!-- Family History -->
        <div class="smart-card mb-4">

            <h4 class="mb-4">
                <i class="bi bi-people me-2"></i>
                Family Medical History
            </h4>

            <div class="row">

                <div class="col-md-6">

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox">
                        <label class="form-check-label">Cancer</label>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox">
                        <label class="form-check-label">Diabetes</label>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox">
                        <label class="form-check-label">Heart Disease</label>
                    </div>

                </div>

                <div class="col-md-6">

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox">
                        <label class="form-check-label">Stroke</label>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox">
                        <label class="form-check-label">Kidney Disease</label>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox">
                        <label class="form-check-label">Mental Health Conditions</label>
                    </div>

                </div>

            </div>

        </div>

        <!-- Submit -->
        <div class="text-end">

            <button type="button" class="smart-btn-primary">
                <i class="bi bi-save me-2"></i>
                Save Medical History
            </button>

        </div>

    </div>
</section>