@{
    ViewData["Title"] = "Patient Dashboard";

    var patientName = User?.Identity?.IsAuthenticated == true
        ? User.Identity.Name
        : "Patient";
}

<section class="patient-dashboard-page">

    <div class="container-fluid py-4 py-lg-5">

        <!-- Header -->
        <div class="dashboard-header mb-4 mb-lg-5">

            <div>
                <div class="dashboard-eyebrow mb-2">
                    <i class="bi bi-person-heart me-2" aria-hidden="true"></i>
                    Patient Portal
                </div>

                <h1 class="display-6 fw-bold mb-2">
                    Welcome back, <span class="dashboard-name">@patientName</span>
                </h1>

                <p class="text-muted mb-0">
                    Manage your appointments, medical information and healthcare services
                    from one secure workspace.
                </p>
            </div>

            <div class="dashboard-header-actions d-flex flex-column flex-sm-row gap-2">

                <a asp-controller="Patient"
                       asp-action="MedicalHistory"
                       class="btn btn-outline-primary btn-lg">
                    <i class="bi bi-folder2-open me-2" aria-hidden="true"></i>
                    Medical History
                </a>

                <a asp-controller="Patient"
                       asp-action="BookAppointment"
                       class="btn btn-primary btn-lg">
                    <i class="bi bi-calendar-plus me-2" aria-hidden="true"></i>
                    Book Appointment
                </a>

            </div>

        </div>


        <!-- Patient Overview -->
        <section class="mb-4 mb-lg-5"
                 aria-labelledby="patient-overview-heading">

            <div class="mb-3">
                <h2 id="patient-overview-heading" class="h5 fw-bold mb-1">
                    Your Healthcare Overview
                </h2>

                <p class="text-muted small mb-0">
                    Access your most important patient services.
                </p>
            </div>

            <div class="row g-3 g-lg-4">

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="overview-card h-100">

                        <div class="overview-content">
                            <span class="overview-label">
                                Appointments
                            </span>

                            <strong class="overview-value">
                                View
                            </strong>

                            <span class="overview-description">
                                Manage your upcoming visits
                            </span>
                        </div>

                        <div class="overview-icon">
                            <i class="bi bi-calendar2-week" aria-hidden="true"></i>
                        </div>

                    </div>
                </div>


                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="overview-card h-100">

                        <div class="overview-content">
                            <span class="overview-label">
                                Medical History
                            </span>

                            <strong class="overview-value">
                                View
                            </strong>

                            <span class="overview-description">
                                Access your clinical records
                            </span>
                        </div>

                        <div class="overview-icon">
                            <i class="bi bi-file-medical" aria-hidden="true"></i>
                        </div>

                    </div>
                </div>


                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="overview-card h-100">

                        <div class="overview-content">
                            <span class="overview-label">
                                Notifications
                            </span>

                            <strong class="overview-value">
                                View
                            </strong>

                            <span class="overview-description">
                                Check healthcare updates
                            </span>
                        </div>

                        <div class="overview-icon">
                            <i class="bi bi-bell" aria-hidden="true"></i>
                        </div>

                    </div>
                </div>


                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="overview-card h-100">

                        <div class="overview-content">
                            <span class="overview-label">
                                Profile
                            </span>

                            <strong class="overview-value">
                                Manage
                            </strong>

                            <span class="overview-description">
                                Keep your information updated
                            </span>
                        </div>

                        <div class="overview-icon">
                            <i class="bi bi-person-vcard" aria-hidden="true"></i>
                        </div>

                    </div>
                </div>

            </div>

        </section>


        <!-- Main Workspace -->
        <div class="row g-4">

            <!-- Patient Workflows -->
            <div class="col-12 col-xl-8">

                <section class="workspace-panel h-100"
                         aria-labelledby="patient-workflow-heading">

                    <div class="workspace-panel-header">

                        <h2 id="patient-workflow-heading" class="h5 fw-bold mb-1">
                            Manage Your Care
                        </h2>

                        <p class="text-muted small mb-0">
                            Access the services and information available through your patient portal.
                        </p>

                    </div>


                    <div class="workflow-list">

                        <a asp-controller="Patient"
                               asp-action="BookAppointment"
                               class="workflow-item">

                            <div class="workflow-icon">
                                <i class="bi bi-calendar-plus" aria-hidden="true"></i>
                            </div>

                            <div class="workflow-content">

                                <h3 class="h6 fw-bold mb-1">
                                    Book Appointment
                                </h3>

                                <p class="text-muted small mb-0">
                                    Schedule an appointment with an available doctor.
                                </p>

                            </div>

                            <i class="bi bi-arrow-right workflow-arrow"
                               aria-hidden="true"></i>

                        </a>


                        <a asp-controller="Patient"
                               asp-action="MedicalHistory"
                               class="workflow-item">

                            <div class="workflow-icon">
                                <i class="bi bi-file-medical" aria-hidden="true"></i>
                            </div>

                            <div class="workflow-content">

                                <h3 class="h6 fw-bold mb-1">
                                    Medical History
                                </h3>

                                <p class="text-muted small mb-0">
                                    Review your medical records and healthcare history.
                                </p>

                            </div>

                            <i class="bi bi-arrow-right workflow-arrow"
                               aria-hidden="true"></i>

                        </a>


                        <a asp-controller="Patient"
                               asp-action="Notifications"
                               class="workflow-item">

                            <div class="workflow-icon">
                                <i class="bi bi-bell" aria-hidden="true"></i>
                            </div>

                            <div class="workflow-content">

                                <h3 class="h6 fw-bold mb-1">
                                    Notifications
                                </h3>

                                <p class="text-muted small mb-0">
                                    View appointment reminders and healthcare updates.
                                </p>

                            </div>

                            <i class="bi bi-arrow-right workflow-arrow"
                               aria-hidden="true"></i>

                        </a>


                        <a asp-controller="Patient"
                               asp-action="PatientIntakeForm"
                               class="workflow-item">

                            <div class="workflow-icon">
                                <i class="bi bi-person-vcard" aria-hidden="true"></i>
                            </div>

                            <div class="workflow-content">

                                <h3 class="h6 fw-bold mb-1">
                                    My Profile
                                </h3>

                                <p class="text-muted small mb-0">
                                    Review and maintain your patient information.
                                </p>

                            </div>

                            <i class="bi bi-arrow-right workflow-arrow"
                               aria-hidden="true"></i>

                        </a>


                        <a asp-controller="Patient"
                               asp-action="Settings"
                               class="workflow-item">

                            <div class="workflow-icon">
                                <i class="bi bi-gear" aria-hidden="true"></i>
                            </div>

                            <div class="workflow-content">

                                <h3 class="h6 fw-bold mb-1">
                                    Account Settings
                                </h3>

                                <p class="text-muted small mb-0">
                                    Manage your account and security preferences.
                                </p>

                            </div>

                            <i class="bi bi-arrow-right workflow-arrow"
                               aria-hidden="true"></i>

                        </a>

                    </div>

                </section>

            </div>


            <!-- Patient Status -->
            <div class="col-12 col-xl-4">

                <div class="d-flex flex-column gap-4">

                    <section class="status-card"
                             aria-labelledby="patient-security-heading">

                        <div class="status-card-header">

                            <div class="status-icon">
                                <i class="bi bi-shield-check" aria-hidden="true"></i>
                            </div>

                            <div>
                                <h2 id="patient-security-heading"
                                    class="h6 fw-bold mb-1">
                                    Secure Patient Workspace
                                </h2>

                                <p class="text-muted small mb-0">
                                    Your healthcare information is accessed through
                                    your authenticated patient account.
                                </p>
                            </div>

                        </div>

                        <div class="security-note">
                            <i class="bi bi-check-circle-fill me-2"
                               aria-hidden="true"></i>
                            Secure patient access enabled
                        </div>

                    </section>


                    <section class="status-card"
                             aria-labelledby="patient-record-heading">

                        <div class="mb-3">

                            <h2 id="patient-record-heading"
                                class="h6 fw-bold mb-1">
                                Healthcare Information
                            </h2>

                            <p class="text-muted small mb-0">
                                Your available patient services.
                            </p>

                        </div>

                        <div class="status-list">

                            <div class="status-row">
                                <span>
                                    Appointments
                                </span>

                                <strong>
                                    Available
                                </strong>
                            </div>

                            <div class="status-row">
                                <span>
                                    Medical records
                                </span>

                                <strong>
                                    Available
                                </strong>
                            </div>

                            <div class="status-row status-row-last">
                                <span>
                                    Notifications
                                </span>

                                <strong>
                                    Available
                                </strong>
                            </div>

                        </div>

                    </section>

                </div>

            </div>

        </div>

    </div>


    <!-- HEALTH ASSISTANT -->

    <div id="doctorBot">

        <div class="speech-bubble">
            Need Help?
        </div>

        <img src="~/images/Health Bot.png"
             alt="Health Assistant"
             class="doctor-avatar" />

    </div>


    <!-- CHAT WINDOW -->

    <div id="chatWindow">

        <div class="chat-header">

            <strong>
                Health Assistant
            </strong>

            <button id="closeChat"
                    type="button"
                    aria-label="Close health assistant">
                ×
            </button>

        </div>


        <div id="chatMessages">

            <div class="chat-message bot-message">

                <strong>
                    Health Assistant
                </strong>

                <p class="mb-0 mt-2">
                    Hello. How may I assist you today?
                </p>

            </div>

        </div>


        <div class="chat-input-area">

            <input type="text"
                   id="userQuestion"
                   placeholder="Type your question..."
                   autocomplete="off" />

            <button type="button"
                    onclick="sendMessage()">
                Send
            </button>

        </div>

    </div>


    <style>
            .patient-dashboard-page {
                min-height: calc(100vh - 70px);
                background: #f7fbff;
            }

            .dashboard-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 2rem;
                padding: 1.75rem 2rem;
                background: linear-gradient(135deg, #e7f5ff 0%, #f5fbff 100%);
                border: 1px solid #d5ebf9;
                border-radius: 1.25rem;
                box-shadow: 0 0.35rem 1.25rem rgba(31, 91, 122, 0.06);
            }

            .dashboard-eyebrow {
                display: inline-flex;
                align-items: center;
                color: #0b6fa4;
                font-size: 0.8rem;
                font-weight: 700;
                letter-spacing: 0.04em;
                text-transform: uppercase;
            }

            .dashboard-name {
                color: #1479ad;
            }

            .overview-card {
                position: relative;
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                min-height: 165px;
                padding: 1.5rem;
                overflow: hidden;
                background: linear-gradient(135deg, #e4f4ff 0%, #f4faff 100%);
                border: 1px solid #cfe7f6;
                border-radius: 1.15rem;
                box-shadow: 0 0.35rem 1.25rem rgba(31, 91, 122, 0.07);
                transition: transform 0.2s ease, box-shadow 0.2s ease;
            }

                .overview-card:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 0.7rem 1.5rem rgba(31, 91, 122, 0.11);
                }

            .overview-content {
                display: flex;
                flex-direction: column;
            }

            .overview-label {
                color: #526b7a;
                font-size: 0.85rem;
                font-weight: 700;
            }

            .overview-value {
                margin-top: 0.4rem;
                color: #123b53;
                font-size: 1.8rem;
                line-height: 1.1;
                font-weight: 800;
            }

            .overview-description {
                margin-top: 0.55rem;
                color: #66808f;
                font-size: 0.78rem;
            }

            .overview-icon,
            .workflow-icon,
            .status-icon {
                display: flex;
                align-items: center;
                justify-content: center;
                flex: 0 0 auto;
                color: #1479ad;
                background: #e7f5ff;
                border: 1px solid #d2ebf9;
            }

            .overview-icon {
                width: 58px;
                height: 58px;
                border-radius: 50%;
                font-size: 1.4rem;
            }

            .workspace-panel,
            .status-card {
                background: #ffffff;
                border: 1px solid #dfedf5;
                border-radius: 1.15rem;
                box-shadow: 0 0.35rem 1.25rem rgba(31, 91, 122, 0.06);
            }

            .workspace-panel-header {
                padding: 1.5rem 1.5rem 1.15rem;
                border-bottom: 1px solid #eaf2f6;
            }

            .workflow-list {
                padding: 0.5rem 1rem 1rem;
            }

            .workflow-item {
                display: flex;
                align-items: center;
                gap: 1rem;
                padding: 1.15rem 0.75rem;
                color: inherit;
                text-decoration: none;
                border-bottom: 1px solid #eaf2f6;
                border-radius: 0.75rem;
                transition: background-color 0.2s ease, padding-left 0.2s ease;
            }

                .workflow-item:last-child {
                    border-bottom: 0;
                }

                .workflow-item:hover {
                    padding-left: 1rem;
                    background: #eef8ff;
                }

                .workflow-item:focus-visible {
                    outline: 3px solid rgba(13, 110, 253, 0.2);
                    outline-offset: 2px;
                }

            .workflow-icon {
                width: 48px;
                height: 48px;
                border-radius: 0.8rem;
                font-size: 1.2rem;
            }

            .workflow-content {
                flex: 1;
                min-width: 0;
            }

            .workflow-arrow {
                color: #7d9aaa;
                font-size: 1rem;
                transition: transform 0.2s ease, color 0.2s ease;
            }

            .workflow-item:hover .workflow-arrow {
                color: #0d6efd;
                transform: translateX(3px);
            }

            .status-card {
                padding: 1.5rem;
            }

            .status-card-header {
                display: flex;
                align-items: flex-start;
                gap: 1rem;
            }

            .status-icon {
                width: 48px;
                height: 48px;
                border-radius: 50%;
                font-size: 1.15rem;
            }

            .security-note {
                margin-top: 1.25rem;
                padding: 0.8rem 1rem;
                color: #176b4d;
                background: #edf9f4;
                border: 1px solid #d4eee2;
                border-radius: 0.7rem;
                font-size: 0.82rem;
                font-weight: 600;
            }

            .status-list {
                border-top: 1px solid #edf3f7;
            }

            .status-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                padding: 0.9rem 0;
                color: #627985;
                font-size: 0.85rem;
                border-bottom: 1px solid #edf3f7;
            }

                .status-row strong {
                    color: #173d51;
                    font-size: 0.85rem;
                }

            .status-row-last {
                border-bottom: 0;
            }

            #doctorBot {
                position: fixed;
                right: 24px;
                bottom: 24px;
                z-index: 1000;
                cursor: pointer;
            }

            .doctor-avatar {
                width: 64px;
                height: 64px;
                object-fit: contain;
                filter: drop-shadow(0 6px 14px rgba(15, 23, 42, 0.18));
            }

            .speech-bubble {
                position: absolute;
                right: 0;
                bottom: 72px;
                padding: 8px 12px;
                color: #123b53;
                background: #ffffff;
                border: 1px solid #d9eaf4;
                border-radius: 10px;
                box-shadow: 0 5px 18px rgba(15, 23, 42, 0.1);
                font-size: 12px;
                font-weight: 700;
                white-space: nowrap;
            }

            #chatWindow {
                position: fixed;
                right: 24px;
                bottom: 100px;
                z-index: 1001;
                display: none;
                flex-direction: column;
                width: min(360px, calc(100vw - 32px));
                max-height: 520px;
                overflow: hidden;
                background: #ffffff;
                border: 1px solid #d9eaf4;
                border-radius: 16px;
                box-shadow: 0 18px 45px rgba(15, 23, 42, 0.18);
            }

            .chat-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 14px 16px;
                color: #ffffff;
                background: #1479ad;
            }

            #closeChat {
                border: 0;
                background: transparent;
                color: #ffffff;
                font-size: 24px;
                line-height: 1;
            }

            #chatMessages {
                padding: 14px;
                overflow-y: auto;
            }

            .chat-message {
                margin-bottom: 10px;
                padding: 10px 12px;
                border-radius: 10px;
                font-size: 13px;
            }

            .bot-message {
                background: #eef8ff;
                color: #28495b;
            }

            .user-message {
                background: #f1f5f9;
                color: #334155;
            }

            .chat-input-area {
                display: flex;
                gap: 8px;
                padding: 12px;
                border-top: 1px solid #e5edf2;
            }

                .chat-input-area input {
                    min-width: 0;
                    flex: 1;
                    padding: 9px 11px;
                    border: 1px solid #d7e3ea;
                    border-radius: 8px;
                }

                .chat-input-area button {
                    padding: 9px 14px;
                    border: 0;
                    border-radius: 8px;
                    background: #1479ad;
                    color: #ffffff;
                    font-weight: 600;
                }
    </style>


    <script>
            const doctorBot = document.getElementById("doctorBot");
            const chatWindow = document.getElementById("chatWindow");
            const closeChat = document.getElementById("closeChat");

            if (doctorBot && chatWindow) {
                doctorBot.addEventListener("click", function () {
                    chatWindow.style.display = "flex";
                });
            }

            if (closeChat && chatWindow) {
                closeChat.addEventListener("click", function () {
                    chatWindow.style.display = "none";
                });
            }

            function sendMessage() {
                const input = document.getElementById("userQuestion");
                const question = input.value.trim();

                if (question === "") {
                    return;
                }

                const chatMessages = document.getElementById("chatMessages");

                const userMessage = document.createElement("div");
                userMessage.className = "chat-message user-message";

                const userTitle = document.createElement("strong");
                userTitle.textContent = "You";

                const userText = document.createElement("p");
                userText.className = "mb-0 mt-2";
                userText.textContent = question;

                userMessage.appendChild(userTitle);
                userMessage.appendChild(userText);
                chatMessages.appendChild(userMessage);

                const q = question.toLowerCase();

                let response =
                    "I am unable to answer that question at the moment. Please contact the medical centre for further assistance.";

                if (
                    q.includes("chest pain") ||
                    q.includes("difficulty breathing") ||
                    q.includes("cant breathe") ||
                    q.includes("stroke") ||
                    q.includes("bleeding heavily")
                ) {
                    response =
                        "This may require urgent medical attention. Please seek emergency medical care immediately.";
                }
                else if (
                    q.includes("book appointment") ||
                    q.includes("book an appointment")
                ) {
                    response =
                        "You can book an appointment using the Book Appointment option on your patient dashboard.";
                }
                else if (
                    q.includes("medical history") ||
                    q.includes("medical records")
                ) {
                    response =
                        "Your medical information can be accessed from the Medical History section of your patient portal.";
                }
                else if (q.includes("notifications")) {
                    response =
                        "You can view your notifications from the Notifications section of your patient portal.";
                }
                else if (
                    q.includes("change password") ||
                    q.includes("password")
                ) {
                    response =
                        "You can manage your account settings from the Settings section of your patient portal.";
                }

                setTimeout(function () {
                    const botMessage = document.createElement("div");
                    botMessage.className = "chat-message bot-message";

                    const botTitle = document.createElement("strong");
                    botTitle.textContent = "Health Assistant";

                    const botText = document.createElement("p");
                    botText.className = "mb-0 mt-2";
                    botText.textContent = response;

                    botMessage.appendChild(botTitle);
                    botMessage.appendChild(botText);
                    chatMessages.appendChild(botMessage);

                    chatMessages.scrollTop = chatMessages.scrollHeight;
                }, 400);

                input.value = "";
            }

            const questionInput = document.getElementById("userQuestion");

            if (questionInput) {
                questionInput.addEventListener("keypress", function (event) {
                    if (event.key === "Enter") {
                        sendMessage();
                    }
                });
            }
    </script>

</section>