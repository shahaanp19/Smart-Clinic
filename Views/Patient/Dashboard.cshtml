@{
    ViewData["Title"] = "Patient Dashboard";

    var patientName = User?.Identity?.IsAuthenticated == true
        ? User.Identity.Name
        : "Patient";
}

<section class="page-section patient-dashboard-page">

    <div class="container">

        <!-- WELCOME -->
        <div class="patient-welcome-card mb-5">

            <div class="patient-welcome-content">

                <div class="patient-welcome-label">
                    <span></span>
                    Patient Portal
                </div>

                <h1>
                    Welcome back,
                    <strong>@patientName</strong>
                </h1>

                <p>
                    Manage your appointments, medical information and
                    healthcare services from one secure place.
                </p>

                <a asp-controller="Patient"
                       asp-action="BookAppointment"
                       class="smart-btn-primary text-decoration-none">

                    <i class="bi bi-calendar-plus"></i>
                    Book Appointment
                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>

            <div class="patient-welcome-pattern">
                <span></span>
                <span></span>
                <span></span>
            </div>

        </div>


        <!-- QUICK ACCESS -->
        <div class="patient-dashboard-section mb-5">

            <div class="patient-section-heading">

                <div>
                    <span>QUICK ACCESS</span>
                    <h2>Manage your care</h2>
                </div>

                <p>
                    Everything you need, right at your fingertips.
                </p>

            </div>


            <div class="row g-3">

                <div class="col-6 col-md-4 col-lg-2">

                    <a asp-controller="Patient"
                           asp-action="BookAppointment"
                           class="patient-action-card text-decoration-none">

                        <strong>
                            Book Appointment
                        </strong>

                        <i class="bi bi-arrow-up-right patient-action-arrow"></i>

                    </a>

                </div>


                <div class="col-6 col-md-4 col-lg-2">

                    <a asp-controller="Patient"
                           asp-action="MedicalHistory"
                           class="patient-action-card text-decoration-none">

                        <strong>
                            Medical History
                        </strong>

                        <i class="bi bi-arrow-up-right patient-action-arrow"></i>

                    </a>

                </div>


                <div class="col-6 col-md-4 col-lg-2">

                    <a asp-controller="Patient"
                           asp-action="Notifications"
                           class="patient-action-card text-decoration-none">

                        <strong>
                            Notifications
                        </strong>

                        <i class="bi bi-arrow-up-right patient-action-arrow"></i>

                    </a>

                </div>


                <div class="col-6 col-md-4 col-lg-2">

                    <a asp-controller="Patient"
                           asp-action="PatientIntakeForm"
                           class="patient-action-card text-decoration-none">

                        <strong>
                            My Profile
                        </strong>

                        <i class="bi bi-arrow-up-right patient-action-arrow"></i>

                    </a>

                </div>


                <div class="col-6 col-md-4 col-lg-2">

                    <a asp-controller="Patient"
                           asp-action="Settings"
                           class="patient-action-card text-decoration-none">

                        <strong>
                            Settings
                        </strong>

                        <i class="bi bi-arrow-up-right patient-action-arrow"></i>

                    </a>

                </div>


                <div class="col-6 col-md-4 col-lg-2">

                    <a asp-controller="Patient"
                           asp-action="MedicalHistory"
                           class="patient-action-card text-decoration-none">

                        <strong>
                            Records
                        </strong>

                        <i class="bi bi-arrow-up-right patient-action-arrow"></i>

                    </a>

                </div>

            </div>

        </div>


        <!-- APPOINTMENTS + RECORDS -->
        <div class="row g-4 mb-5">

            <!-- APPOINTMENTS -->
            <div class="col-lg-7">

                <div class="patient-content-card h-100">

                    <div class="patient-card-heading">

                        <div>
                            <span class="patient-card-label">
                                YOUR CARE
                            </span>

                            <h3>
                                Upcoming appointments
                            </h3>
                        </div>

                        <a asp-controller="Patient"
                               asp-action="BookAppointment"
                               class="patient-text-link">

                            Book
                            <i class="bi bi-arrow-up-right"></i>

                        </a>

                    </div>


                    <div class="patient-empty-state">

                        <div>

                            <h4>
                                No upcoming appointments
                            </h4>

                            <p>
                                When you have an upcoming appointment,
                                the details will appear here.
                            </p>

                            <a asp-controller="Patient"
                                   asp-action="BookAppointment"
                                   class="patient-outline-button text-decoration-none">

                                <i class="bi bi-calendar-plus"></i>
                                Book an appointment

                            </a>

                        </div>

                    </div>

                </div>

            </div>


            <!-- RECORDS -->
            <div class="col-lg-5">

                <div class="patient-content-card h-100">

                    <div class="patient-card-heading">

                        <div>
                            <span class="patient-card-label">
                                HEALTHCARE
                            </span>

                            <h3>
                                Medical records
                            </h3>
                        </div>

                        <a asp-controller="Patient"
                               asp-action="MedicalHistory"
                               class="patient-text-link">

                            View
                            <i class="bi bi-arrow-up-right"></i>

                        </a>

                    </div>


                    <div class="patient-simple-empty-state">

                        <h4>
                            No records available
                        </h4>

                        <p>
                            Your medical records will appear here once
                            they have been added to your profile.
                        </p>

                        <a asp-controller="Patient"
                               asp-action="MedicalHistory"
                               class="patient-outline-button text-decoration-none">

                            View Medical History

                        </a>

                    </div>

                </div>

            </div>

        </div>


        <!-- NOTIFICATIONS -->
        <div class="patient-content-card mb-5">

            <div class="patient-card-heading">

                <div>
                    <span class="patient-card-label">
                        UPDATES
                    </span>

                    <h3>
                        Notifications
                    </h3>
                </div>

                <a asp-controller="Patient"
                       asp-action="Notifications"
                       class="patient-text-link">

                    View all
                    <i class="bi bi-arrow-up-right"></i>

                </a>

            </div>


            <div class="patient-notification-empty">

                <div>
                    <strong>
                        You're all caught up
                    </strong>

                    <p>
                        New appointment reminders and healthcare updates
                        will appear here.
                    </p>
                </div>

            </div>

        </div>

    </div>


    <!-- HEALTH ASSISTANT -->
    <div id="doctorBot">

        <div class="speech-bubble">
            Need Help?
        </div>

        <img src="~/images/Health Bot.png"
             alt="Health Assistant"
             class="doctor-avatar" />

    </div>


    <!-- CHAT WINDOW -->
    <div id="chatWindow">

        <div class="chat-header">

            <strong>
                Health Assistant
            </strong>

            <button id="closeChat"
                    type="button"
                    aria-label="Close health assistant">

                ×

            </button>

        </div>


        <div id="chatMessages">

            <div class="chat-message bot-message">

                <strong>
                    Health Assistant
                </strong>

                <p class="mb-0 mt-2">
                    Hello. How may I assist you today?
                </p>

            </div>

        </div>


        <div class="chat-input-area">

            <input type="text"
                   id="userQuestion"
                   placeholder="Type your question..."
                   autocomplete="off" />

            <button type="button"
                    onclick="sendMessage()">

                Send

            </button>

        </div>

    </div>


    <style>

            .patient-dashboard-page {
                padding-bottom: 80px;
            }


            /* WELCOME */

            .patient-welcome-card {
                position: relative;
                overflow: hidden;
                min-height: 300px;
                display: flex;
                align-items: center;
                padding: 52px 58px;
                border-radius: 24px;
                background: linear-gradient( 135deg, #f0fdfa 0%, #ffffff 58%, #f8fafc 100% );
                border: 1px solid rgba(15, 118, 110, 0.10);
                box-shadow: 0 18px 45px rgba(15, 23, 42, 0.07);
            }


            .patient-welcome-content {
                position: relative;
                z-index: 2;
                max-width: 720px;
            }


            .patient-welcome-label {
                display: inline-flex;
                align-items: center;
                gap: 9px;
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 0.14em;
                text-transform: uppercase;
                color: var(--primary);
            }


                .patient-welcome-label span {
                    width: 8px;
                    height: 8px;
                    border-radius: 50%;
                    background: var(--primary);
                }


            .patient-welcome-card h1 {
                margin: 16px 0 12px;
                font-size: clamp(32px, 4vw, 48px);
                line-height: 1.1;
                letter-spacing: -0.04em;
                color: #111827;
            }


                .patient-welcome-card h1 strong {
                    color: var(--primary);
                    font-weight: 700;
                }


            .patient-welcome-card p {
                max-width: 650px;
                margin-bottom: 28px;
                font-size: 16px;
                line-height: 1.7;
                color: #64748b;
            }


            .patient-welcome-pattern {
                position: absolute;
                right: -80px;
                top: -90px;
                width: 360px;
                height: 360px;
                border-radius: 50%;
                border: 70px solid rgba(15, 118, 110, 0.05);
            }


                .patient-welcome-pattern span {
                    position: absolute;
                    display: block;
                    border-radius: 50%;
                    border: 1px solid rgba(15, 118, 110, 0.08);
                }


                    .patient-welcome-pattern span:nth-child(1) {
                        width: 180px;
                        height: 180px;
                        top: 20px;
                        left: 20px;
                    }


                    .patient-welcome-pattern span:nth-child(2) {
                        width: 110px;
                        height: 110px;
                        top: 55px;
                        left: 55px;
                    }


                    .patient-welcome-pattern span:nth-child(3) {
                        width: 40px;
                        height: 40px;
                        top: 90px;
                        left: 90px;
                        background: rgba(15, 118, 110, 0.08);
                        border: none;
                    }


            /* QUICK ACCESS */

            .patient-section-heading {
                display: flex;
                align-items: end;
                justify-content: space-between;
                gap: 30px;
                margin-bottom: 22px;
            }


                .patient-section-heading span {
                    display: block;
                    margin-bottom: 6px;
                    font-size: 11px;
                    font-weight: 800;
                    letter-spacing: 0.15em;
                    color: var(--primary);
                }


                .patient-section-heading h2 {
                    margin: 0;
                    font-size: 28px;
                    letter-spacing: -0.025em;
                    color: #111827;
                }


                .patient-section-heading p {
                    margin: 0;
                    color: #64748b;
                    font-size: 14px;
                }


            .patient-action-card {
                position: relative;
                min-height: 115px;
                display: flex;
                align-items: flex-end;
                padding: 20px;
                border-radius: 16px;
                background: #ffffff;
                border: 1px solid #e5e7eb;
                box-shadow: 0 7px 24px rgba(15, 23, 42, 0.04);
                transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
            }


                .patient-action-card:hover {
                    transform: translateY(-5px);
                    border-color: rgba(15, 118, 110, 0.25);
                    box-shadow: 0 16px 32px rgba(15, 23, 42, 0.09);
                }


                .patient-action-card strong {
                    display: block;
                    max-width: 125px;
                    font-size: 14px;
                    line-height: 1.35;
                    color: #1f2937;
                }


                .patient-action-card:hover strong {
                    color: #1f2937;
                }


            .patient-action-arrow {
                position: absolute;
                right: 18px;
                top: 20px;
                font-size: 14px;
                color: #94a3b8;
                transition: color 0.2s ease, transform 0.2s ease;
            }


            .patient-action-card:hover .patient-action-arrow {
                color: var(--primary);
                transform: translate(2px, -2px);
            }


            /* CONTENT CARDS */

            .patient-content-card {
                padding: 30px;
                border-radius: 20px;
                background: #ffffff;
                border: 1px solid #e5e7eb;
                box-shadow: 0 9px 30px rgba(15, 23, 42, 0.05);
            }


            .patient-card-heading {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                gap: 20px;
                padding-bottom: 22px;
                border-bottom: 1px solid #eef2f7;
            }


            .patient-card-label {
                display: block;
                margin-bottom: 6px;
                font-size: 10px;
                font-weight: 800;
                letter-spacing: 0.14em;
                color: var(--primary);
            }


            .patient-card-heading h3 {
                margin: 0;
                font-size: 21px;
                letter-spacing: -0.02em;
                color: #111827;
            }


            .patient-text-link {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                padding-top: 3px;
                color: var(--primary);
                font-size: 13px;
                font-weight: 700;
                text-decoration: none;
                white-space: nowrap;
            }


                .patient-text-link:hover {
                    color: var(--primary);
                }


            /* EMPTY STATES */

            .patient-empty-state {
                min-height: 245px;
                display: flex;
                align-items: center;
                padding: 25px 5px 5px;
            }


                .patient-empty-state h4,
                .patient-simple-empty-state h4 {
                    margin-bottom: 8px;
                    font-size: 17px;
                    color: #1f2937;
                }


                .patient-empty-state p,
                .patient-simple-empty-state p {
                    max-width: 500px;
                    margin-bottom: 18px;
                    font-size: 14px;
                    line-height: 1.6;
                    color: #64748b;
                }


            .patient-simple-empty-state {
                min-height: 245px;
                display: flex;
                flex-direction: column;
                align-items: flex-start;
                justify-content: center;
                padding-top: 15px;
            }


            .patient-outline-button {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 9px 14px;
                border: 1px solid rgba(15, 118, 110, 0.2);
                border-radius: 9px;
                background: #ffffff;
                color: var(--primary);
                font-size: 13px;
                font-weight: 700;
                transition: all 0.2s ease;
            }


                .patient-outline-button:hover {
                    background: #f0fdfa;
                    color: var(--primary);
                    border-color: rgba(15, 118, 110, 0.35);
                }


            /* NOTIFICATIONS */

            .patient-notification-empty {
                margin-top: 22px;
                padding: 20px;
                border-radius: 14px;
                background: #f8fafc;
                border: 1px solid #eef2f7;
            }


                .patient-notification-empty strong {
                    display: block;
                    margin-bottom: 4px;
                    color: #1f2937;
                    font-size: 14px;
                }


                .patient-notification-empty p {
                    margin: 0;
                    color: #64748b;
                    font-size: 13px;
                }


            /* MOBILE */

            @@media (max-width: 767.98px) {

                .patient-welcome-card {
                    min-height: auto;
                    padding: 34px 26px;
                }

                .patient-welcome-pattern {
                    right: -170px;
                    opacity: 0.6;
                }

                .patient-section-heading {
                    display: block;
                }

                    .patient-section-heading p {
                        margin-top: 8px;
                    }

                .patient-content-card {
                    padding: 22px;
                }

                .patient-empty-state {
                    min-height: auto;
                    padding-top: 25px;
                }

                .patient-simple-empty-state {
                    min-height: auto;
                    padding-top: 25px;
                }
            }

    </style>


    <script>

            const doctorBot =
                document.getElementById("doctorBot");

            const chatWindow =
                document.getElementById("chatWindow");

            const closeChat =
                document.getElementById("closeChat");


            if (doctorBot && chatWindow) {

                doctorBot.addEventListener("click", function () {

                    chatWindow.style.display = "flex";

                });

            }


            if (closeChat && chatWindow) {

                closeChat.addEventListener("click", function () {

                    chatWindow.style.display = "none";

                });

            }


            function sendMessage() {

                const input =
                    document.getElementById("userQuestion");

                const question =
                    input.value.trim();

                if (question === "")
                    return;


                const chatMessages =
                    document.getElementById("chatMessages");


                const userMessage =
                    document.createElement("div");

                userMessage.className =
                    "chat-message user-message";


                const userTitle =
                    document.createElement("strong");

                userTitle.textContent =
                    "You";


                const userText =
                    document.createElement("p");

                userText.className =
                    "mb-0 mt-2";

                userText.textContent =
                    question;


                userMessage.appendChild(userTitle);
                userMessage.appendChild(userText);

                chatMessages.appendChild(userMessage);


                const q =
                    question.toLowerCase();


                let response =
                    "I am unable to answer that question at the moment. Please contact the medical centre for further assistance.";


                if (
                    q.includes("chest pain") ||
                    q.includes("difficulty breathing") ||
                    q.includes("cant breathe") ||
                    q.includes("stroke") ||
                    q.includes("bleeding heavily")
                ) {

                    response =
                        "This may require urgent medical attention. Please seek emergency medical care immediately.";

                }

                else if (
                    q.includes("book appointment") ||
                    q.includes("book an appointment")
                ) {

                    response =
                        "You can book an appointment using the Book Appointment option on your patient dashboard.";

                }

                else if (
                    q.includes("medical history") ||
                    q.includes("medical records")
                ) {

                    response =
                        "Your medical information can be accessed from the Medical History section of your patient portal.";

                }

                else if (q.includes("notifications")) {

                    response =
                        "You can view your notifications from the Notifications section of your patient portal.";

                }

                else if (
                    q.includes("change password") ||
                    q.includes("password")
                ) {

                    response =
                        "You can manage your account settings from the Settings section of your patient portal.";

                }


                setTimeout(function () {

                    const botMessage =
                        document.createElement("div");

                    botMessage.className =
                        "chat-message bot-message";


                    const botTitle =
                        document.createElement("strong");

                    botTitle.textContent =
                        "Health Assistant";


                    const botText =
                        document.createElement("p");

                    botText.className =
                        "mb-0 mt-2";

                    botText.textContent =
                        response;


                    botMessage.appendChild(botTitle);
                    botMessage.appendChild(botText);

                    chatMessages.appendChild(botMessage);

                    chatMessages.scrollTop =
                        chatMessages.scrollHeight;

                }, 400);


                input.value = "";

            }


            const questionInput =
                document.getElementById("userQuestion");


            if (questionInput) {

                questionInput.addEventListener(
                    "keypress",
                    function (event) {

                        if (event.key === "Enter") {

                            sendMessage();

                        }

                    }
                );

            }

    </script>

</section>