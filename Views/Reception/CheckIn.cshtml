@{
    ViewData["Title"] = "Patient Check-In";
}

<section class="page-section">
    <div class="container">

        <!-- Header -->

        <div class="smart-card mb-5">

            <span class="smart-badge">
                Reception Dashboard
            </span>

            <h1 class="dashboard-title mt-3">
                Patient Check-In
            </h1>

            <p class="text-muted mb-0">
                Verify appointment details and assign the patient to the clinic queue.
            </p>

        </div>

        <!-- Check-In Progress -->

        <div class="smart-card mb-5">

            <div class="section-header">
                <h4>Check-In Progress</h4>
            </div>

            <div class="row text-center">

                <div class="col-md-4">
                    <i class="bi bi-search fs-2 text-primary"></i>
                    <p class="mt-2 mb-0 fw-bold">Verify Appointment</p>
                </div>

                <div class="col-md-4">
                    <i class="bi bi-person-check fs-2 text-primary"></i>
                    <p class="mt-2 mb-0 fw-bold">Confirm Arrival</p>
                </div>

                <div class="col-md-4">
                    <i class="bi bi-ticket-perforated fs-2 text-primary"></i>
                    <p class="mt-2 mb-0 fw-bold">Assign Queue Number</p>
                </div>

            </div>

        </div>

        <!-- Main Content -->

        <div class="row g-4">

            <!-- Left Side -->

            <div class="col-lg-7">

                <!-- Appointment Details -->

                <div class="smart-card">

                    <div class="section-header">
                        <h4>Appointment Verification</h4>
                    </div>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="smart-label">Appointment ID</label>
                            <input class="form-control smart-input"
                                   value="APT-10024" />
                        </div>

                        <div class="col-md-6">
                            <label class="smart-label">Patient Name</label>
                            <input class="form-control smart-input"
                                   value="Sarah Jacobs" />
                        </div>

                        <div class="col-md-6">
                            <label class="smart-label">Doctor</label>
                            <input class="form-control smart-input"
                                   value="Dr Esmé Cilliers" />
                        </div>

                        <div class="col-md-6">
                            <label class="smart-label">Appointment Time</label>
                            <input class="form-control smart-input"
                                   value="09:00" />
                        </div>

                        <div class="col-md-6">
                            <label class="smart-label">Service</label>
                            <input class="form-control smart-input"
                                   value="General Consultation" />
                        </div>

                        <div class="col-md-6">
                            <label class="smart-label">Status</label>
                            <input class="form-control smart-input"
                                   value="Confirmed" />
                        </div>

                    </div>

                    <div class="mt-4 d-flex flex-wrap gap-3">

                        <button type="button"
                                class="smart-btn-primary">

                            <i class="bi bi-check-circle me-2"></i>
                            Confirm Check-In

                        </button>

                        <button type="button"
                                class="smart-btn-accent">

                            <i class="bi bi-ticket-perforated me-2"></i>
                            Generate Queue Number

                        </button>

                        <a asp-controller="Reception"
                               asp-action="Dashboard"
                               class="btn btn-outline-secondary rounded-3 px-4">

                            Back

                        </a>

                    </div>

                </div>

                <!-- Contact Information -->

                <div class="smart-card mt-4">

                    <div class="section-header">
                        <h4>Patient Information</h4>
                    </div>

                    <div class="row g-3">

                        <div class="col-md-4">

                            <div class="mini-service-card">

                                <strong>Phone</strong>

                                <p>082 555 0147</p>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="mini-service-card">

                                <strong>Email</strong>

                                <p>sarah.jacobs@email.com</p>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="mini-service-card">

                                <strong>Emergency Contact</strong>

                                <p>Mark Jacobs</p>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Right Side -->

            <div class="col-lg-5">

                <!-- Queue Card -->

                <div class="smart-card">

                    <div class="section-header">
                        <h4>Queue Allocation</h4>
                    </div>

                    <div class="queue-preview">

                        <span>Assigned Queue Number</span>

                        <h2>Q001</h2>

                        <p>
                            Patient successfully added to today's queue.
                        </p>

                    </div>

                    <div class="summary-item">
                        <span>Queue Status</span>
                        <strong>Waiting</strong>
                    </div>

                    <div class="summary-item">
                        <span>Priority</span>
                        <strong>Normal</strong>
                    </div>

                    <div class="summary-item border-0">
                        <span>Estimated Wait</span>
                        <strong>15 Minutes</strong>
                    </div>

                </div>

                <!-- Appointment Summary -->

                <div class="smart-card mt-4">

                    <div class="section-header">
                        <h4>Appointment Summary</h4>
                    </div>

                    <p class="mb-2">
                        <strong>Date:</strong> 12 May 2026
                    </p>

                    <p class="mb-2">
                        <strong>Time:</strong> 09:00
                    </p>

                    <p class="mb-2">
                        <strong>Doctor:</strong> Dr Esmé Cilliers
                    </p>

                    <p class="mb-0">
                        <strong>Service:</strong> General Consultation
                    </p>

                </div>

            </div>

        </div>

    </div>
</section>