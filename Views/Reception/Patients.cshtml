@using SmartClinicManagementSystem.DTOs
@model IReadOnlyList<PatientDto>

@{
    ViewData["Title"] = "Patient Directory";

    var patients = Model ?? Array.Empty<PatientDto>();
    var totalPatients = patients.Count;
    var patientsWithEmail = patients.Count(p =>
        !string.IsNullOrWhiteSpace(p.Email));
    var patientsWithGender = patients.Count(p =>
        !string.IsNullOrWhiteSpace(p.Gender));

    var searchId = "patient-search";
}

<div class="container-fluid px-0">

    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
        <div>
            <div class="text-uppercase small fw-semibold text-primary mb-1">
                Reception
            </div>

            <h1 class="h2 fw-bold mb-1">
                Patient Directory
            </h1>

            <p class="text-muted mb-0">
                Search, review and manage active patient records.
            </p>
        </div>

        <a asp-controller="Reception"
               asp-action="RegisterPatient"
               class="btn btn-primary">
            <i class="bi bi-person-plus me-2" aria-hidden="true"></i>
            Register Patient
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm"
             role="alert">
            <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>
            @successMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Dismiss notification"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm"
             role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"
               aria-hidden="true"></i>
            @errorMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Dismiss notification"></button>
        </div>
    }

    <div class="row g-3 mb-4">

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">
                                Active Patients
                            </div>

                            <div class="display-6 fw-bold mt-2">
                                @totalPatients
                            </div>
                        </div>

                        <div class="rounded-3 bg-primary-subtle text-primary p-3">
                            <i class="bi bi-people fs-4" aria-hidden="true"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">
                                Email Profiles
                            </div>

                            <div class="display-6 fw-bold mt-2">
                                @patientsWithEmail
                            </div>
                        </div>

                        <div class="rounded-3 bg-success-subtle text-success p-3">
                            <i class="bi bi-envelope fs-4" aria-hidden="true"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">
                                Gender Recorded
                            </div>

                            <div class="display-6 fw-bold mt-2">
                                @patientsWithGender
                            </div>
                        </div>

                        <div class="rounded-3 bg-info-subtle text-info p-3">
                            <i class="bi bi-person-vcard fs-4"
                               aria-hidden="true"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 p-4 pb-3">
            <div class="d-flex flex-column flex-md-row justify-content-between gap-3">
                <div>
                    <h2 class="h5 fw-bold mb-1">
                        Patient Records
                    </h2>

                    <p class="text-muted small mb-0">
                        @totalPatients active patient@(totalPatients == 1 ? "" : "s") currently registered.
                    </p>
                </div>

                <div class="position-relative"
                     style="max-width: 360px; width: 100%;">
                    <label for="@searchId"
                           class="visually-hidden">
                        Search patients
                    </label>

                    <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"
                       aria-hidden="true"></i>

                    <input id="@searchId"
                           type="search"
                           class="form-control ps-5"
                           placeholder="Search name, number or ID..."
                           autocomplete="off" />
                </div>
            </div>
        </div>

        <div class="card-body p-0">

            @if (patients.Count == 0)
            {
                <div class="text-center py-5 px-4">
                    <div class="rounded-circle bg-primary-subtle text-primary d-inline-flex p-3 mb-3">
                        <i class="bi bi-person-x fs-3"
                           aria-hidden="true"></i>
                    </div>

                    <h3 class="h5 fw-bold">
                        No patients registered
                    </h3>

                    <p class="text-muted mb-3">
                        Register the first patient to begin building the patient directory.
                    </p>

                    <a asp-controller="Reception"
                           asp-action="RegisterPatient"
                           class="btn btn-primary">
                        Register Patient
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0"
                           id="patients-table">
                        <caption class="visually-hidden">
                            Active patient directory
                        </caption>

                        <thead class="table-light">
                            <tr>
                                <th scope="col"
                                    class="ps-4">
                                    Patient
                                </th>

                                <th scope="col">
                                    Patient Number
                                </th>

                                <th scope="col">
                                    ID Number
                                </th>

                                <th scope="col">
                                    Contact
                                </th>

                                <th scope="col">
                                    Date of Birth
                                </th>

                                <th scope="col"
                                    class="pe-4">
                                    Status
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var patient in patients.OrderBy(p => p.FullName))
                            {
                                var searchText =
                                    $"{patient.FullName} {patient.PatientNumber} {patient.IdNumber} {patient.Email} {patient.PhoneNumber}";

                                <tr data-search="@searchText.ToLowerInvariant()">

                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center flex-shrink-0"
                                                 style="width: 42px; height: 42px;">
                                                <span class="fw-bold">
                                                    @(string.IsNullOrWhiteSpace(patient.FullName)
                                                        ? "?"
                                                        : patient.FullName.Trim()[0].ToString().ToUpperInvariant())
                                                </span>
                                            </div>

                                            <div>
                                                <div class="fw-semibold">
                                                    @patient.FullName
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(patient.Email))
                                                {
                                                    <div class="small text-muted">
                                                        @patient.Email
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="fw-semibold">
                                            @patient.PatientNumber
                                        </span>
                                    </td>

                                    <td>
                                        <span class="font-monospace small">
                                            @patient.IdNumber
                                        </span>
                                    </td>

                                    <td>
                                        <div>
                                            <div class="small">
                                                @patient.PhoneNumber
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(patient.Email))
                                            {
                                                <div class="small text-muted">
                                                    @patient.Email
                                                </div>
                                            }
                                        </div>
                                    </td>

                                    <td>
                                        @patient.DateOfBirth.ToString("dd MMM yyyy")
                                    </td>

                                    <td class="pe-4">
                                        <span class="badge rounded-pill text-bg-success">
                                            <i class="bi bi-check-circle me-1"
                                               aria-hidden="true"></i>
                                            Active
                                        </span>
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div id="no-results"
                     class="text-center py-5 px-4 d-none">
                    <i class="bi bi-search fs-1 text-muted"
                       aria-hidden="true"></i>

                    <h3 class="h5 fw-bold mt-3">
                        No matching patients
                    </h3>

                    <p class="text-muted mb-0">
                        Try searching by name, patient number, ID number or contact details.
                    </p>
                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const searchInput = document.getElementById('@searchId');
            const table = document.getElementById('patients-table');
            const noResults = document.getElementById('no-results');

            if (!searchInput || !table) {
                return;
            }

            const rows = Array.from(
                table.querySelectorAll('tbody tr')
            );

            const filterRows = () => {
                const query = searchInput.value
                    .trim()
                    .toLowerCase();

                let visibleCount = 0;

                rows.forEach(row => {
                    const searchableText =
                        row.dataset.search || '';

                    const matches =
                        !query ||
                        searchableText.includes(query);

                    row.classList.toggle(
                        'd-none',
                        !matches);

                    if (matches) {
                        visibleCount++;
                    }
                });

                if (noResults) {
                    noResults.classList.toggle(
                        'd-none',
                        visibleCount !== 0);
                }
            };

            searchInput.addEventListener(
                'input',
                filterRows);
        })();
    </script>
}