@{
    ViewData["Title"] = "Reception Dashboard";

    var totalPatients = ViewBag.TotalPatients is int patients
        ? patients
        : 0;

    var totalAppointments = ViewBag.TotalAppointments is int appointments
        ? appointments
        : 0;

    var todayAppointments = ViewBag.TodayAppointments is int today
        ? today
        : 0;

    var pendingAppointments = ViewBag.PendingAppointments is int pending
        ? pending
        : 0;
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">

        <div>
            <span class="badge rounded-pill text-bg-primary px-3 py-2 mb-2">
                <i class="bi bi-headset me-1" aria-hidden="true"></i>
                Reception Workspace
            </span>

            <h1 class="h3 fw-bold mb-1">
                Reception Dashboard
            </h1>

            <p class="text-muted mb-0">
                Manage patients, appointments and front-desk workflows.
            </p>
        </div>

        <div class="d-flex flex-column flex-sm-row gap-2">

            <a asp-controller="Reception"
                   asp-action="RegisterPatient"
                   class="btn btn-outline-primary">
                <i class="bi bi-person-plus me-2"
                   aria-hidden="true"></i>
                Register Patient
            </a>

            <a asp-controller="Reception"
                   asp-action="BookAppointment"
                   class="btn btn-primary">
                <i class="bi bi-calendar-plus me-2"
                   aria-hidden="true"></i>
                Book Appointment
            </a>

        </div>

    </div>

    <!-- Metrics -->
    <div class="row g-4 mb-4">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <div class="text-muted small fw-semibold">
                                Active Patients
                            </div>

                            <div class="display-6 fw-bold mt-2">
                                @totalPatients
                            </div>

                            <div class="small text-success mt-2">
                                <i class="bi bi-person-check me-1"
                                   aria-hidden="true"></i>
                                Registered in clinic
                            </div>
                        </div>

                        <span class="rounded-circle bg-primary-subtle text-primary d-inline-flex align-items-center justify-content-center"
                              style="width:54px;height:54px;">
                            <i class="bi bi-people fs-4"
                               aria-hidden="true"></i>
                        </span>

                    </div>

                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <div class="text-muted small fw-semibold">
                                Total Appointments
                            </div>

                            <div class="display-6 fw-bold mt-2">
                                @totalAppointments
                            </div>

                            <div class="small text-muted mt-2">
                                <i class="bi bi-calendar3 me-1"
                                   aria-hidden="true"></i>
                                Current scheduling data
                            </div>
                        </div>

                        <span class="rounded-circle bg-info-subtle text-info d-inline-flex align-items-center justify-content-center"
                              style="width:54px;height:54px;">
                            <i class="bi bi-calendar2-week fs-4"
                               aria-hidden="true"></i>
                        </span>

                    </div>

                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <div class="text-muted small fw-semibold">
                                Today's Appointments
                            </div>

                            <div class="display-6 fw-bold mt-2">
                                @todayAppointments
                            </div>

                            <div class="small text-primary mt-2">
                                <i class="bi bi-calendar-day me-1"
                                   aria-hidden="true"></i>
                                Scheduled today
                            </div>
                        </div>

                        <span class="rounded-circle bg-success-subtle text-success d-inline-flex align-items-center justify-content-center"
                              style="width:54px;height:54px;">
                            <i class="bi bi-calendar-check fs-4"
                               aria-hidden="true"></i>
                        </span>

                    </div>

                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <div class="text-muted small fw-semibold">
                                Pending
                            </div>

                            <div class="display-6 fw-bold mt-2">
                                @pendingAppointments
                            </div>

                            <div class="small text-warning mt-2">
                                <i class="bi bi-clock me-1"
                                   aria-hidden="true"></i>
                                Awaiting appointment completion
                            </div>
                        </div>

                        <span class="rounded-circle bg-warning-subtle text-warning d-inline-flex align-items-center justify-content-center"
                              style="width:54px;height:54px;">
                            <i class="bi bi-hourglass-split fs-4"
                               aria-hidden="true"></i>
                        </span>

                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- Main workspace -->
    <div class="row g-4">

        <div class="col-12 col-lg-8">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-header bg-transparent border-0 px-4 pt-4">
                    <h2 class="h5 fw-bold mb-1">
                        Reception Workflows
                    </h2>

                    <p class="text-muted small mb-0">
                        Common front-desk tasks and patient management operations.
                    </p>
                </div>

                <div class="card-body p-4">

                    <div class="row g-3">

                        <div class="col-12 col-md-6">

                            <a asp-controller="Reception"
                                   asp-action="Patients"
                                   class="text-decoration-none">

                                <div class="border rounded-4 p-4 h-100 dashboard-action">

                                    <div class="d-flex align-items-start gap-3">

                                        <span class="rounded-3 bg-primary-subtle text-primary d-inline-flex align-items-center justify-content-center flex-shrink-0"
                                              style="width:48px;height:48px;">
                                            <i class="bi bi-people fs-5"
                                               aria-hidden="true"></i>
                                        </span>

                                        <div>
                                            <h3 class="h6 fw-bold text-body mb-1">
                                                Patient Directory
                                            </h3>

                                            <p class="small text-muted mb-2">
                                                View and search active patient records.
                                            </p>

                                            <span class="small fw-semibold text-primary">
                                                Open directory
                                                <i class="bi bi-arrow-right ms-1"
                                                   aria-hidden="true"></i>
                                            </span>
                                        </div>

                                    </div>

                                </div>

                            </a>

                        </div>

                        <div class="col-12 col-md-6">

                            <a asp-controller="Reception"
                                   asp-action="RegisterPatient"
                                   class="text-decoration-none">

                                <div class="border rounded-4 p-4 h-100 dashboard-action">

                                    <div class="d-flex align-items-start gap-3">

                                        <span class="rounded-3 bg-success-subtle text-success d-inline-flex align-items-center justify-content-center flex-shrink-0"
                                              style="width:48px;height:48px;">
                                            <i class="bi bi-person-plus fs-5"
                                               aria-hidden="true"></i>
                                        </span>

                                        <div>
                                            <h3 class="h6 fw-bold text-body mb-1">
                                                Register Patient
                                            </h3>

                                            <p class="small text-muted mb-2">
                                                Create a new patient profile.
                                            </p>

                                            <span class="small fw-semibold text-success">
                                                Start registration
                                                <i class="bi bi-arrow-right ms-1"
                                                   aria-hidden="true"></i>
                                            </span>
                                        </div>

                                    </div>

                                </div>

                            </a>

                        </div>

                        <div class="col-12 col-md-6">

                            <a asp-controller="Reception"
                                   asp-action="Appointments"
                                   class="text-decoration-none">

                                <div class="border rounded-4 p-4 h-100 dashboard-action">

                                    <div class="d-flex align-items-start gap-3">

                                        <span class="rounded-3 bg-info-subtle text-info d-inline-flex align-items-center justify-content-center flex-shrink-0"
                                              style="width:48px;height:48px;">
                                            <i class="bi bi-calendar2-week fs-5"
                                               aria-hidden="true"></i>
                                        </span>

                                        <div>
                                            <h3 class="h6 fw-bold text-body mb-1">
                                                Appointment Schedule
                                            </h3>

                                            <p class="small text-muted mb-2">
                                                Review, monitor and cancel appointments.
                                            </p>

                                            <span class="small fw-semibold text-info">
                                                Open schedule
                                                <i class="bi bi-arrow-right ms-1"
                                                   aria-hidden="true"></i>
                                            </span>
                                        </div>

                                    </div>

                                </div>

                            </a>

                        </div>

                        <div class="col-12 col-md-6">

                            <a asp-controller="Reception"
                                   asp-action="BookAppointment"
                                   class="text-decoration-none">

                                <div class="border rounded-4 p-4 h-100 dashboard-action">

                                    <div class="d-flex align-items-start gap-3">

                                        <span class="rounded-3 bg-warning-subtle text-warning d-inline-flex align-items-center justify-content-center flex-shrink-0"
                                              style="width:48px;height:48px;">
                                            <i class="bi bi-calendar-plus fs-5"
                                               aria-hidden="true"></i>
                                        </span>

                                        <div>
                                            <h3 class="h6 fw-bold text-body mb-1">
                                                Book Appointment
                                            </h3>

                                            <p class="small text-muted mb-2">
                                                Schedule a patient with an available doctor.
                                            </p>

                                            <span class="small fw-semibold text-warning">
                                                Create booking
                                                <i class="bi bi-arrow-right ms-1"
                                                   aria-hidden="true"></i>
                                            </span>
                                        </div>

                                    </div>

                                </div>

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-12 col-lg-4">

            <div class="card border-0 shadow-sm rounded-4 mb-4">

                <div class="card-body p-4">

                    <div class="d-flex align-items-start gap-3">

                        <span class="rounded-circle bg-success-subtle text-success d-inline-flex align-items-center justify-content-center flex-shrink-0"
                              style="width:48px;height:48px;">
                            <i class="bi bi-shield-check fs-5"
                               aria-hidden="true"></i>
                        </span>

                        <div>
                            <h2 class="h6 fw-bold mb-1">
                                Secure Workspace
                            </h2>

                            <p class="small text-muted mb-0">
                                Reception functions are protected by role-based
                                authentication and anti-forgery controls.
                            </p>
                        </div>

                    </div>

                </div>

            </div>

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header bg-transparent border-0 px-4 pt-4">
                    <h2 class="h6 fw-bold mb-1">
                        Quick Status
                    </h2>

                    <p class="text-muted small mb-0">
                        Current reception workload.
                    </p>
                </div>

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="small text-muted">
                            Active patient records
                        </span>

                        <span class="fw-semibold">
                            @totalPatients
                        </span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="small text-muted">
                            Today's appointments
                        </span>

                        <span class="fw-semibold">
                            @todayAppointments
                        </span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center py-2">
                        <span class="small text-muted">
                            Pending appointments
                        </span>

                        <span class="badge rounded-pill text-bg-warning">
                            @pendingAppointments
                        </span>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<style>
    .dashboard-action {
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

        .dashboard-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.08);
            border-color: rgba(var(--bs-primary-rgb), 0.35) !important;
        }

        .dashboard-action:focus-within {
            outline: 3px solid rgba(var(--bs-primary-rgb), 0.2);
            outline-offset: 2px;
        }
</style>