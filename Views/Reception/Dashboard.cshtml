@{
    ViewData["Title"] = "Reception Dashboard";

    var totalPatients = ViewBag.TotalPatients is int patients
        ? patients
        : 0;

    var totalAppointments = ViewBag.TotalAppointments is int appointments
        ? appointments
        : 0;

    var todayAppointments = ViewBag.TodayAppointments is int today
        ? today
        : 0;

    var pendingAppointments = ViewBag.PendingAppointments is int pending
        ? pending
        : 0;
}

<div class="reception-dashboard">

    <div class="container-fluid py-4 py-lg-5">

        <!-- Header -->
        <div class="dashboard-header mb-4 mb-lg-5">

            <div>
                <div class="dashboard-eyebrow mb-2">
                    <i class="bi bi-headset me-2" aria-hidden="true"></i>
                    Reception Workspace
                </div>

                <h1 class="display-6 fw-bold mb-2">
                    Reception Dashboard
                </h1>

                <p class="text-muted mb-0">
                    Manage patients, appointments and front-desk workflows from one central workspace.
                </p>
            </div>

            <div class="dashboard-header-actions d-flex flex-column flex-sm-row gap-2">

                <a asp-controller="Reception"
                       asp-action="RegisterPatient"
                       class="btn btn-outline-primary btn-lg">
                    <i class="bi bi-person-plus me-2" aria-hidden="true"></i>
                    Register Patient
                </a>

                <a asp-controller="Reception"
                       asp-action="BookAppointment"
                       class="btn btn-primary btn-lg">
                    <i class="bi bi-calendar-plus me-2" aria-hidden="true"></i>
                    Book Appointment
                </a>

            </div>

        </div>

        <!-- Overview -->
        <section aria-labelledby="overview-heading" class="mb-4 mb-lg-5">

            <div class="mb-3">
                <h2 id="overview-heading" class="h5 fw-bold mb-1">
                    Reception Overview
                </h2>

                <p class="text-muted small mb-0">
                    Current patient and appointment activity.
                </p>
            </div>

            <div class="row g-3 g-lg-4">

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="overview-card h-100">

                        <div class="overview-card-content">
                            <span class="overview-card-label">
                                Active Patients
                            </span>

                            <span class="overview-card-value">
                                @totalPatients
                            </span>

                            <span class="overview-card-description">
                                Registered active patients
                            </span>
                        </div>

                        <div class="overview-icon">
                            <i class="bi bi-people" aria-hidden="true"></i>
                        </div>

                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="overview-card h-100">

                        <div class="overview-card-content">
                            <span class="overview-card-label">
                                Total Appointments
                            </span>

                            <span class="overview-card-value">
                                @totalAppointments
                            </span>

                            <span class="overview-card-description">
                                Current scheduling records
                            </span>
                        </div>

                        <div class="overview-icon">
                            <i class="bi bi-calendar2-week" aria-hidden="true"></i>
                        </div>

                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="overview-card h-100">

                        <div class="overview-card-content">
                            <span class="overview-card-label">
                                Today's Appointments
                            </span>

                            <span class="overview-card-value">
                                @todayAppointments
                            </span>

                            <span class="overview-card-description">
                                Scheduled for today
                            </span>
                        </div>

                        <div class="overview-icon">
                            <i class="bi bi-calendar-check" aria-hidden="true"></i>
                        </div>

                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="overview-card h-100">

                        <div class="overview-card-content">
                            <span class="overview-card-label">
                                Pending Appointments
                            </span>

                            <span class="overview-card-value">
                                @pendingAppointments
                            </span>

                            <span class="overview-card-description">
                                Awaiting completion
                            </span>
                        </div>

                        <div class="overview-icon">
                            <i class="bi bi-clock-history" aria-hidden="true"></i>
                        </div>

                    </div>
                </div>

            </div>

        </section>

        <!-- Main Workspace -->
        <div class="row g-4">

            <!-- Workflows -->
            <div class="col-12 col-xl-8">

                <section class="workspace-panel h-100"
                         aria-labelledby="workflow-heading">

                    <div class="workspace-panel-header">

                        <h2 id="workflow-heading" class="h5 fw-bold mb-1">
                            Reception Workflows
                        </h2>

                        <p class="text-muted small mb-0">
                            Select a workflow to manage patients and appointments.
                        </p>

                    </div>

                    <div class="workflow-list">

                        <a asp-controller="Reception"
                               asp-action="Patients"
                               class="workflow-item">

                            <div class="workflow-icon">
                                <i class="bi bi-people" aria-hidden="true"></i>
                            </div>

                            <div class="workflow-content">

                                <h3 class="h6 fw-bold mb-1">
                                    Patient Directory
                                </h3>

                                <p class="text-muted small mb-0">
                                    View and search active patient records.
                                </p>

                            </div>

                            <i class="bi bi-arrow-right workflow-arrow"
                               aria-hidden="true"></i>

                        </a>

                        <a asp-controller="Reception"
                               asp-action="RegisterPatient"
                               class="workflow-item">

                            <div class="workflow-icon">
                                <i class="bi bi-person-plus" aria-hidden="true"></i>
                            </div>

                            <div class="workflow-content">

                                <h3 class="h6 fw-bold mb-1">
                                    Register Patient
                                </h3>

                                <p class="text-muted small mb-0">
                                    Create a new patient profile and capture required information.
                                </p>

                            </div>

                            <i class="bi bi-arrow-right workflow-arrow"
                               aria-hidden="true"></i>

                        </a>

                        <a asp-controller="Reception"
                               asp-action="Appointments"
                               class="workflow-item">

                            <div class="workflow-icon">
                                <i class="bi bi-calendar2-week" aria-hidden="true"></i>
                            </div>

                            <div class="workflow-content">

                                <h3 class="h6 fw-bold mb-1">
                                    Appointment Schedule
                                </h3>

                                <p class="text-muted small mb-0">
                                    Review scheduled appointments and manage cancellations.
                                </p>

                            </div>

                            <i class="bi bi-arrow-right workflow-arrow"
                               aria-hidden="true"></i>

                        </a>

                        <a asp-controller="Reception"
                               asp-action="BookAppointment"
                               class="workflow-item">

                            <div class="workflow-icon">
                                <i class="bi bi-calendar-plus" aria-hidden="true"></i>
                            </div>

                            <div class="workflow-content">

                                <h3 class="h6 fw-bold mb-1">
                                    Book Appointment
                                </h3>

                                <p class="text-muted small mb-0">
                                    Schedule a patient with an available doctor.
                                </p>

                            </div>

                            <i class="bi bi-arrow-right workflow-arrow"
                               aria-hidden="true"></i>

                        </a>

                    </div>

                </section>

            </div>

            <!-- Status -->
            <div class="col-12 col-xl-4">

                <div class="d-flex flex-column gap-4">

                    <section class="status-card"
                             aria-labelledby="security-heading">

                        <div class="status-card-header">

                            <div class="status-icon">
                                <i class="bi bi-shield-check" aria-hidden="true"></i>
                            </div>

                            <div>
                                <h2 id="security-heading" class="h6 fw-bold mb-1">
                                    Secure Reception Workspace
                                </h2>

                                <p class="text-muted small mb-0">
                                    Reception functions are protected by role-based access controls.
                                </p>
                            </div>

                        </div>

                        <div class="security-note">
                            <i class="bi bi-check-circle-fill me-2"
                               aria-hidden="true"></i>
                            Secure access enabled
                        </div>

                    </section>

                    <section class="status-card"
                             aria-labelledby="quick-status-heading">

                        <div class="mb-3">

                            <h2 id="quick-status-heading" class="h6 fw-bold mb-1">
                                Quick Status
                            </h2>

                            <p class="text-muted small mb-0">
                                Current reception workload.
                            </p>

                        </div>

                        <div class="status-list">

                            <div class="status-row">
                                <span>
                                    Active patient records
                                </span>

                                <strong>
                                    @totalPatients
                                </strong>
                            </div>

                            <div class="status-row">
                                <span>
                                    Today's appointments
                                </span>

                                <strong>
                                    @todayAppointments
                                </strong>
                            </div>

                            <div class="status-row status-row-last">
                                <span>
                                    Pending appointments
                                </span>

                                <strong class="status-pending">
                                    @pendingAppointments
                                </strong>
                            </div>

                        </div>

                    </section>

                </div>

            </div>

        </div>

    </div>

</div>

<style>
    .reception-dashboard {
        min-height: calc(100vh - 70px);
        background: #f7fbff;
    }

    .dashboard-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        padding: 1.75rem 2rem;
        background: linear-gradient(135deg, #e7f5ff 0%, #f5fbff 100%);
        border: 1px solid #d5ebf9;
        border-radius: 1.25rem;
        box-shadow: 0 0.35rem 1.25rem rgba(31, 91, 122, 0.06);
    }

    .dashboard-eyebrow {
        display: inline-flex;
        align-items: center;
        color: #0b6fa4;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .overview-card {
        position: relative;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        min-height: 165px;
        padding: 1.5rem;
        overflow: hidden;
        background: linear-gradient(135deg, #e4f4ff 0%, #f4faff 100%);
        border: 1px solid #cfe7f6;
        border-radius: 1.15rem;
        box-shadow: 0 0.35rem 1.25rem rgba(31, 91, 122, 0.07);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .overview-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.7rem 1.5rem rgba(31, 91, 122, 0.11);
        }

    .overview-card-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .overview-card-label {
        color: #526b7a;
        font-size: 0.85rem;
        font-weight: 700;
    }

    .overview-card-value {
        margin-top: 0.4rem;
        color: #123b53;
        font-size: 2.4rem;
        font-weight: 800;
        line-height: 1.1;
    }

    .overview-card-description {
        margin-top: 0.55rem;
        color: #66808f;
        font-size: 0.78rem;
    }

    .overview-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 58px;
        height: 58px;
        flex: 0 0 58px;
        color: #1479ad;
        background: rgba(255, 255, 255, 0.78);
        border: 1px solid rgba(255, 255, 255, 0.95);
        border-radius: 50%;
        font-size: 1.4rem;
    }

    .workspace-panel,
    .status-card {
        background: #ffffff;
        border: 1px solid #dfedf5;
        border-radius: 1.15rem;
        box-shadow: 0 0.35rem 1.25rem rgba(31, 91, 122, 0.06);
    }

    .workspace-panel-header {
        padding: 1.5rem 1.5rem 1.15rem;
        border-bottom: 1px solid #eaf2f6;
    }

    .workflow-list {
        padding: 0.5rem 1rem 1rem;
    }

    .workflow-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.15rem 0.75rem;
        color: inherit;
        text-decoration: none;
        border-bottom: 1px solid #eaf2f6;
        border-radius: 0.75rem;
        transition: background-color 0.2s ease, padding-left 0.2s ease;
    }

        .workflow-item:last-child {
            border-bottom: 0;
        }

        .workflow-item:hover {
            padding-left: 1rem;
            background: #eef8ff;
        }

        .workflow-item:focus-visible {
            outline: 3px solid rgba(13, 110, 253, 0.2);
            outline-offset: 2px;
        }

    .workflow-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        flex: 0 0 48px;
        color: #1175a8;
        background: #e7f5ff;
        border: 1px solid #d2ebf9;
        border-radius: 0.8rem;
        font-size: 1.2rem;
    }

    .workflow-content {
        flex: 1;
        min-width: 0;
    }

    .workflow-arrow {
        color: #7d9aaa;
        font-size: 1rem;
        transition: transform 0.2s ease, color 0.2s ease;
    }

    .workflow-item:hover .workflow-arrow {
        color: #0d6efd;
        transform: translateX(3px);
    }

    .status-card {
        padding: 1.5rem;
    }

    .status-card-header {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
    }

    .status-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        flex: 0 0 48px;
        color: #1479ad;
        background: #e7f5ff;
        border: 1px solid #d2ebf9;
        border-radius: 50%;
        font-size: 1.15rem;
    }

    .security-note {
        margin-top: 1.25rem;
        padding: 0.8rem 1rem;
        color: #176b4d;
        background: #edf9f4;
        border: 1px solid #d4eee2;
        border-radius: 0.7rem;
        font-size: 0.82rem;
        font-weight: 600;
    }

    .status-list {
        border-top: 1px solid #edf3f7;
    }

    .status-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.9rem 0;
        color: #627985;
        font-size: 0.85rem;
        border-bottom: 1px solid #edf3f7;
    }

        .status-row strong {
            color: #173d51;
            font-size: 0.95rem;
        }

    .status-row-last {
        border-bottom: 0;
    }

    .status-pending {
        color: #9a6900 !important;
    }
</style>