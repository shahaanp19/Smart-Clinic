```cshtml
@{
    ViewData["Title"] = "Reception Login";
}

<section class="login-section">
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-75">
            <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">

                <div class="smart-card login-card">

                    <div class="text-center login-header">
                        <div class="login-icon-wrapper">
                            <i class="bi bi-headset login-icon"></i>
                        </div>

                        <h1 class="login-title">
                            Reception Login
                        </h1>

                        <p class="login-subtitle">
                            Sign in to the reception portal.
                        </p>
                    </div>

                    <form class="login-form">

                        <div class="login-field">
                            <label for="receptionEmail" class="form-label smart-label">
                                Email Address
                            </label>

                            <div class="login-input-wrapper">
                                <i class="bi bi-envelope login-input-icon"></i>

                                <input id="receptionEmail"
                                       type="email"
                                       class="form-control smart-input login-input"
                                       placeholder="reception@smartclinic.co.za"
                                       value="reception@smartclinic.co.za"
                                       readonly />
                            </div>
                        </div>

                        <div class="login-field">
                            <label for="receptionPassword" class="form-label smart-label">
                                Password
                            </label>

                            <div class="login-input-wrapper">
                                <i class="bi bi-lock login-input-icon"></i>

                                <input id="receptionPassword"
                                       type="password"
                                       class="form-control smart-input login-input"
                                       value="password123"
                                       readonly />
                            </div>
                        </div>

                        <div class="d-grid login-action">
                            <a asp-controller="Reception"
                                   asp-action="Dashboard"
                                   class="smart-btn-primary login-button text-decoration-none text-center">
                                Login
                            </a>
                        </div>

                    </form>

                    <div class="prototype-login-details">
                        <div class="prototype-login-title">
                            <i class="bi bi-info-circle me-2"></i>
                            Prototype Login
                        </div>

                        <div class="prototype-login-row">
                            <span>Email</span>
                            <strong>reception@smartclinic.co.za</strong>
                        </div>

                        <div class="prototype-login-row">
                            <span>Password</span>
                            <strong>password123</strong>
                        </div>
                    </div>

                    <div class="login-footer text-center">
                        <span>
                            Smart Clinic Reception Portal
                        </span>
                    </div>

                </div>

            </div>
        </div>
    </div>
</section>
```
